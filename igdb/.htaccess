# Never serve the credential, token, or database files.
<FilesMatch "^(config\.php|config\.php\.example|token\.json|games\.db|games\.db-wal|games\.db-shm)$">
    Require all denied
</FilesMatch>

# Cached covers/key art (.jpg) and company logos (.png) are immutable — cache hard.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|png)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
