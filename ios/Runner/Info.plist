<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hollow</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>hollow</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!--
	  US export compliance: Hollow uses ONLY standard encryption algorithms
	  (AES-GCM, Curve25519/Ed25519, Double Ratchet, OpenMLS, SFrame) — no
	  proprietary crypto — so all encryption is EXEMPT (EAR 740.17(b)(1),
	  mass-market). "false" = "no NON-exempt encryption", which skips the
	  per-upload questionnaire in App Store Connect. NOTE: claiming this
	  exemption obligates a one-time annual self-classification email to
	  BIS + NSA ENC (does not block TestFlight/App Store).
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Screen share: ReplayKit Broadcast Upload Extension. The flutter_webrtc
	     fork reads these to (a) preselect our extension in the system broadcast
	     picker and (b) locate the App-Group unix socket the extension streams
	     frames + app audio through. -->
	<key>RTCScreenSharingExtension</key>
	<string>com.anonlisten.hollow.BroadcastExtension</string>
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.anonlisten.hollow</string>
	<!-- hollow:// deep links (server invites, shares, recovery links). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.anonlisten.hollow</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hollow</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Hollow needs camera access for video calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hollow needs microphone access for voice and video calls.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Hollow needs photo library access so you can send images in chats.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Hollow needs permission to save images you receive to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Hollow uses network information to choose the best connection route for voice and video calls.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Hollow uses Face ID to unlock the app when App Lock is enabled.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- iPadOS ignores orientation locks for multitasking-capable apps —
	     full screen is required for the portrait lock to hold on iPad. -->
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
