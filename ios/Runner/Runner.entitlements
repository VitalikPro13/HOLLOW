<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs environment for push notifications, from the build variant
	  (Flutter/Variant-*.xcconfig): "production" for TestFlight + App Store
	  (a TestFlight build with "development" silently gets no token),
	  "development" for the cable-run dev variant.
	-->
	<key>aps-environment</key>
	<string>$(HOLLOW_APS_ENVIRONMENT)</string>
	<!--
	  Shared App Group with the NotificationService extension. The app writes a
	  push-hints cache (friend name + avatar) here; the extension reads it to show
	  rich push banners. HOLLOW_APP_GROUP is the one source: both extensions'
	  entitlements and the HollowAppGroup key every Info.plist hands to Swift.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HOLLOW_APP_GROUP)</string>
	</array>
	<!--
	  Keychain access for flutter_secure_storage (App Lock biometric secret +
	  lock-type marker). The default access group keeps items private to this
	  app's team/bundle.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HOLLOW_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
