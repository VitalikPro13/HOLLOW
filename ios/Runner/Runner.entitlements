<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs environment for push notifications.
	  - "production" for TestFlight + App Store builds (uses prod APNs gateway).
	  - "development" only for `flutter run`/Xcode Run to a cable-connected device.
	  TestFlight (even internal) is a release-signed build → MUST be production,
	  or APNs silently drops the token (no error). This file is linked via
	  CODE_SIGN_ENTITLEMENTS in project.pbxproj (Push Notifications capability).
	-->
	<key>aps-environment</key>
	<string>production</string>
	<!--
	  Shared App Group with the NotificationService extension. The app writes a
	  push-hints cache (friend name + avatar) here; the extension reads it to show
	  rich push banners. Must match NotificationService.entitlements + the
	  appGroupId in AppDelegate.swift / NotificationService.swift / PushHintsCache.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.anonlisten.hollow</string>
	</array>
	<!--
	  Keychain access for flutter_secure_storage (App Lock biometric secret +
	  lock-type marker). The default access group keeps items private to this
	  app's team/bundle.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.anonlisten.hollow</string>
	</array>
</dict>
</plist>
