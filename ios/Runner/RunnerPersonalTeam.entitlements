<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The dev variant under a free Personal Team (HOLLOW_DEV_CAPABILITIES =
	  personal), which cannot grant App Groups or Push Notifications. Keychain
	  access stays, so App Lock keeps its secrets in this app's own group.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HOLLOW_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
