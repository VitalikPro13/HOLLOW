# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Xcode 26+ writes project.pbxproj as objectVersion 70, which CocoaPods 1.16.2
# (xcodeproj 1.27.0) cannot parse. Xcode silently re-bumps it on every project
# edit. Patch it back to a compatible version at the TOP of the Podfile — before
# the `project 'Runner'` line below makes CocoaPods read the project — so a single
# `pod install` succeeds. Remove once CocoaPods/xcodeproj supports objectVersion 70.
_pbxproj = File.join(__dir__, 'Runner.xcodeproj', 'project.pbxproj')
if File.exist?(_pbxproj)
  _contents = File.read(_pbxproj)
  _patched = _contents.sub(/objectVersion = 70;/, 'objectVersion = 54;')
  if _patched != _contents
    File.write(_pbxproj, _patched)
    puts '[hollow] Patched project.pbxproj objectVersion 70 -> 54 for CocoaPods compatibility'
  end
end

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Notification Service Extension (Tier B push): links ONLY the Rust core pod
# (hollow_core) so it can call hollow_push_fetch_and_decrypt to fetch+decrypt the
# message on-device. Deliberately does NOT use flutter_install_all_ios_pods —
# pulling in Firebase/WebRTC/etc. would blow the extension's ~24MB memory cap.
# hollow_core IS heavy (vodozemac + SQLCipher + networking); whether even it fits
# is exactly what the on-device footprint measurement validates.
target 'NotificationService' do
  use_frameworks!
  pod 'hollow_core', :path => '.symlinks/plugins/hollow_core/ios'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
