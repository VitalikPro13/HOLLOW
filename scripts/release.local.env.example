# Hollow — machine-specific release config.
#
# Copy this file to  scripts/release.local.env  and fill in your own values.
# release.local.env is GITIGNORED (it holds your paths + SSH targets); this
# .example template is committed so anyone can see what is needed.
#
# Format is plain KEY=value (no spaces around =, no quotes needed). Both the
# bash scripts (build_macos_release.sh / build_linux_release.sh) and the
# PowerShell orchestrator (build_release.ps1) read this same file.
#
# None of these are secrets: the signing key lives in the macOS keychain / on
# the Certum card, and the notary password lives in a keychain profile. A Team
# ID is public (it is embedded in every signed app). This file just records
# WHERE things live on your machines so the scripts have no hardcoded paths.
# The values below are PLACEHOLDERS — replace them with your own.

# ---- Repo paths on each build host (absolute) ----
# Used by each platform's own build script, run ON that host.
MAC_REPO=/Users/<you>/path/to/HOLLOW
LINUX_REPO=/home/<you>/path/to/HOLLOW

# Flutter bin dir on the Linux VM (non-interactive SSH doesn't load PATH).
LINUX_FLUTTER_BIN=/home/<you>/flutter/bin

# ---- SSH targets (used by the Windows orchestrator to pull artifacts) ----
MAC_SSH=user@mac-host-or-tailscale-ip
LINUX_SSH=user@linux-vm-ip

# ---- macOS signing / notarization ----
# Team ID + the exact "Developer ID Application" identity name, and the stored
# notarytool keychain profile (xcrun notarytool store-credentials <name>).
MAC_TEAM_ID=XXXXXXXXXX
MAC_SIGN_NAME=Your Name
MAC_NOTARY_PROFILE=your-notary-profile

# ---- Update manifest signing (scripts/sign_manifest.ps1) ----
# Ed25519 seed minted once by `hollow-manifest keygen --out <path>`
# (rust/hollow_manifest). Its public half is baked into
# rust/hollow_core/src/api/updater.rs (MANIFEST_SIGNING_PUBKEYS). Keep the
# file outside the repo and BACK IT UP: without it no future manifest can be
# signed and shipped clients cannot be told to update. Optional overrides:
# RELEASE_SSH (default: the `hostinger` ssh alias) and RELEASE_DIR (default:
# ~/domains/anonlisten.com/public_html/hollow/releases).
MANIFEST_SIGNING_KEY=/path/outside/the/repo/manifest_signing.key
