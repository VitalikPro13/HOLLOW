[
  {"op": "log", "message": "Part A: the video fullscreen ROUTE, now the shared media viewer, and the image that opens the same viewer in the window."},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "wait", "ms": 2000},
  {"op": "window_state", "name": "before-media"},

  {"op": "log", "message": "Send the fixture video into the open channel, the way a drop does."},
  {"op": "attach_file", "path": "${UI_PROBE_FIXTURES}/probe_video.mp4"},
  {"op": "tap", "target": "field"},
  {"op": "enter_text", "value": "probe fullscreen video"},
  {"op": "key", "value": "enter"},
  {"op": "wait_for", "target": "text:probe fullscreen video", "timeout_ms": 60000},
  {"op": "wait_for", "target": "type:VideoMessageBubble", "timeout_ms": 60000},
  {"op": "shot", "name": "01-video-bubble"},

  {"op": "log", "message": "Play it inline: the bubble opens the session and mounts the player."},
  {"op": "tap", "target": "type:VideoMessageBubble"},
  {"op": "video_state", "timeout_ms": 30000},
  {"op": "wait", "ms": 1500},
  {"op": "log", "message": "READING A. The positionMs below is the floor for every later reading."},
  {"op": "video_state", "timeout_ms": 5000},

  {"op": "log", "message": "The bubble's own volume: a vertical slider above the icon, on hover."},
  {"op": "hover", "target": "type:InlineVideoPlayer", "frames": 4},
  {"op": "hover", "target": "semantics:Mute video", "frames": 8},
  {"op": "shot", "name": "01b-bubble-volume-popover"},

  {"op": "log", "message": "The control bar's 'Enter fullscreen' pushes the opaque route and takes the window with it. The bar fades after a second of no pointer, so park one on the player first."},
  {"op": "hover", "target": "type:InlineVideoPlayer"},
  {"op": "tap", "target": "semantics:Enter fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": true, "matchesMonitor": true, "thickFrame": false}},
  {"op": "expect_count", "target": "type:WindowTitleBar", "value": 0},
  {"op": "focus_state"},
  {"op": "log", "message": "READING B, the same controller: positionMs >= READING A. One texture, because the bubble drew its poster instead."},
  {"op": "video_state", "index": 0, "timeout_ms": 5000},
  {"op": "expect_count", "target": "type:VideoPlayer", "value": 1},
  {"op": "log", "message": "The viewer owns the transport: the bubble's bar would sit under the strip."},
  {"op": "expect_count", "target": "type:MediaVideoControls", "value": 1},
  {"op": "expect_count", "target": "type:InlineVideoPlayer", "value": 0},
  {"op": "shot", "name": "02-video-fullscreen"},

  {"op": "log", "message": "Escape leaves the view and hands the window back exactly as it was."},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_window_same", "name": "before-media"},
  {"op": "expect_count", "target": "type:MediaViewerView", "value": 0},
  {"op": "log", "message": "READING C, back in the bubble: positionMs >= READING B."},
  {"op": "video_state", "index": 0, "timeout_ms": 10000},
  {"op": "shot", "name": "03-back-inline"},

  {"op": "log", "message": "Second round trip, left through F11: dropping out of fullscreen drops out of the view."},
  {"op": "hover", "target": "type:InlineVideoPlayer"},
  {"op": "tap", "target": "semantics:Enter fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": true, "matchesMonitor": true, "thickFrame": false}},
  {"op": "expect_count", "target": "type:MediaViewerView", "value": 1},
  {"op": "key", "value": "f11"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_count", "target": "type:MediaViewerView", "value": 0},
  {"op": "expect_window_same", "name": "before-media"},
  {"op": "shot", "name": "04-after-f11-exit"},

  {"op": "log", "message": "Third round trip, left through the viewer's OWN control: the transport the viewer took over from the inline bar."},
  {"op": "hover", "target": "type:InlineVideoPlayer"},
  {"op": "tap", "target": "semantics:Enter fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": true}},
  {"op": "expect_count", "target": "type:MediaVideoControls", "value": 1},
  {"op": "log", "message": "The chrome fades after two idle seconds, so each step wakes it first."},
  {"op": "hover", "target": "type:MediaVideoControls", "frames": 10},
  {"op": "shot", "name": "05-viewer-transport"},
  {"op": "hover", "target": "type:MediaVideoControls", "frames": 4},
  {"op": "tap", "target": "semantics:Exit fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_count", "target": "type:MediaViewerView", "value": 0},
  {"op": "expect_window_same", "name": "before-media"},

  {"op": "log", "message": "An image opens the SAME viewer, in the window: no dialog, and no OS fullscreen."},
  {"op": "attach_file", "path": "${UI_PROBE_FIXTURES}/probe_image.png"},
  {"op": "tap", "target": "field"},
  {"op": "enter_text", "value": "probe fullscreen image"},
  {"op": "key", "value": "enter"},
  {"op": "wait_for", "target": "text:probe fullscreen image", "timeout_ms": 60000},
  {"op": "wait", "ms": 1500},
  {"op": "tap", "target": "type:AttachmentImage"},
  {"op": "wait_for", "target": "type:MediaViewerView", "timeout_ms": 20000},
  {"op": "expect_count", "target": "type:HollowDialog", "value": 0},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "shot", "name": "06-image-viewer"},

  {"op": "key", "value": "escape"},
  {"op": "wait_for", "gone": "type:MediaViewerView", "timeout_ms": 15000},
  {"op": "expect_window_same", "name": "before-media"},
  {"op": "shot", "name": "07-back-to-chat"}
]
