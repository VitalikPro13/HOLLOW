[
  {"op": "log", "message": "Part A: the video fullscreen ROUTE, and the image viewer that is deliberately still a dialog."},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "wait", "ms": 2000},
  {"op": "window_state", "name": "before-media"},

  {"op": "log", "message": "Send the fixture video into the open channel, the way a drop does."},
  {"op": "attach_file", "path": "${UI_PROBE_FIXTURES}/probe_video.mp4"},
  {"op": "tap", "target": "field"},
  {"op": "enter_text", "value": "probe fullscreen video"},
  {"op": "key", "value": "enter"},
  {"op": "wait_for", "target": "text:probe fullscreen video", "timeout_ms": 60000},
  {"op": "wait_for", "target": "type:VideoMessageBubble", "timeout_ms": 60000},
  {"op": "shot", "name": "01-video-bubble"},

  {"op": "log", "message": "Play it inline: the bubble opens the session and mounts the player."},
  {"op": "tap", "target": "type:VideoMessageBubble"},
  {"op": "video_state", "timeout_ms": 30000},
  {"op": "wait", "ms": 1500},
  {"op": "log", "message": "READING A. The positionMs below is the floor for every later reading."},
  {"op": "video_state", "timeout_ms": 5000},

  {"op": "log", "message": "The control bar's 'Enter fullscreen' pushes the opaque route and takes the window with it. The bar fades after a second of no pointer, so park one on the player first."},
  {"op": "hover", "target": "type:InlineVideoPlayer"},
  {"op": "tap", "target": "semantics:Enter fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": true, "matchesMonitor": true, "thickFrame": false}},
  {"op": "expect_count", "target": "type:WindowTitleBar", "value": 0},
  {"op": "focus_state"},
  {"op": "log", "message": "READING B, the same controller: positionMs >= READING A. One player, because the bubble drew its poster instead."},
  {"op": "video_state", "index": 0, "timeout_ms": 5000},
  {"op": "expect_count", "target": "type:InlineVideoPlayer", "value": 1},
  {"op": "shot", "name": "02-video-fullscreen"},

  {"op": "log", "message": "Escape leaves the view and hands the window back exactly as it was."},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_window_same", "name": "before-media"},
  {"op": "expect_count", "target": "type:FullscreenVideoView", "value": 0},
  {"op": "log", "message": "READING C, back in the bubble: positionMs >= READING B."},
  {"op": "video_state", "index": 0, "timeout_ms": 10000},
  {"op": "shot", "name": "03-back-inline"},

  {"op": "log", "message": "Second round trip, left through F11: dropping out of fullscreen drops out of the view."},
  {"op": "hover", "target": "type:InlineVideoPlayer"},
  {"op": "tap", "target": "semantics:Enter fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": true, "matchesMonitor": true, "thickFrame": false}},
  {"op": "expect_count", "target": "type:FullscreenVideoView", "value": 1},
  {"op": "key", "value": "f11"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_count", "target": "type:FullscreenVideoView", "value": 0},
  {"op": "expect_window_same", "name": "before-media"},
  {"op": "shot", "name": "04-after-f11-exit"},

  {"op": "log", "message": "The image viewer stays a dialog, and carries no window control."},
  {"op": "attach_file", "path": "${UI_PROBE_FIXTURES}/probe_image.png"},
  {"op": "tap", "target": "field"},
  {"op": "enter_text", "value": "probe fullscreen image"},
  {"op": "key", "value": "enter"},
  {"op": "wait_for", "target": "text:probe fullscreen image", "timeout_ms": 60000},
  {"op": "wait", "ms": 1500},
  {"op": "tap", "target": "type:AttachmentImage"},
  {"op": "wait", "ms": 1000},
  {"op": "expect_count", "target": "type:_FullscreenImageView", "value": 1},
  {"op": "expect_count", "target": "dialog > semantics:Enter fullscreen", "value": 0},
  {"op": "expect_count", "target": "type:_FullscreenImageView > semantics:Enter fullscreen", "value": 0},
  {"op": "shot", "name": "05-image-dialog"},

  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 1000},
  {"op": "expect_count", "target": "type:_FullscreenImageView", "value": 0},
  {"op": "shot", "name": "06-back-to-chat"}
]
