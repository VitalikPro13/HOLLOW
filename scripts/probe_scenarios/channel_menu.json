[
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "dump", "name": "server"},

  {"op": "log", "message": "right-click the first text channel row"},
  {"op": "right_click", "target": "icon:hash"},
  {"op": "shot", "name": "channel-menu"},
  {"op": "dump", "name": "channel-menu"},
  {"op": "expect_text", "value": "Mark as read"},

  {"op": "log", "message": "drill into Visibility, where the stale-submenu bug lived"},
  {"op": "tap", "target": "menu > text:Visibility"},
  {"op": "shot", "name": "visibility-submenu"},
  {"op": "dump", "name": "visibility-submenu"},

  {"op": "log", "message": "back out and close"},
  {"op": "key", "value": "escape"},
  {"op": "expect_no_text", "value": "Mark as read"}
]
