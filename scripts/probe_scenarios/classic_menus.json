[
  {"op": "log", "message": "The Classic-layout surfaces: the left server strip, the DM tile, and the Mention row."},

  {"op": "log", "message": "switch to Classic"},
  {"op": "tap", "target": "semantics:Settings"},
  {"op": "wait", "ms": 1200},
  {"op": "dump", "name": "01-settings"},
  {"op": "tap", "target": "text:Appearance"},
  {"op": "wait", "ms": 800},
  {"op": "tap", "target": "text:Classic"},
  {"op": "wait", "ms": 1200},
  {"op": "shot", "name": "02-classic"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 1200},
  {"op": "dump", "name": "03-classic-home"},

  {"op": "log", "message": "the DM tile menu (PeerCard exists only in Classic)"},
  {"op": "right_click", "target": "type:PeerCard"},
  {"op": "shot", "name": "04-dm-tile-menu"},
  {"op": "dump", "name": "04-dm-tile-menu"},
  {"op": "expect_text", "value": "Mark as read"},
  {"op": "expect_text", "value": "Mute conversation"},
  {"op": "expect_text", "value": "Remove friend"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},

  {"op": "log", "message": "the Home button in the LEFT strip"},
  {"op": "right_click", "target": "server:Home"},
  {"op": "shot", "name": "05-home-menu"},
  {"op": "dump", "name": "05-home-menu"},
  {"op": "expect_text", "value": "Mark all DMs as read"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},

  {"op": "log", "message": "the server icon in the LEFT strip (a visible one - the strip scrolls, and at this window height the last two icons are clipped by the pinned Help / Create buttons)"},
  {"op": "right_click", "target": "server:MyEpicServer"},
  {"op": "shot", "name": "06-server-menu"},
  {"op": "dump", "name": "06-server-menu"},
  {"op": "expect_text", "value": "Move to folder"},
  {"op": "expect_text", "value": "Leave server"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},

  {"op": "log", "message": "Mention: from the member panel into the channel composer"},
  {"op": "log", "message": "the strip scrolls, and ${SERVER} is the last icon, so bring it into view first"},
  {"op": "scroll", "target": "type:ServerStrip > type:ListView", "dy": -200},
  {"op": "wait", "ms": 600},
  {"op": "dump", "name": "06b-scrolled"},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "wait", "ms": 1500},
  {"op": "right_click", "target": "type:_ServerMemberTile", "index": 1},
  {"op": "shot", "name": "07-member-menu"},
  {"op": "dump", "name": "07-member-menu"},
  {"op": "expect_text", "value": "Mention"},
  {"op": "tap", "target": "menu > text:Mention"},
  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "08-mentioned"},
  {"op": "dump", "name": "08-mentioned"},

  {"op": "log", "message": "back to Dock, so the next run starts where this one did"},
  {"op": "tap", "target": "semantics:Settings"},
  {"op": "wait", "ms": 1200},
  {"op": "tap", "target": "text:Appearance"},
  {"op": "wait", "ms": 800},
  {"op": "tap", "target": "text:Dock"},
  {"op": "wait", "ms": 1200},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "09-back-to-dock"},
  {"op": "dump", "name": "09-back-to-dock"}
]
