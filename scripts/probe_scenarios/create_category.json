[
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "log", "message": "layout BEFORE, so the after-dump can be diffed against it"},
  {"op": "dump", "name": "before-create"},

  {"op": "log", "message": "right-click empty sidebar space, below the last channel"},
  {"op": "right_click_at",
   "of": "type:_ServerContent", "align": "bottomLeft", "dx": 110, "dy": -40},
  {"op": "shot", "name": "sidebar-menu"},
  {"op": "expect_text", "value": "Create category"},

  {"op": "tap", "target": "menu > text:Create category"},
  {"op": "shot", "name": "name-dialog"},
  {"op": "enter_text", "target": "dialog > type:TextField", "value": "probe-category"},
  {"op": "tap", "target": "dialog > text:Create"},
  {"op": "wait", "ms": 2000},

  {"op": "shot", "name": "after-create"},
  {"op": "dump", "name": "after-create"},
  {"op": "expect_text", "value": "PROBE-CATEGORY"},

  {"op": "log", "message": "clean up: this drives a copy of a REAL server, and layout ops replicate"},
  {"op": "right_click", "target": "text:PROBE-CATEGORY"},
  {"op": "tap", "target": "menu > text:Delete category"},
  {"op": "tap", "target": "dialog > text:Delete"},
  {"op": "wait", "ms": 2000},
  {"op": "expect_no_text", "value": "PROBE-CATEGORY"}
]
