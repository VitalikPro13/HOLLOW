[
  {"op": "log", "message": "Part B: the media viewer route. An image opens it IN THE WINDOW, so the window must come out exactly as it went in."},
  {"op": "tap", "target": "tooltip:MacOS"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "name": "before-viewer"},

  {"op": "log", "message": "A video first, so the walk has one to reach."},
  {"op": "attach_file", "path": "${UI_PROBE_FIXTURES}/probe_video.mp4"},
  {"op": "tap", "target": "field"},
  {"op": "enter_text", "value": "probe viewer video"},
  {"op": "key", "value": "enter"},
  {"op": "wait_for", "target": "type:VideoMessageBubble", "timeout_ms": 60000},
  {"op": "wait", "ms": 1500},

  {"op": "log", "message": "Send the fixture image into the open DM."},
  {"op": "attach_file", "path": "${UI_PROBE_FIXTURES}/probe_image.png"},
  {"op": "tap", "target": "field"},
  {"op": "enter_text", "value": "probe viewer image"},
  {"op": "key", "value": "enter"},
  {"op": "wait_for", "target": "text:probe viewer image", "timeout_ms": 60000},
  {"op": "wait_for", "target": "type:AttachmentImage", "timeout_ms": 60000},
  {"op": "wait", "ms": 1500},

  {"op": "log", "message": "Tapping the bubble opens the viewer route, not a dialog."},
  {"op": "tap", "target": "type:AttachmentImage"},
  {"op": "wait_for", "target": "type:MediaViewerView", "timeout_ms": 20000},
  {"op": "expect_count", "target": "type:HollowDialog", "value": 0},
  {"op": "expect_text", "value": " of "},
  {"op": "shot", "name": "viewer-00-open"},

  {"op": "log", "message": "The info panel names the file."},
  {"op": "key", "value": "i"},
  {"op": "wait", "ms": 800},
  {"op": "expect_text", "value": "Dimensions"},
  {"op": "shot", "name": "viewer-01-info"},
  {"op": "key", "value": "i"},
  {"op": "wait", "ms": 500},

  {"op": "log", "message": "Fit is where the viewer starts; the wheel zooms about the pointer."},
  {"op": "capture", "as": "fitZoom", "target": "type:MediaZoomReadout"},
  {"op": "wheel", "target": "type:MediaZoomView", "dy": -400},
  {"op": "wait", "ms": 800},
  {"op": "capture", "as": "wheelZoom", "target": "type:MediaZoomReadout"},
  {"op": "shot", "name": "viewer-02-wheeled"},

  {"op": "log", "message": "1 is actual size, which is 100 percent by definition."},
  {"op": "key", "value": "1"},
  {"op": "wait", "ms": 800},
  {"op": "expect_text", "value": "100%"},
  {"op": "shot", "name": "viewer-03-actual"},

  {"op": "log", "message": "0 puts it back to fit."},
  {"op": "key", "value": "0"},
  {"op": "wait", "ms": 800},
  {"op": "capture", "as": "backToFit", "target": "type:MediaZoomReadout"},
  {"op": "shot", "name": "viewer-04-fit"},

  {"op": "log", "message": "Walk back to the video: the viewer's own transport, and its volume popover."},
  {"op": "key", "value": "arrowLeft"},
  {"op": "wait_for", "target": "type:MediaVideoControls", "timeout_ms": 20000},
  {"op": "hover", "target": "type:MediaVideoControls", "frames": 10},
  {"op": "shot", "name": "viewer-05-video"},
  {"op": "hover", "target": "semantics:Mute video", "frames": 8},
  {"op": "shot", "name": "viewer-06-volume-popover"},

  {"op": "log", "message": "Fullscreen from inside the viewer: Escape hands the window back and STAYS in the viewer, the next one closes it."},
  {"op": "hover", "target": "type:MediaVideoControls", "frames": 4},
  {"op": "tap", "target": "semantics:Enter fullscreen"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": true, "matchesMonitor": true}},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 1500},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_count", "target": "type:MediaViewerView", "value": 1},
  {"op": "expect_window_same", "name": "before-viewer"},
  {"op": "shot", "name": "viewer-07-left-fullscreen-stayed"},

  {"op": "key", "value": "escape"},
  {"op": "wait_for", "gone": "type:MediaViewerView", "timeout_ms": 15000},
  {"op": "window_state", "expect": {"fullscreen": false}},
  {"op": "expect_window_same", "name": "before-viewer"},
  {"op": "shot", "name": "viewer-08-back-to-chat"}
]
