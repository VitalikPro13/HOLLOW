  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "s3b-05-bulk-access", "soft": true},
  {"op": "key", "value": "escape", "soft": true},
  {"op": "wait", "ms": 600},

  {"op": "log", "message": "per-channel notification override: the Default dropdown and its menu"},
  {"op": "tap", "target": "text:Notifications", "soft": true},
  {"op": "wait", "ms": 1200},
  {"op": "shot", "name": "s3b-06-override-dropdown", "soft": true},
  {"op": "tap", "target": "text:Default", "index": 0, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "s3b-07-override-menu", "soft": true},
  {"op": "key", "value": "escape", "soft": true},
  {"op": "wait", "ms": 600},
  {"op": "key", "value": "escape", "soft": true},
  {"op": "wait", "ms": 800},

  {"op": "log", "message": "storage: image quality chips, the cleanup menu"},
  {"op": "tap", "target": "semantics:Settings"},
  {"op": "wait", "ms": 1500},
  {"op": "tap", "target": "text:Files & storage", "soft": true},
  {"op": "wait", "ms": 1500},
  {"op": "tap", "target": "text:Clean up", "index": 0, "soft": true},
