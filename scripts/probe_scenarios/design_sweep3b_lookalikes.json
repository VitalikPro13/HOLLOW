  {"op": "scroll", "target": "text:By conversation", "dy": -1200, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "s3b-09-storage-lower", "soft": true},
  {"op": "scroll", "target": "text:By conversation", "dy": -1200, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "s3b-10-storage-bottom", "soft": true}
