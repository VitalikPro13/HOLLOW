  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "s3b-01-emoji-picker"},
  {"op": "log", "message": "a picker is an overlay host that Escape does not close; its own button toggles it"},
  {"op": "tap", "target": "semantics:Insert emoji", "index": 0},
  {"op": "wait", "ms": 500},

  {"op": "tap", "target": "semantics:Insert GIF", "index": 0},
  {"op": "wait", "ms": 1000},
  {"op": "tap", "target": "text:Favourites", "index": 0, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "s3b-02-gif-favourites"},
  {"op": "log", "message": "a picker is an overlay host that Escape does not close; its own button toggles it"},
  {"op": "tap", "target": "semantics:Insert GIF", "index": 0},
  {"op": "wait", "ms": 500},

  {"op": "tap", "target": "semantics:Insert sticker", "index": 0},
  {"op": "wait", "ms": 1000},
  {"op": "tap", "target": "text:Mine", "index": 0, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "s3b-03-sticker-mine"},
  {"op": "log", "message": "a picker is an overlay host that Escape does not close; its own button toggles it"},
