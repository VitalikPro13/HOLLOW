[
  {"op": "log", "message": "Design sweep 3b: the label look-alikes the class rule could not see (builder functions, SelectorPill, Material popup menus). Run before and after, then crop the pairs."},

  {"op": "open_server", "name": "${SERVER}"},
  {"op": "wait", "ms": 1500},

  {"op": "log", "message": "the three pickers: tab rows, GIF lists, sticker packs"},
