  {"op": "wait", "ms": 500},

  {"op": "log", "message": "message proof status badge"},
  {"op": "hover", "target": "type:MessageHoverWrapper", "index": 1, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "tap", "target": "semantics:View message proof", "index": 0, "soft": true},
  {"op": "wait", "ms": 1500},
  {"op": "shot", "name": "s3b-04-message-proof", "soft": true},
  {"op": "key", "value": "escape", "soft": true},
  {"op": "wait", "ms": 600},

  {"op": "log", "message": "category bulk access: the mode chips"},
