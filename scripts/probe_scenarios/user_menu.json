[
  {"op": "log", "message": "Phase 3: the user menu, on the member panel and on a chat sender."},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "dump", "name": "01-server"},

  {"op": "log", "message": "right-click a row in the member panel"},
  {"op": "right_click", "target": "type:_ServerMemberTile"},
  {"op": "shot", "name": "02-member-menu"},
  {"op": "dump", "name": "02-member-menu"},
  {"op": "expect_text", "value": "Profile"},
  {"op": "expect_text", "value": "Copy user ID"},

  {"op": "log", "message": "Copy user ID is the safest row to actually run"},
  {"op": "tap", "target": "menu > text:Copy user ID"},
  {"op": "wait", "ms": 600},
  {"op": "shot", "name": "03-copied"},
  {"op": "expect_no_text", "value": "Copy user ID"},

  {"op": "log", "message": "and again, to check the menu reopens after acting"},
  {"op": "right_click", "target": "type:_ServerMemberTile"},
  {"op": "expect_text", "value": "Profile"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},
  {"op": "expect_no_text", "value": "Copy user ID"},

  {"op": "log", "message": "the sender name in chat opens the same menu, not the message one"},
  {"op": "right_click", "target": "type:ProfileTapTarget", "index": 1, "soft": true},
  {"op": "shot", "name": "04-sender-menu"},
  {"op": "dump", "name": "04-sender-menu"},
  {"op": "expect_text", "value": "Copy user ID", "soft": true},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},

  {"op": "log", "message": "a message body still opens the MESSAGE menu"},
  {"op": "right_click", "target": "type:MessageHoverWrapper", "soft": true},
  {"op": "shot", "name": "05-message-menu"},
  {"op": "dump", "name": "05-message-menu"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400}
]
