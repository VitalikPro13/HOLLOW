[
  {"op": "log", "message": "Verdict 14: GIF lists and sticker packs as ONE dropdown chip. Shoot each picker closed, then with its list menu open, in both themes."},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "wait", "ms": 1500},

  {"op": "tap", "target": "semantics:Insert GIF", "index": 0},
  {"op": "wait", "ms": 1000},
  {"op": "tap", "target": "text:Favourites", "index": 0, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "pl-01-gif-favourites"},
  {"op": "tap", "target": "semantics:Favourites list: All lists", "index": 0},
  {"op": "wait", "ms": 600},
  {"op": "shot", "name": "pl-02-gif-list-menu"},
  {"op": "theme", "value": "light", "frames": 30},
  {"op": "shot", "name": "pl-03-gif-list-menu-light"},
  {"op": "theme", "value": "dark", "frames": 30},
  {"op": "log", "message": "the menu's barrier takes the tap and dismisses it; the picker button then closes the picker"},
  {"op": "tap_at", "of": "semantics:Insert GIF", "align": "center", "dx": 0, "dy": 0},
  {"op": "wait", "ms": 500},
  {"op": "tap", "target": "semantics:Insert GIF", "index": 0},
  {"op": "wait", "ms": 500},

  {"op": "tap", "target": "semantics:Insert sticker", "index": 0},
  {"op": "wait", "ms": 1000},
  {"op": "tap", "target": "text:Mine", "index": 0, "soft": true},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "pl-04-sticker-mine"},
  {"op": "tap", "target": "semantics:Sticker pack: All packs", "index": 0},
  {"op": "wait", "ms": 600},
  {"op": "shot", "name": "pl-05-sticker-pack-menu"},
  {"op": "tap_at", "of": "semantics:Insert sticker", "align": "center", "dx": 0, "dy": 0},
  {"op": "wait", "ms": 500},
  {"op": "tap", "target": "semantics:Insert sticker", "index": 0},
  {"op": "wait", "ms": 500}
]
