[
  {"op": "log", "message": "Does a category actually CONTAIN a channel, or only sit above it?"},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "dump", "name": "01-before"},

  {"op": "log", "message": "create a category from the sidebar background menu"},
  {"op": "right_click_at",
   "of": "type:_ServerContent", "align": "bottomLeft", "dx": 110, "dy": -40},
  {"op": "expect_text", "value": "Create category"},
  {"op": "tap", "target": "menu > text:Create category"},
  {"op": "enter_text", "target": "dialog > type:TextField", "value": "probe-cat"},
  {"op": "tap", "target": "dialog > text:Create"},
  {"op": "wait", "ms": 2000},
  {"op": "shot", "name": "02-category-created"},
  {"op": "dump", "name": "02-category-created"},
  {"op": "expect_text", "value": "PROBE-CAT"},

  {"op": "log", "message": "create a channel INSIDE it, via the category header menu"},
  {"op": "right_click", "target": "text:PROBE-CAT"},
  {"op": "shot", "name": "03-category-menu"},
  {"op": "expect_text", "value": "Create channel here"},
  {"op": "tap", "target": "menu > text:Create channel here"},
  {"op": "enter_text", "target": "dialog > type:TextField", "value": "probe-inside"},
  {"op": "tap", "target": "dialog > text:Create"},
  {"op": "wait", "ms": 4000},
  {"op": "shot", "name": "04-channel-created"},
  {"op": "dump", "name": "04-channel-created"},
  {"op": "expect_text", "value": "probe-inside"},

  {"op": "log", "message": "THE TEST: collapsing the category must take its channel with it"},
  {"op": "tap", "target": "text:PROBE-CAT"},
  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "05-collapsed"},
  {"op": "dump", "name": "05-collapsed"},
  {"op": "expect_no_text", "value": "probe-inside"},

  {"op": "tap", "target": "text:PROBE-CAT"},
  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "06-expanded"},
  {"op": "expect_text", "value": "probe-inside"},

  {"op": "log", "message": "clean up: this runs against a copy of a REAL server, and these ops replicate"},
  {"op": "right_click", "target": "channel:probe-inside"},
  {"op": "tap", "target": "menu > text:Delete channel"},
  {"op": "tap", "target": "dialog > text:Delete"},
  {"op": "wait", "ms": 3000},
  {"op": "expect_no_text", "value": "probe-inside"},

  {"op": "right_click", "target": "text:PROBE-CAT"},
  {"op": "tap", "target": "menu > text:Delete category"},
  {"op": "tap", "target": "dialog > text:Delete"},
  {"op": "wait", "ms": 3000},
  {"op": "shot", "name": "07-cleaned-up"},
  {"op": "dump", "name": "07-cleaned-up"},
  {"op": "expect_no_text", "value": "PROBE-CAT"}
]
