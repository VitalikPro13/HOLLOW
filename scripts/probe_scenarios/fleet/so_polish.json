{
  "_": [
    "Stream overlay polish (#97): the look and the local editor save as you go (no Save buttons),",
    "People on my overlay with one person, six (Show all) and twelve (the filter), each row's",
    "own OBS link button, and the OBS section without per-person rows and with the webcam steps.",
    "Dark and light. a befriends b and c; b shares a look. The extra people are local fixture",
    "masters (short names so they read as names). Art: D:/dev/wt/so-ui/.team/art.",
    "Needs FRESH peers (not yet friends).",
    "run: powershell -File scripts\\fleet.ps1 -Scenario so_polish -Peers a,b,c"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_B" },
    { "peer": "c", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_C" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "c", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "c", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "c", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "overlay_look", "value": "set",
      "images": { "idle": "D:/dev/wt/so-ui/.team/art/b_idle.png", "talking": "D:/dev/wt/so-ui/.team/art/b_talking.png" },
      "effects": { "talking": "shake", "idle": "dim" } },
    { "peer": "a", "op": "overlay_look", "value": "set",
      "images": {
        "idle": "D:/dev/wt/so-ui/.team/art/idle.png",
        "talking": "D:/dev/wt/so-ui/.team/art/talking.png",
        "loud": "D:/dev/wt/so-ui/.team/art/loud.png",
        "blink": "D:/dev/wt/so-ui/.team/art/blink.png",
        "muted": "D:/dev/wt/so-ui/.team/art/muted.png",
        "deafened": "D:/dev/wt/so-ui/.team/art/deafened.png" },
      "effects": { "talking": "bounce", "scale_with_voice": true, "idle": "none", "transition": "crossfade",
                   "hold_ms": 250, "blink_every_s": 5, "loud_threshold": 0.75, "mirror": false, "shadow": "soft" } },
    { "peer": "a", "op": "overlay_server", "value": "on" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "${PEER_B}" },
    { "peer": "a", "op": "wait", "ms": 8000, "why": "b's shared look arrives over Olm" },

    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:Stream overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "reveal", "target": "text:My overlay look", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-01-look-dark" },
    { "peer": "a", "op": "reveal", "target": "text:Shadow", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-02-look-end-dark" },
    { "peer": "a", "op": "reveal", "target": "text:Glow", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Glow", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500, "why": "the choice saves by itself" },
    { "peer": "a", "op": "dump", "name": "po-after-glow" },
    { "peer": "a", "op": "reveal", "target": "text:Bounce", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Bounce", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "reveal", "target": "text:People on my overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-03-people-1-dark" },
    { "peer": "a", "op": "hover", "target": "semantics:Copy the OBS link for probe-b", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 900 },
    { "peer": "a", "op": "shot", "name": "po-04-people-copy-tooltip-dark" },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "tap", "target": "text:Pick images", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "po-05-local-editor-dark" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Pop", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "po-06-local-override-dark" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Done", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:Pick images", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "expect_text", "value": "Reset", "why": "the Pop pick survived Done" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Reset all", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Done", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "overlay_person", "value": "add", "master": "${PEER_C}" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Avery" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Blake" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Casey" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Devon" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "reveal", "target": "text:People on my overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-07-people-6-dark" },
    { "peer": "a", "op": "tap", "target": "text:Show all", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-08-people-6-all-dark" },
    { "peer": "a", "op": "tap", "target": "text:Show less", "index": 0 },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Emery" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Finley" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Gray" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Harper" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Indigo" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "Jules" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "reveal", "target": "text:People on my overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-09-people-12-dark" },
    { "peer": "a", "op": "enter_text", "target": "hint:Find a person", "value": "ar" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-10-people-12-filtered-dark" },
    { "peer": "a", "op": "enter_text", "target": "hint:Find a person", "value": "" },
    { "peer": "a", "op": "wait", "ms": 400 },

    { "peer": "a", "op": "reveal", "target": "text:Run the overlay for OBS", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-11-obs-dark" },
    { "peer": "a", "op": "reveal", "target": "text:Press Start Virtual Camera.", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-12-obs-webcam-dark" },

    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "po-13-obs-webcam-light" },
    { "peer": "a", "op": "reveal", "target": "text:Run the overlay for OBS", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-14-obs-light" },
    { "peer": "a", "op": "reveal", "target": "text:People on my overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-15-people-12-light" },
    { "peer": "a", "op": "tap", "target": "text:Pick images", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "po-16-local-editor-light" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Done", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "reveal", "target": "text:My overlay look", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "po-17-look-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "key", "value": "escape" }
  ],
  "cleanup": [
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "overlay_server", "value": "off" }
  ]
}
