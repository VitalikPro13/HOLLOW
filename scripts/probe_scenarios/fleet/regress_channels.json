{
  "_": [
    "Channel regression pass on three real instances. a makes a server with a second",
    "text channel (#side), b and c join by the invite. Each block proves one live op",
    "reaches the OTHER two peers in the widgets, not just in the CRDT:",
    "(a) RENAME: a renames #side to #renamed from the channel menu; b and c show the",
    "    new name and lose the old one.",
    "(b) DELETE: a creates #doomed live (b and c must see it arrive), then deletes it",
    "    from the channel menu; b and c lose it.",
    "(c) MESSAGES in #general: one from each peer reaches the other two; b edits its",
    "    message (ONE text 'body (edited)', so contains:); c reacts to a's message from",
    "    the message menu and a sees the reaction chip; a replies to b's message and c",
    "    sees the reply with its quote line (the reply icon inside a MessageRow); b",
    "    deletes its message and it leaves a and c. Every check after the reply carries",
    "    the ' (edited)' suffix, because the reply's quote repeats the body without it.",
    "(d) PIN: a pins c's message from the message menu; b sees the header's",
    "    '1 pinned message' button and the message in the Pinned messages dialog.",
    "(e) MENTION: a sits in #renamed, b sends '@probe-a ping' in #general, and a's",
    "    #general row in the sidebar shows the mention badge '@1' (HollowCountBadge in",
    "    _ChannelTile); opening #general clears it.",
    "(f) PUBLIC: a turns #renamed public in Server settings > Channels; b and c show",
    "    the globe tooltip on the row, then a's post there reaches both.",
    "Cleanup deletes the server and waits for b and c to lose it.",
    "",
    "Every send taps the composer first (trap 8) and waits for its OWN row before",
    "another peer waits on it. ${RUN} is in every name and message.",
    "",
    "run: powershell -File scripts/fleet.ps1 -Scenario regress_channels -Peers a,b,c"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_B" },
    { "peer": "c", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_C" },

    { "peer": "a", "op": "log", "message": "setup: a makes the server and #side, b and c join by the invite" },
    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Add a server", "timeout_ms": 10000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "reg-ch-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:reg-ch-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "reg-ch-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Create channel", "timeout_ms": 5000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "side-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "log", "message": "dialog gone FIRST: channel: falls back to any text, and the dialog's field still holds the typed name" },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "channel:side-${RUN}", "timeout_ms": 30000 },

    { "peer": "a", "op": "right_click", "target": "server:reg-ch-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 5000 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:reg-ch-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "reg-ch-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "channel:side-${RUN}", "timeout_ms": 60000 },
    { "peer": "b", "op": "open_channel", "name": "general" },

    { "peer": "c", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "c", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "c", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "server:reg-ch-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "open_server", "name": "reg-ch-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "channel:side-${RUN}", "timeout_ms": 60000 },
    { "peer": "c", "op": "open_channel", "name": "general" },

    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_B}", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_C}", "timeout_ms": 60000 },
    { "peer": "all", "op": "shot", "name": "rc-00-joined", "soft": true },

    { "peer": "a", "op": "log", "message": "(a) RENAME: a renames #side; b and c show the new name and lose the old one" },
    { "peer": "a", "op": "right_click", "target": "channel:side-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Rename channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > hint:Channel name", "timeout_ms": 5000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Channel name", "value": "renamed-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Rename", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "channel:renamed-${RUN}", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "target": "channel:renamed-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "wait_for", "gone": "channel:side-${RUN}", "timeout_ms": 30000 },
    { "peer": "c", "op": "wait_for", "target": "channel:renamed-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "gone": "channel:side-${RUN}", "timeout_ms": 30000 },
    { "peer": "all", "op": "shot", "name": "rc-01-renamed", "soft": true },

    { "peer": "a", "op": "log", "message": "(b) DELETE: a creates #doomed live, b and c see it arrive, a deletes it, b and c lose it" },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Create channel", "timeout_ms": 5000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "doomed-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "channel:doomed-${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "channel:doomed-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "target": "channel:doomed-${RUN}", "timeout_ms": 90000 },
    { "peer": "a", "op": "log", "message": "a stands in #general first, so the chat header never holds the deleted name a gone check could match" },
    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "right_click", "target": "channel:doomed-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Delete channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Delete #doomed-${RUN}?", "timeout_ms": 5000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "channel:doomed-${RUN}", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "gone": "channel:doomed-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "gone": "channel:doomed-${RUN}", "timeout_ms": 90000 },

    { "peer": "a", "op": "log", "message": "(c) MESSAGES in #general: one from each peer reaches the other two" },
    { "peer": "all", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "from a ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > text:from a ${RUN}", "timeout_ms": 20000 },
    { "peer": "b", "op": "wait_for", "target": "type:MessageRow > text:from a ${RUN}", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > text:from a ${RUN}", "timeout_ms": 60000 },

    { "peer": "b", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "b", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "from b ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "type:MessageRow > text:from b ${RUN}", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > text:from b ${RUN}", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > text:from b ${RUN}", "timeout_ms": 60000 },

    { "peer": "c", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "c", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "from c ${RUN}" },
    { "peer": "c", "op": "key", "value": "enter" },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > text:from c ${RUN}", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > text:from c ${RUN}", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait_for", "target": "type:MessageRow > text:from c ${RUN}", "timeout_ms": 60000 },

    { "peer": "b", "op": "log", "message": "(c) EDIT: b edits from the message menu; the edit field lives in MessageHoverWrapper and Enter saves it" },
    { "peer": "b", "op": "right_click", "target": "type:MessageRow > text:from b ${RUN}" },
    { "peer": "b", "op": "tap", "target": "menu > text:Edit message", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "type:MessageHoverWrapper > type:TextField", "timeout_ms": 5000 },
    { "peer": "b", "op": "enter_text", "target": "type:MessageHoverWrapper > type:TextField", "value": "from b edited ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "gone": "type:MessageHoverWrapper > type:TextField", "timeout_ms": 10000 },
    { "peer": "b", "op": "wait_for", "target": "type:MessageRow > contains:from b edited ${RUN} (edited)", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > contains:from b edited ${RUN} (edited)", "timeout_ms": 60000 },
    { "peer": "a", "op": "expect_count", "target": "type:MessageRow > text:from b ${RUN}", "value": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > contains:from b edited ${RUN} (edited)", "timeout_ms": 60000 },
    { "peer": "c", "op": "expect_count", "target": "type:MessageRow > text:from b ${RUN}", "value": 0 },

    { "peer": "c", "op": "log", "message": "(c) REACT: c reacts to a's message from the menu's quick strip; a sees the chip" },
    { "peer": "c", "op": "right_click", "target": "type:MessageRow > text:from a ${RUN}" },
    { "peer": "c", "op": "tap", "target": "menu > semantics:React 👍", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Reaction 👍, 1", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Reaction 👍, 1", "timeout_ms": 60000 },

    { "peer": "a", "op": "log", "message": "(c) REPLY: a replies to b's edited message; c sees the reply and its quote line" },
    { "peer": "a", "op": "right_click", "target": "type:MessageRow > contains:from b edited ${RUN} (edited)" },
    { "peer": "a", "op": "tap", "target": "menu > text:Reply", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "reply from a ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > text:reply from a ${RUN}", "timeout_ms": 20000 },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > text:reply from a ${RUN}", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > icon:reply", "timeout_ms": 10000 },
    { "peer": "all", "op": "shot", "name": "rc-02-messages", "soft": true },

    { "peer": "b", "op": "log", "message": "(c) DELETE MESSAGE: b deletes its message (no confirm for one message); a and c lose it" },
    { "peer": "b", "op": "right_click", "target": "type:MessageRow > contains:from b edited ${RUN} (edited)" },
    { "peer": "b", "op": "tap", "target": "menu > text:Delete message", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:MessageRow > contains:from b edited ${RUN} (edited)", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "gone": "type:MessageRow > contains:from b edited ${RUN} (edited)", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "gone": "type:MessageRow > contains:from b edited ${RUN} (edited)", "timeout_ms": 60000 },

    { "peer": "a", "op": "log", "message": "(d) PIN: a pins c's message; b sees the pin button and the message in Pinned messages" },
    { "peer": "a", "op": "right_click", "target": "type:MessageRow > text:from c ${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Pin message", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:1 pinned message", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:1 pinned message", "timeout_ms": 90000 },
    { "peer": "b", "op": "tap", "target": "semantics:1 pinned message", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "dialog > text:Pinned messages", "timeout_ms": 5000 },
    { "peer": "b", "op": "wait_for", "target": "dialog > contains:from c ${RUN}", "timeout_ms": 5000 },
    { "peer": "b", "op": "shot", "name": "rc-03-pinned", "soft": true },
    { "peer": "b", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "dialog", "timeout_ms": 5000 },

    { "peer": "a", "op": "log", "message": "(e) MENTION: a waits in #renamed, b mentions a in #general, a's #general row shows the @1 badge" },
    { "peer": "a", "op": "open_channel", "name": "renamed-${RUN}" },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "b", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "@probe-a ping ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "type:MessageRow > contains:ping ${RUN}", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "target": "type:_ChannelTile > text:@1", "timeout_ms": 60000 },
    { "peer": "a", "op": "shot", "name": "rc-04-mention-badge", "soft": true },
    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > contains:ping ${RUN}", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "gone": "type:_ChannelTile > text:@1", "timeout_ms": 15000 },

    { "peer": "a", "op": "log", "message": "(f) PUBLIC: a makes #renamed public in Server settings > Channels; b and c see the globe, then a's post" },
    { "peer": "a", "op": "right_click", "target": "server:reg-ch-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait_for", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Channels", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Channels", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:renamed-${RUN}. Open its settings", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "semantics:renamed-${RUN}. Open its settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:ServerSettingsPlace > semantics:Public", "timeout_ms": 5000 },
    { "peer": "a", "op": "tap", "target": "type:ServerSettingsPlace > semantics:Public", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:renamed-${RUN}, Public. Close its settings", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "rc-05-public-switch", "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Close server settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:ServerSettingsPlace", "timeout_ms": 10000 },
    { "peer": "b", "op": "wait_for", "target": "tooltip:Public: anyone can read this channel without joining", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "target": "tooltip:Public: anyone can read this channel without joining", "timeout_ms": 90000 },
    { "peer": "a", "op": "open_channel", "name": "renamed-${RUN}" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "public post ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "type:MessageRow > text:public post ${RUN}", "timeout_ms": 20000 },
    { "peer": "b", "op": "open_channel", "name": "renamed-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "type:MessageRow > text:public post ${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "open_channel", "name": "renamed-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "type:MessageRow > text:public post ${RUN}", "timeout_ms": 90000 },
    { "peer": "all", "op": "shot", "name": "rc-06-public-post", "soft": true },

    { "peer": "all", "op": "dump", "name": "regress_channels" }
  ],
  "cleanup": [
    { "peer": "a", "op": "log", "message": "a run that died inside Server settings would leave the place open on Channels; close it first" },
    { "peer": "a", "op": "tap", "target": "semantics:Close server settings", "index": 0, "soft": true },
    { "peer": "a", "op": "right_click", "target": "server:reg-ch-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "log", "message": "the confirm's title is 'Delete reg-ch-...?', so index 0 inside the dialog is the button" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:reg-ch-${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:reg-ch-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "gone": "server:reg-ch-${RUN}", "timeout_ms": 90000 }
  ]
}
