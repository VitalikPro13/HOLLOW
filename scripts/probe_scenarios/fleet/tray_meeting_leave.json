{
  "_": [
    "The tray's Leave in a meeting goes through the meeting (track b14-images).",
    "",
    "a hosts a meeting with no waiting room, b joins from the link. b clicks the",
    "tray's Leave: b is out of the meeting (state none, no voice room) and a",
    "still runs it with b's seat gone. b joins again, then a, the host, clicks",
    "the tray's Leave: the window asks 'End the meeting?' and End meeting ends it",
    "for b too. The bare voice leave the tray used before left b's meeting",
    "screen up with no call behind it. The tray menu is native, so the probe's",
    "tray op calls the tray's own click handler. Run the tray side on Windows.",
    "",
    "run: FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario tray_meeting_leave -Peers a=e,b=windows:g"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },

    { "peer": "a", "op": "log", "message": "a creates a room without a waiting room and starts the meeting" },
    { "peer": "a", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Create a room", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Create a room", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:e.g. Weekly sync", "value": "fleet-meet" },
    { "peer": "a", "op": "tap", "target": "dialog > type:HollowToggle", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:fleet-meet", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Start meeting", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Copy link", "index": 0 },
    { "peer": "a", "op": "capture", "from": "clipboard", "as": "LINK" },

    { "peer": "b", "op": "log", "message": "b joins from the link" },
    { "peer": "b", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Join a meeting", "timeout_ms": 20000 },
    { "peer": "b", "op": "tap", "target": "text:Join a meeting", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "dialog > hint:Paste the meeting link", "value": "${LINK}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "guest inCall", "timeout_ms": 90000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":2", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 2000 },
    { "peer": "all", "op": "shot", "name": "tray-01-both-in-meeting" },

    { "peer": "b", "op": "log", "message": "b leaves through the tray" },
    { "peer": "b", "op": "tray", "value": "leave" },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 20000 },
    { "peer": "b", "op": "wait_for", "provider": "voiceRoom", "equals": "", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":1", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 5000 },
    { "peer": "all", "op": "wait", "ms": 1500 },
    { "peer": "all", "op": "shot", "name": "tray-02-guest-left-by-tray" },
    { "peer": "all", "op": "dump", "name": "tray-02-guest-left-by-tray" },

    { "peer": "b", "op": "log", "message": "b joins again; now the host leaves through the tray" },
    { "peer": "b", "op": "wait_for", "target": "text:Join a meeting", "timeout_ms": 20000 },
    { "peer": "b", "op": "tap", "target": "text:Join a meeting", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "dialog > hint:Paste the meeting link", "value": "${LINK}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "guest inCall", "timeout_ms": 90000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":2", "timeout_ms": 60000 },

    { "peer": "a", "op": "tray", "value": "leave" },
    { "peer": "a", "op": "wait_for", "target": "text:End the meeting?", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "tray-03-host-asked" },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 2000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:End meeting", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "provider": "voiceRoom", "equals": "", "timeout_ms": 20000 },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "provider": "voiceRoom", "equals": "", "timeout_ms": 20000 },
    { "peer": "all", "op": "wait", "ms": 1500 },
    { "peer": "all", "op": "shot", "name": "tray-04-host-ended-by-tray" },
    { "peer": "all", "op": "dump", "name": "tray-04-host-ended-by-tray" }
  ]
}
