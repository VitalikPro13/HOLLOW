{
  "_": [
    "Regression pass, a voice room with three throwaway peers, then the screen-share watch",
    "opt-in (issue #38). a makes a server with a voice room, b and c join both. Every peer",
    "mutes the moment it is in (the dock's Mute; a join always starts unmuted), and every",
    "sidebar must show three participant rows, each with the muted mark. c leaves: a and b",
    "drop to two rows and are still in the room 10 s later (Leave the room still offered).",
    "Then a shares Screen 1. b gets the OFFER tile ('probe-a is sharing their screen' with",
    "its Watch button) and NO stream: after 8 s still an offer and no RTCVideoView in b's",
    "tree (cameras are off, so a share is the only thing that draws one). b taps Watch and",
    "the live tile and its RTCVideoView appear. a stops sharing, everyone leaves, cleanup",
    "deletes the server and b and c must lose it.",
    "",
    "What the widgets cannot prove: pixels and audio. Read hollow_debug.log for the",
    "screen_watch signal and [HOLLOW-VC] lines. All three instances share this machine's",
    "mic and speakers and each mic is live for about a second before its Mute lands, so",
    "mute the OS default input first. The share picker is Windows-only here: 'Screen 1' is",
    "libwebrtc's source name, and a Wayland portal or a macOS permission prompt is native",
    "UI the probe cannot answer.",
    "",
    "run: powershell -File scripts/fleet.ps1 -Scenario regress_voice3 -Peers a,b,c"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_B" },
    { "peer": "c", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_C" },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "vc3-${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:vc3-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "vc3-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },

    { "peer": "a", "op": "log", "message": "the voice room is made before anyone joins, so it rides the join snapshot" },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Create channel", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "room-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:room-${RUN}", "timeout_ms": 30000 },

    { "peer": "a", "op": "right_click", "target": "server:vc3-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 10000 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:vc3-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "vc3-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "channel:room-${RUN}", "timeout_ms": 60000 },

    { "peer": "c", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "c", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "c", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "server:vc3-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "open_server", "name": "vc3-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "channel:room-${RUN}", "timeout_ms": 60000 },

    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_B}", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_C}", "timeout_ms": 60000 },

    { "peer": "a", "op": "log", "message": "each peer joins, mutes at once (shared mic), then opens the room's stage with a second click" },
    { "peer": "a", "op": "open_channel", "name": "room-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Mute", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Unmute", "timeout_ms": 10000 },
    { "peer": "a", "op": "open_channel", "name": "room-${RUN}" },
    { "peer": "b", "op": "open_channel", "name": "room-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "semantics:Mute", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Unmute", "timeout_ms": 10000 },
    { "peer": "b", "op": "open_channel", "name": "room-${RUN}" },
    { "peer": "c", "op": "open_channel", "name": "room-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "c", "op": "tap", "target": "semantics:Mute", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Unmute", "timeout_ms": 10000 },
    { "peer": "c", "op": "open_channel", "name": "room-${RUN}" },

    { "peer": "all", "op": "log", "message": "three participant rows in every sidebar, and every row carries the muted mark" },
    { "peer": "all", "op": "wait_for", "target": "type:_VoiceParticipantRow", "count": 3, "timeout_ms": 60000 },
    { "peer": "all", "op": "wait_for", "target": "type:_VoiceParticipantRow > icon:micOff", "count": 3, "timeout_ms": 30000 },
    { "peer": "all", "op": "wait", "ms": 5000 },
    { "peer": "all", "op": "shot", "name": "vc3-01-three" },
    { "peer": "all", "op": "dump", "name": "vc3-01-three" },

    { "peer": "c", "op": "log", "message": "c leaves: a and b drop to two rows and stay in the room" },
    { "peer": "c", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "c", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "target": "type:_VoiceParticipantRow", "count": 2, "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "type:_VoiceParticipantRow", "count": 2, "timeout_ms": 30000 },
    { "peer": "c", "op": "wait_for", "target": "type:_VoiceParticipantRow", "count": 2, "timeout_ms": 30000 },
    { "peer": "all", "op": "wait", "ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 2000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 2000 },
    { "peer": "a", "op": "expect_count", "target": "type:_VoiceParticipantRow", "value": 2 },
    { "peer": "b", "op": "expect_count", "target": "type:_VoiceParticipantRow", "value": 2 },
    { "peer": "all", "op": "shot", "name": "vc3-02-c-left" },

    { "peer": "a", "op": "log", "message": "a shares Screen 1 (no audio, the dialog's default)" },
    { "peer": "a", "op": "tap", "target": "semantics:Share your screen", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:ScreenShareDialog > text:Screen 1", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:ScreenShareDialog > text:Screen 1", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:ScreenShareDialog > text:Share", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:ScreenShareDialog", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Stop sharing", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Your screen", "timeout_ms": 20000, "soft": true },

    { "peer": "b", "op": "log", "message": "b is offered the share and nothing streams until b asks (#38)" },
    { "peer": "b", "op": "wait_for", "target": "semantics:probe-a is sharing their screen", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Watch probe-a's screen", "timeout_ms": 5000 },
    { "peer": "b", "op": "wait_for", "target": "type:_VoiceParticipantRow > icon:monitor", "timeout_ms": 15000, "soft": true },
    { "peer": "b", "op": "wait", "ms": 8000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:probe-a is sharing their screen", "timeout_ms": 2000 },
    { "peer": "b", "op": "expect_count", "target": "type:RTCVideoView", "value": 0 },
    { "peer": "all", "op": "shot", "name": "vc3-03-offer" },

    { "peer": "b", "op": "tap", "target": "semantics:Watch probe-a's screen", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:probe-a's screen", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "type:RTCVideoView", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "target": "contains:probe-b is watching", "timeout_ms": 15000, "soft": true },
    { "peer": "all", "op": "wait", "ms": 4000 },
    { "peer": "all", "op": "shot", "name": "vc3-04-watching" },
    { "peer": "all", "op": "dump", "name": "vc3-04-watching" },

    { "peer": "a", "op": "tap", "target": "semantics:Stop sharing", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Share your screen", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "gone": "type:RTCVideoView", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "semantics:Stop sharing", "index": 0, "soft": true },
    { "peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0, "soft": true },
    { "peer": "a", "op": "right_click", "target": "server:vc3-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "log", "message": "the confirm's button, scoped to the dialog: the settings page behind it has a 'Delete server' button too" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:vc3-${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:vc3-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "gone": "server:vc3-${RUN}", "timeout_ms": 90000 }
  ]
}
