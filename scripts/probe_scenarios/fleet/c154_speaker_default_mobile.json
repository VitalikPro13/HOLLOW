  },
  {
   "peer": "k",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "active",
   "timeout_ms": 45000
  },
  {
   "peer": "all",
   "op": "wait",
   "ms": 10000
  },
  {
   "peer": "k",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "active",
   "timeout_ms": 2000
  },
  {
   "peer": "all",
   "op": "log",
