  },
  {
   "peer": "j",
   "op": "wait_for",
   "provider": "callSpeakerOn",
   "equals": true,
   "timeout_ms": 5000
  },
  {
   "peer": "k",
   "op": "wait_for",
   "provider": "callSpeakerOn",
   "equals": true,
   "timeout_ms": 5000
  },
  {
   "peer": "all",
   "op": "shot",
   "name": "c154-02-in-call-speaker"
  },
