  },
  {
   "peer": "j",
   "op": "tap",
   "target": "semantics:Settings",
   "index": 0
  },
  {
   "peer": "j",
   "op": "wait",
   "ms": 1000
  },
  {
   "peer": "j",
   "op": "tap",
   "target": "text:Audio & video",
   "index": 0
  },
  {
   "peer": "j",
   "op": "wait",
   "ms": 1500
  },
  {
   "peer": "j",
   "op": "wait_for",
   "target": "text:Start calls on the speaker",
   "timeout_ms": 10000
  },
  {
   "peer": "j",
   "op": "scroll",
   "target": "text:Start calls on the speaker",
   "index": 0,
   "dy": -200,
   "soft": true
  },
  {
   "peer": "j",
   "op": "wait",
   "ms": 800
  },
  {
   "peer": "j",
   "op": "shot",
   "name": "c154-04-setting"
  }
 ],
 "cleanup": [
  {
   "peer": "all",
   "op": "log",
   "message": "nothing to undo: every run restores the fixture data directories, so the friendship and the DMs are gone before the next one starts."
  }
 ]
}