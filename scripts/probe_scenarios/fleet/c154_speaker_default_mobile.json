  {
   "peer": "k",
   "op": "tap",
   "target": "semantics:Send message",
   "index": 0
  },
  {
   "peer": "k",
   "op": "wait_for",
   "target": "text:dm from b ${RUN}",
   "timeout_ms": 15000
  },
  {
   "peer": "j",
   "op": "tap",
   "target": "semantics:Chats",
   "index": 0
  },
  {
   "peer": "j",
   "op": "wait_for",
   "target": "text:dm from b ${RUN}",
   "timeout_ms": 60000
  },
  {
   "peer": "j",
   "op": "tap",
   "target": "text:probe-k"
  },
  {
   "peer": "j",
   "op": "wait_for",
   "target": "field",
   "timeout_ms": 15000
  },
  {
   "peer": "j",
   "op": "tap",
   "target": "field",
   "index": 0
  },
  {
   "peer": "j",
   "op": "enter_text",
   "target": "field",
   "value": "dm from a ${RUN}"
  },
  {
   "peer": "j",
   "op": "tap",
   "target": "semantics:Send message",
   "index": 0
  },
  {
   "peer": "j",
   "op": "wait_for",
   "target": "text:dm from a ${RUN}",
   "timeout_ms": 15000
  },
  {
   "peer": "k",
   "op": "wait_for",
   "target": "text:dm from a ${RUN}",
   "timeout_ms": 60000
  },
  {
   "peer": "all",
   "op": "log",
   "message": "b calls a from the open DM; a answers; both reach an active call; b hangs up"
  },
  {
   "peer": "k",
   "op": "tap",
   "target": "semantics:Voice call",
   "index": 0
  },
  {
   "peer": "j",
