  },
  {
   "peer": "j",
   "op": "wait_for",
   "target": "text:probe-k",
   "timeout_ms": 60000
  },
  {
   "peer": "k",
   "op": "wait_for",
   "target": "text:probe-j",
   "timeout_ms": 60000
  },
  {
   "peer": "k",
   "op": "tap",
   "target": "text:probe-j"
  },
  {
   "peer": "k",
   "op": "wait_for",
