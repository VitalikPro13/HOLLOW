   "key": "peerId",
   "as": "PEER_A"
  },
  {
   "peer": "k",
   "op": "tap",
   "target": "semantics:Friends",
   "index": 0
  },
  {
   "peer": "k",
   "op": "tap",
   "target": "text:Add friend",
   "index": 0
  },
  {
   "peer": "k",
   "op": "enter_text",
   "target": "hint:Paste an ID, or type a nickname",
   "value": "${PEER_A}"
  },
  {
   "peer": "k",
   "op": "wait_for",
   "target": "text:${PEER_A}",
   "timeout_ms": 10000
  },
  {
   "peer": "k",
   "op": "tap",
   "target": "text:Send request",
   "index": 0
  },
  {
   "peer": "j",
   "op": "wait_for",
