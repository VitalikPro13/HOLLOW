   "peer": "b",
   "op": "shot",
   "name": "s-f-outgoing"
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "text:Needs Attention",
   "timeout_ms": 60000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "semantics:Add friend",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait",
   "ms": 1000
