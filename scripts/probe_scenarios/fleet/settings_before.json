{
 "_": [
  "Settings and the Friends Manager, every page, on two FRESH throwaway peers",
  "(b sends a a request; a accepts). The 'before' pass for session 16.",
  "run: powershell -File scripts\fleet.ps1 -Scenario settings_before -Peers a,b"
 ],
 "peers": [
  "a",
  "b"
 ],
 "steps": [
  {
   "peer": "all",
   "op": "wait_for",
   "provider": "connection",
   "equals": "connected",
   "timeout_ms": 120000
  },
  {
   "peer": "all",
   "op": "wait",
   "ms": 3000
  },
  {
   "peer": "a",
   "op": "capture",
   "from": "provider",
   "key": "peerId",
   "as": "PEER_A"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Add friend",
   "index": 0
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "type:_FriendsManager > text:Add friend",
   "index": 0
  },
  {
   "peer": "b",
   "op": "enter_text",
   "target": "hint:Paste an ID, or type a nickname",
   "value": "${PEER_A}"
  },
  {
   "peer": "b",
   "op": "wait",
   "ms": 800
  },
  {
   "peer": "b",
   "op": "shot",
   "name": "s-f-add"
  },
  {
