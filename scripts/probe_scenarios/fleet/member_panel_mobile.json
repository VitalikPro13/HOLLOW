{
  "_": [
    "The phone's member sheet after the member panel pass (2026-09-26): a",
    "server, b joins, b opens #general and the Members sheet (Owner, Online),",
    "folds Online, light theme. A throwaway server, deleted at the end.",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario member_panel_mobile -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "all", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "members-m" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:members-m", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "long_press", "target": "text:members-m", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Invite people", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },

    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "b", "op": "wait_for", "target": "text:members-m", "timeout_ms": 90000 },

    { "peer": "b", "op": "wait", "ms": 2000 },
    { "peer": "b", "op": "tap", "target": "text:members-m" },
    { "peer": "b", "op": "wait", "ms": 1200 },
    { "peer": "b", "op": "tap", "target": "text:general" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Members", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait", "ms": 4000 },
    { "peer": "b", "op": "tap", "target": "semantics:Members" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "shot", "name": "mm-01-sheet" },
    { "peer": "b", "op": "tap", "target": "semantics:Collapse Online, 1 members", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 600 },
    { "peer": "b", "op": "shot", "name": "mm-02-folded" },
    { "peer": "b", "op": "tap", "target": "semantics:Expand Online, 1 members", "index": 0, "soft": true },
    { "peer": "b", "op": "theme", "value": "light" },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "shot", "name": "mm-03-light" },
    { "peer": "b", "op": "theme", "value": "dark" }
  ],
  "cleanup": [
    { "peer": "a", "op": "theme", "value": "dark", "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "long_press", "target": "text:members-m", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Server settings", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "text:Overview", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "gone": "text:members-m", "timeout_ms": 30000, "soft": true }
  ]
}
