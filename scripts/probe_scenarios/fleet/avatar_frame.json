{
  "_": [
    "Avatar frames (issue #54) across two real instances over the real relay.",
    "",
    "The Rust harness proves the ID converges and the art pulls; a single probe",
    "instance proves the picker and the render. Neither can answer the question",
    "that actually matters: does the frame somebody else picked show up on",
    "THEIR avatar in MY app, without a restart. The frame ID rides the profile",
    "announce and lands in profileProvider, and every avatar in the app reads",
    "it from there - so this is a test of that seam and nothing else.",
    "",
    "Built-in colours only. An upload goes through a native file dialog, which",
    "the probe cannot drive; the art path is covered by the screenshot test and",
    "by the rail pull in the Rust harness.",
    "",
    "Creates no server, so there is nothing to delete. It DOES change a's",
    "profile, which is why the last steps put it back rather than leaning on",
    "the fixture restore - an -Attach run does not get one.",
    "",
    "run: powershell -File scripts/fleet.ps1 -Scenario avatar_frame"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "target": "text:Connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },

    { "peer": "a", "op": "log", "message": "b has to be able to SEE a's profile, so make them friends first" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Add Friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Peer ID or nickname...", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send Request", "index": 0 },

    { "peer": "a", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Incoming", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Accept friend request", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:Accept friend request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:probe-b", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "b", "op": "key", "value": "escape" },

    { "peer": "b", "op": "log", "message": "nobody has a frame yet" },
    { "peer": "b", "op": "expect_count", "target": "type:AvatarFrame", "value": 0 },

    { "peer": "a", "op": "log", "message": "a picks a built-in frame and saves" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings" },
    { "peer": "a", "op": "wait", "ms": 1800 },
    { "peer": "a", "op": "tap", "target": "text:Profile" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:Frame" },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Violet" },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Use frame" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:Save profile" },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "frame-a-own" },

    { "peer": "a", "op": "log", "message": "and it has to reach b's UI with no restart and no refresh" },
    { "peer": "b", "op": "wait_for", "target": "type:AvatarFrame", "timeout_ms": 90000 },
    { "peer": "b", "op": "shot", "name": "frame-b-sees-it" },
    { "peer": "b", "op": "dump", "name": "frame-b-sees-it" },

    { "peer": "a", "op": "log", "message": "put it back, and the CLEAR has to propagate too" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings" },
    { "peer": "a", "op": "wait", "ms": 1800 },
    { "peer": "a", "op": "tap", "target": "text:Profile" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:Frame" },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:No frame" },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Use frame" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:Save profile" },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "wait", "ms": 6000 },
    { "peer": "b", "op": "expect_count", "target": "type:AvatarFrame", "value": 0 },
    { "peer": "b", "op": "shot", "name": "frame-b-cleared" }
  ],
  "cleanup": [
    { "peer": "all", "op": "log", "message": "no server created, and a's frame is cleared by the last steps so an -Attach run leaves nothing behind either." }
  ]
}
