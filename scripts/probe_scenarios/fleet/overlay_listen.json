{
  "_": [
    "Listening for the stream overlay hands the mic to calls (plan 7a).",
    "g and h befriend and both listen. g joins a voice room alone (listening",
    "pauses before the room's getUserMedia), leaves (it resumes), then calls h",
    "and h answers (both pause), g hangs up (both resume). The user bar chip",
    "is shot in the Dock and in Classic, then turned off by its own tap.",
    "The hollow_debug.log of each peer shows '[OVERLAY-MIC] yield(...): stop",
    "completed' before the call's 'Got local audio', then 'listening started'.",
    "",
    "Needs FRESH peers (not yet friends).",
    "run: powershell -File scripts\\fleet.ps1 -Scenario overlay_listen -Peers g,h"
  ],
  "peers": ["g", "h"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "g", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_G" },
    { "peer": "h", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "h", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "h", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_G}" },
    { "peer": "h", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "g", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "g", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "h", "op": "wait_for", "target": "text:probe-g", "timeout_ms": 60000 },
    { "peer": "h", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "h", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "g", "op": "key", "value": "escape" },

    { "peer": "all", "op": "overlay_listen", "value": "on" },
    { "peer": "all", "op": "wait_for", "provider": "overlayMic", "equals": "listening", "timeout_ms": 15000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "g", "op": "shot", "name": "ol-01-dock-listening" },

    { "peer": "g", "op": "log", "message": "VC: join alone" },
    { "peer": "g", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "g", "op": "enter_text", "target": "hint:My Awesome Server", "value": "fleet-overlay" },
    { "peer": "g", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "g", "op": "wait_for", "target": "server:fleet-overlay", "timeout_ms": 30000 },
    { "peer": "g", "op": "open_server", "name": "fleet-overlay" },
    { "peer": "g", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "g", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "g", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "g", "op": "enter_text", "target": "dialog > type:TextField", "value": "lounge" },
    { "peer": "g", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "g", "op": "wait_for", "target": "channel:lounge", "timeout_ms": 30000 },
    { "peer": "g", "op": "open_channel", "name": "lounge" },
    { "peer": "g", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "g", "op": "open_channel", "name": "lounge", "_": "a join keeps the text channel on screen; the second tap shows the room" },
    { "peer": "g", "op": "wait_for", "target": "type:CallStage", "timeout_ms": 15000 },
    { "peer": "g", "op": "wait_for", "provider": "overlayMic", "equals": "paused", "timeout_ms": 15000 },
    { "peer": "g", "op": "wait", "ms": 1500 },
    { "peer": "g", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "g", "op": "shot", "name": "ol-02-in-room-paused" },
    { "peer": "g", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "g", "op": "wait_for", "provider": "overlayMic", "equals": "listening", "timeout_ms": 15000 },
    { "peer": "g", "op": "log", "message": "VC: left, listening again" },

    { "peer": "g", "op": "log", "message": "DM call: g calls h" },
    { "peer": "g", "op": "tap", "target": "semantics:Home", "index": 0 },
    { "peer": "g", "op": "wait", "ms": 1000 },
    { "peer": "g", "op": "tap", "target": "semantics:probe-h" },
    { "peer": "g", "op": "wait", "ms": 1500 },
    { "peer": "g", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "g", "op": "wait_for", "provider": "overlayMic", "equals": "paused", "timeout_ms": 10000 },
    { "peer": "h", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "h", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "callStatus", "equals": "active", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait_for", "provider": "overlayMic", "equals": "paused", "timeout_ms": 10000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "ol-03-dm-call-paused" },
    { "peer": "g", "op": "tap", "target": "semantics:Leave the call", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait_for", "provider": "overlayMic", "equals": "listening", "timeout_ms": 15000 },
    { "peer": "g", "op": "log", "message": "DM call: ended, listening again" },

    { "peer": "g", "op": "tap", "target": "semantics:Settings" },
    { "peer": "g", "op": "wait", "ms": 1200 },
    { "peer": "g", "op": "tap", "target": "text:Appearance", "index": 0 },
    { "peer": "g", "op": "wait", "ms": 800 },
    { "peer": "g", "op": "tap", "target": "text:Classic", "index": 0 },
    { "peer": "g", "op": "wait", "ms": 1200 },
    { "peer": "g", "op": "key", "value": "escape" },
    { "peer": "g", "op": "wait", "ms": 1200 },
    { "peer": "g", "op": "open_server", "name": "fleet-overlay" },
    { "peer": "g", "op": "wait", "ms": 1200 },
    { "peer": "g", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "g", "op": "shot", "name": "ol-04-classic-listening" },
    { "peer": "g", "op": "tap", "target": "text:Mic on for overlay", "index": 0 },
    { "peer": "g", "op": "wait_for", "provider": "overlayMic", "equals": "off", "timeout_ms": 10000 },
    { "peer": "g", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "g", "op": "shot", "name": "ol-05-classic-stopped" }
  ],
  "cleanup": [
    { "peer": "all", "op": "overlay_listen", "value": "off" },
    { "peer": "g", "op": "key", "value": "escape" },
    { "peer": "g", "op": "tap", "target": "semantics:Leave the call", "index": 0, "allowMiss": true },
    { "peer": "g", "op": "tap", "target": "semantics:Leave the room", "index": 0, "allowMiss": true },
    { "peer": "g", "op": "right_click", "target": "server:fleet-overlay" },
    { "peer": "g", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "g", "op": "wait", "ms": 400 },
    { "peer": "g", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "g", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "g", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "g", "op": "wait_for", "gone": "server:fleet-overlay", "timeout_ms": 30000 },
    { "peer": "g", "op": "tap", "target": "semantics:Settings" },
    { "peer": "g", "op": "wait", "ms": 1200 },
    { "peer": "g", "op": "tap", "target": "text:Appearance", "index": 0 },
    { "peer": "g", "op": "wait", "ms": 800 },
    { "peer": "g", "op": "tap", "target": "text:Dock", "index": 0 },
    { "peer": "g", "op": "wait", "ms": 1200 },
    { "peer": "g", "op": "key", "value": "escape" }
  ]
}
