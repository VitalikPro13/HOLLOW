{
  "_": [
    "iPhone and Android in one run (2026-10-06): a and b are Android emulators, c and d",
    "iOS Simulators. Nickname adds both ways (an iPhone claims, an Android adds, and the",
    "reverse), Online both ways, a DM each way, then a server the iPhone owns renamed",
    "three times, which every phone must show within seconds.",
    "",
    "Needs FRESH identities: the relay replays a friend request into its target's inbox",
    "for three days. ${RUN} is unique per run, so the nicknames are too.",
    "",
    "run (on the Mac mini):",
    "  FLEET_ANDROID_PEERS=a,b pwsh scripts/fleet.ps1 -Onboard -Fresh -Peers a,b,c,d",
    "  FLEET_ANDROID_PEERS=a,b pwsh scripts/fleet.ps1 -Scenario mobile_mixed_social"
  ],
  "peers": ["a", "b", "c", "d"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "ID_A" },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "ID_B" },
    { "peer": "c", "op": "capture", "from": "provider", "key": "peerId", "as": "ID_C" },
    { "peer": "d", "op": "capture", "from": "provider", "key": "peerId", "as": "ID_D" },

    { "peer": "c", "op": "log", "message": "the iPhone claims a nickname, the Android adds it" },
    { "peer": "c", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "c", "op": "tap", "target": "text:Add friend", "index": 0 },
    { "peer": "c", "op": "tap", "target": "hint:Choose a nickname", "index": 0 },
    { "peer": "c", "op": "enter_text", "target": "hint:Choose a nickname", "value": "ios${RUN}" },
    { "peer": "c", "op": "tap", "target": "text:Claim", "index": 0 },
    { "peer": "c", "op": "wait_for", "provider": "nickname", "equals": "claimed ios${RUN}", "timeout_ms": 15000 },
    { "peer": "c", "op": "tap_at", "x": 200, "y": 40 },

    { "peer": "a", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Add friend", "index": 0 },
    { "peer": "a", "op": "tap", "target": "hint:Paste an ID, or type a nickname", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "IOS${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Send a friend request to IOS${RUN}?", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Send request", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Accept friend request", "timeout_ms": 60000 },
    { "peer": "c", "op": "tap", "target": "semantics:Accept friend request", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "friends", "matches": "${ID_C}\",\"status\":\"accepted", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "provider": "friends", "matches": "${ID_A}\",\"status\":\"accepted", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "provider": "online", "matches": "${ID_C}", "timeout_ms": 30000 },
    { "peer": "c", "op": "wait_for", "provider": "online", "matches": "${ID_A}", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "target": "text:Online", "timeout_ms": 15000 },
    { "peer": "c", "op": "wait_for", "target": "text:Online", "timeout_ms": 15000 },

    { "peer": "b", "op": "log", "message": "the reverse: the Android claims, the iPhone adds" },
    { "peer": "b", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "hint:Choose a nickname", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Choose a nickname", "value": "droid${RUN}" },
    { "peer": "b", "op": "tap", "target": "text:Claim", "index": 0 },
    { "peer": "b", "op": "wait_for", "provider": "nickname", "equals": "claimed droid${RUN}", "timeout_ms": 15000 },
    { "peer": "b", "op": "tap_at", "x": 200, "y": 40 },

    { "peer": "d", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "d", "op": "tap", "target": "text:Add friend", "index": 0 },
    { "peer": "d", "op": "tap", "target": "hint:Paste an ID, or type a nickname", "index": 0 },
    { "peer": "d", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "droid${RUN}" },
    { "peer": "d", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "d", "op": "wait_for", "target": "text:Send a friend request to droid${RUN}?", "timeout_ms": 20000 },
    { "peer": "d", "op": "tap", "target": "dialog > text:Send request", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Accept friend request", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "semantics:Accept friend request", "index": 0 },
    { "peer": "b", "op": "wait_for", "provider": "friends", "matches": "${ID_D}\",\"status\":\"accepted", "timeout_ms": 60000 },
    { "peer": "d", "op": "wait_for", "provider": "friends", "matches": "${ID_B}\",\"status\":\"accepted", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait_for", "provider": "online", "matches": "${ID_D}", "timeout_ms": 30000 },
    { "peer": "d", "op": "wait_for", "provider": "online", "matches": "${ID_B}", "timeout_ms": 30000 },

    { "peer": "a", "op": "log", "message": "a DM each way between the Android a and the iPhone c" },
    { "peer": "a", "op": "tap", "target": "text:probe-c" },
    { "peer": "a", "op": "wait_for", "target": "field", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "field", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "from android ${RUN}" },
    { "peer": "a", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "c", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "text:from android ${RUN}", "timeout_ms": 60000 },
    { "peer": "c", "op": "tap", "target": "text:probe-a" },
    { "peer": "c", "op": "wait_for", "target": "field", "timeout_ms": 15000 },
    { "peer": "c", "op": "tap", "target": "field", "index": 0 },
    { "peer": "c", "op": "enter_text", "target": "field", "value": "from iphone ${RUN}" },
    { "peer": "c", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:from iphone ${RUN}", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "c", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },

    { "peer": "c", "op": "log", "message": "a server the iPhone owns, everyone joins, three renames each reach every phone" },
    { "peer": "c", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "c", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "c", "op": "wait", "ms": 1000 },
    { "peer": "c", "op": "enter_text", "target": "hint:My Awesome Server", "value": "mix-${RUN}" },
    { "peer": "c", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "text:mix-${RUN}", "timeout_ms": 30000 },
    { "peer": "c", "op": "long_press", "target": "text:mix-${RUN}", "index": 0 },
    { "peer": "c", "op": "wait", "ms": 1000 },
    { "peer": "c", "op": "tap", "target": "text:Invite people", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "c", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "c", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "a", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "d", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "d", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "d", "op": "wait", "ms": 1000 },
    { "peer": "d", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "d", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "servers", "matches": "mix-${RUN}", "timeout_ms": 120000 },
    { "peer": "b", "op": "wait_for", "provider": "servers", "matches": "mix-${RUN}", "timeout_ms": 120000 },
    { "peer": "d", "op": "wait_for", "provider": "servers", "matches": "mix-${RUN}", "timeout_ms": 120000 },

    { "peer": "c", "op": "long_press", "target": "text:mix-${RUN}", "index": 0 },
    { "peer": "c", "op": "wait", "ms": 1000 },
    { "peer": "c", "op": "tap", "target": "text:Server settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "text:4 online · 4 members", "timeout_ms": 30000 },
    { "peer": "c", "op": "tap", "target": "text:Overview", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "hint:Server name", "timeout_ms": 10000 },

    { "peer": "c", "op": "enter_text", "target": "hint:Server name", "value": "one-${RUN}" },
    { "peer": "c", "op": "tap", "target": "text:Save", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "servers", "matches": "one-${RUN}", "timeout_ms": 10000 },
    { "peer": "c", "op": "enter_text", "target": "hint:Server name", "value": "two-${RUN}" },
    { "peer": "c", "op": "tap", "target": "text:Save", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "servers", "matches": "two-${RUN}", "timeout_ms": 10000 },
    { "peer": "c", "op": "enter_text", "target": "hint:Server name", "value": "three-${RUN}" },
    { "peer": "c", "op": "tap", "target": "text:Save", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "servers", "matches": "three-${RUN}", "timeout_ms": 10000 },

    { "peer": "all", "op": "shot", "name": "mixed_done" },
    { "peer": "all", "op": "dump", "name": "mixed_done" }
  ],
  "cleanup": [
    { "peer": "c", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "c", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "all", "op": "log", "message": "the server and friendships live only in throwaway identities; the next run restores the fixtures" }
  ]
}
