{
 "_": [
  "Enter on a desktop composer and edit box, with and without marked text (tmp3 4g). One peer, Saved messages.",
  "The ime op plays the input method: composing=true is marked text (a Japanese conversion), false is committed text.",
  "Expect: plain and numpad Enter send; Shift+Enter and Ctrl+Enter break the line; Enter over marked text is UNHANDLED and sends nothing;",
  "after the commit Enter sends; a handed-back Enter (submit, action send) sends; edit Enter saves, and over marked text leaves the edit open.",
  "macOS and Linux only: Windows never shows the IME's keys to the framework, so there Enter over a composing range sends by design (ime_enter_test covers it).",
  "run: FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario ime_enter_desktop -Peers a=y"
 ],
 "peers": ["a"],
 "steps": [
  {"peer": "a", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000},
  {"peer": "a", "op": "wait", "ms": 1500},
  {"peer": "a", "op": "tap", "target": "text:Accept", "index": 0, "soft": true},
  {"peer": "a", "op": "wait_for", "target": "text:Saved messages", "timeout_ms": 15000},
  {"peer": "a", "op": "tap", "target": "text:Saved messages", "index": 0},
  {"peer": "a", "op": "wait_for", "target": "type:ChatComposerRow > type:EditableText", "timeout_ms": 10000},

  {"peer": "a", "op": "log", "message": "plain Enter sends"},
  {"peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "plain ${RUN}"},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "wait_for", "target": "type:MessageRow > text:plain ${RUN}", "timeout_ms": 20000},

  {"peer": "a", "op": "log", "message": "numpad Enter sends (soft: the key simulator has no Windows code for it, Windows reports it as Enter)"},
  {"peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "numpad ${RUN}"},
  {"peer": "a", "op": "key", "value": "numpadEnter", "soft": true},
  {"peer": "a", "op": "wait_for", "target": "type:MessageRow > text:numpad ${RUN}", "timeout_ms": 20000, "soft": true},
  {"peer": "a", "op": "key", "value": "enter", "soft": true},

  {"peer": "a", "op": "log", "message": "Shift+Enter and Ctrl+Enter break the line, then Enter sends"},
  {"peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "lines ${RUN}"},
  {"peer": "a", "op": "key", "value": "shift+enter"},
  {"peer": "a", "op": "key", "value": "ctrl+enter"},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "expect_count", "target": "type:MessageRow > contains:lines ${RUN}", "value": 0},
  {"peer": "a", "op": "shot", "name": "ime-01-two-line-breaks"},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "wait_for", "target": "type:MessageRow > contains:lines ${RUN}", "timeout_ms": 20000},

  {"peer": "a", "op": "log", "message": "Enter over marked text goes to the IME and sends nothing"},
  {"peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText"},
  {"peer": "a", "op": "ime", "value": "にほんご", "composing": true},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "key", "value": "shift+enter"},
  {"peer": "a", "op": "wait", "ms": 1500},
  {"peer": "a", "op": "expect_count", "target": "type:MessageRow > contains:にほんご", "value": 0},
  {"peer": "a", "op": "shot", "name": "ime-02-marked-text-kept"},
  {"peer": "a", "op": "log", "message": "Live Conversion: converted text that is still marked, Enter only confirms"},
  {"peer": "a", "op": "ime", "value": "日本語", "composing": true},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "expect_count", "target": "type:MessageRow > text:日本語", "value": 0},
  {"peer": "a", "op": "ime", "value": "日本語 ${RUN}", "composing": false},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "wait_for", "target": "type:MessageRow > text:日本語 ${RUN}", "timeout_ms": 20000},

  {"peer": "a", "op": "log", "message": "an Enter the IME hands back (the field's send action) sends"},
  {"peer": "a", "op": "ime", "value": "안녕 ${RUN}", "composing": false},
  {"peer": "a", "op": "key", "value": "submit", "action": "send"},
  {"peer": "a", "op": "wait_for", "target": "type:MessageRow > text:안녕 ${RUN}", "timeout_ms": 20000},
  {"peer": "a", "op": "focus_state"},

  {"peer": "a", "op": "log", "message": "edit: Enter over marked text keeps the edit open, Enter after the commit saves"},
  {"peer": "a", "op": "right_click", "target": "type:MessageRow > text:plain ${RUN}"},
  {"peer": "a", "op": "tap", "target": "menu > text:Edit message", "index": 0},
  {"peer": "a", "op": "wait_for", "target": "type:MessageHoverWrapper > type:TextField", "timeout_ms": 5000},
  {"peer": "a", "op": "wait", "ms": 500},
  {"peer": "a", "op": "ime", "value": "へんしゅう", "composing": true},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "expect_count", "target": "type:MessageHoverWrapper > type:TextField", "value": 1},
  {"peer": "a", "op": "shot", "name": "ime-03-edit-marked-text"},
  {"peer": "a", "op": "ime", "value": "plain edited ${RUN}", "composing": false},
  {"peer": "a", "op": "key", "value": "enter"},
  {"peer": "a", "op": "wait_for", "gone": "type:MessageHoverWrapper > type:TextField", "timeout_ms": 10000},
  {"peer": "a", "op": "wait_for", "target": "type:MessageRow > contains:plain edited ${RUN}", "timeout_ms": 15000},
  {"peer": "a", "op": "shot", "name": "ime-04-done"},

  {"peer": "a", "op": "log", "message": "Up and Down in a two-line edit box move the caret (the edit box sits in its row's SelectionArea; this threw before)"},
  {"peer": "a", "op": "right_click", "target": "type:MessageRow > contains:plain edited ${RUN}"},
  {"peer": "a", "op": "tap", "target": "menu > text:Edit message", "index": 0},
  {"peer": "a", "op": "wait_for", "target": "type:MessageHoverWrapper > type:TextField", "timeout_ms": 5000},
  {"peer": "a", "op": "wait", "ms": 500},
  {"peer": "a", "op": "ime", "value": "first line\nsecond line ${RUN}", "composing": false},
  {"peer": "a", "op": "key", "value": "arrowUp"},
  {"peer": "a", "op": "key", "value": "arrowDown"},
  {"peer": "a", "op": "key", "value": "arrowUp"},
  {"peer": "a", "op": "shot", "name": "ime-05-edit-arrows"},
  {"peer": "a", "op": "key", "value": "escape"},
  {"peer": "a", "op": "wait_for", "gone": "type:MessageHoverWrapper > type:TextField", "timeout_ms": 10000}
 ],
 "cleanup": []
}
