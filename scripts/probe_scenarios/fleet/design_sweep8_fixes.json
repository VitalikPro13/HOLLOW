{
  "_": [
    "Design sweep 8 follow-ups on a throwaway desktop peer: the Add a server",
    "dialog, the channel panel's default Text channels header, and the new",
    "label delete confirm. The peer creates the server and label it needs.",
    "",
    "run: powershell -File scripts\\fleet.ps1 -Scenario design_sweep8_fixes -Peers a"
  ],
  "peers": ["a"],
  "steps": [
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "tooltip:Create a server" },
    { "peer": "a", "op": "wait", "ms": 900 },
    { "peer": "a", "op": "shot", "name": "f8-01-add-server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "sweep8" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:sweep8", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "sweep8" },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "f8-02-channel-panel" },

    { "peer": "a", "op": "tap", "target": "semantics:Server settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:Labels", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:New label", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "enter_text", "target": "hint:Label name", "value": "Tester" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Tester", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:More for Tester", "index": 0 },
    { "peer": "a", "op": "tap", "target": "menu > text:Delete", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 900 },
    { "peer": "a", "op": "shot", "name": "f8-03-delete-label" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Cancel", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "expect_text", "value": "Tester" },
    { "peer": "a", "op": "tap", "target": "semantics:More for Tester", "index": 0 },
    { "peer": "a", "op": "tap", "target": "menu > text:Delete", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 900 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete label", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "f8-04-label-deleted" },
    { "peer": "a", "op": "expect_no_text", "value": "Tester" }
  ]
}
