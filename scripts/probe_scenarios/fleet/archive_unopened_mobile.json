{
  "_": [
    "Archive lists channels the phone never opened (t18-archive, 2026-11-19).",
    "b owns a server with #general, #second-RUN and #third-RUN; a joins. Phase 1: b posts in",
    "#general and #second while a has opened nothing, a looks at Archive. Phase 2: a opens",
    "#general and goes back; b posts again in #second and for the first time in #third; a looks",
    "at Archive again. Every visible channel with posts must be listed with its full count.",
    "A throwaway server, deleted at the end.",
    "Phase 3 (notification default): a sits in #general; b posts a plain line in #second (a",
    "server a never set notifies mentions only: no in-chat banner), then a mention of a (banner).",
    "",
    "#154: servers live on the Servers tab and open as a page (channel list, Back to it from a",
    "channel); Archive opens from the Chats header as a page of its own.",
    "",
    "run (Mac mini): pwsh scripts/fleet.ps1 -Scenario archive_unopened_mobile -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "all", "op": "wait", "ms": 2000 },
    { "peer": "all", "op": "tap", "target": "text:Hide", "index": 0, "soft": true },
    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:My Awesome Server", "value": "arc-${RUN}" },
    { "peer": "b", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Servers", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:arc-${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "long_press", "target": "text:arc-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:Create channel", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "dialog > type:EditableText", "timeout_ms": 10000 },
    { "peer": "b", "op": "enter_text", "target": "dialog > type:EditableText", "value": "second-${RUN}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "dialog", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "long_press", "target": "text:arc-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:Create channel", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "dialog > type:EditableText", "timeout_ms": 10000 },
    { "peer": "b", "op": "enter_text", "target": "dialog > type:EditableText", "value": "third-${RUN}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "dialog", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "long_press", "target": "text:arc-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:Invite people", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "b", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "b", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "a", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Servers", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "target": "text:arc-${RUN}", "timeout_ms": 120000 },
    { "peer": "a", "op": "wait", "ms": 8000 },
    { "peer": "a", "op": "log", "message": "PHASE 1: a has opened no channel of the server" },
    { "peer": "b", "op": "tap", "target": "semantics:Servers", "index": 0, "soft": true },
    { "peer": "b", "op": "tap", "target": "text:arc-${RUN}", "index": 0, "why": "opens the server page; b stays on it, Back from a channel lands here" },
    { "peer": "b", "op": "wait", "ms": 1200 },
    { "peer": "b", "op": "tap", "target": "text:general", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "g1 ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "tap", "target": "semantics:Back to channels", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:second-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "s1 ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "tap", "target": "semantics:Back to channels", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 10000 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Archive", "index": 0, "why": "the Chats header's Archive icon" },
    { "peer": "a", "op": "wait", "ms": 4000 },
    { "peer": "a", "op": "look" },
    { "peer": "a", "op": "shot", "name": "arc-01-nothing-opened" },
    { "peer": "a", "op": "log", "message": "PHASE 2: a opens #general, then b posts in #second and #third" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "why": "leaves the Archive page" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Servers", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:arc-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:general", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:g1 ${RUN}", "timeout_ms": 30000, "soft": true },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "semantics:Back to channels", "index": 0, "why": "channel back to the server page" },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "semantics:Back to servers", "index": 0, "why": "server page back to the Servers tab" },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:second-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "s2 ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "tap", "target": "semantics:Back to channels", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:third-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "t1 ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "tap", "target": "semantics:Back to channels", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 15000 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Archive", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 4000 },
    { "peer": "a", "op": "look" },
    { "peer": "a", "op": "shot", "name": "arc-02-after-general-opened" },
    { "peer": "a", "op": "expect_text", "value": "third-${RUN}", "soft": true },
    { "peer": "a", "op": "wait", "ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "why": "leave Archive and open it again: each visit reads the counts afresh" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Archive", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 4000 },
    { "peer": "a", "op": "look" },
    { "peer": "a", "op": "shot", "name": "arc-03-after-45s" },
    { "peer": "a", "op": "log", "message": "PHASE 3: a sits in #general; b posts plain, then a mention, in #second" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "why": "leaves the Archive page" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Servers", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:arc-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:general", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "field", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "b", "op": "tap", "target": "text:second-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "plain p3 ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 8000, "why": "Absence proof: a plain post of a never-set server raises no banner" },
    { "peer": "a", "op": "expect_count", "target": "contains:#second-${RUN}", "value": 0, "soft": true, "why": "the in-chat banner's title names the channel; its body is rich text" },
    { "peer": "a", "op": "shot", "name": "arc-04-plain-no-banner" },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "@probe-a mention p3 ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "contains:#second-${RUN}", "timeout_ms": 30000, "soft": true },
    { "peer": "a", "op": "shot", "name": "arc-05-mention-banner" },
    { "peer": "b", "op": "tap", "target": "semantics:Back to channels", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Back to channels", "index": 0, "soft": true }
  ],
  "cleanup": [
    { "peer": "all", "op": "tap", "target": "semantics:Back to channels", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "tap", "target": "semantics:Back to servers", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "tap", "target": "semantics:Servers", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "long_press", "target": "text:arc-${RUN}", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:Server settings", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "tap", "target": "text:Overview", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 1200 },
    { "peer": "b", "op": "reveal", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "b", "op": "tap", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "tap", "target": "dialog > text:Delete server", "index": 0, "soft": true },
    { "peer": "b", "op": "wait_for", "gone": "text:arc-${RUN}", "timeout_ms": 30000, "soft": true }
  ]
}
