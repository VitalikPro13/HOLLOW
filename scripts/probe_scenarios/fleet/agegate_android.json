{
  "_": [
    "Age-restricted servers on a sideloaded Android phone (t14-agegate): c (computer) owns a server and flags it 18+.",
    "a (Android, toggle off) joins by invite: the age-restricted message with Open settings, which lands on the toggle;",
    "turning it on asks first; then the same invite asks the 18+ consent and the join lands. Needs FRESH identities.",
    "run: FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario agegate_android -Peers a=android:<x>,c=<z>"
  ],
  "peers": ["a", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },

    { "peer": "c", "op": "log", "message": "PART 1: c makes the server and flags it 18+" },
    { "peer": "c", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "c", "op": "wait_for", "target": "dialog > text:Add a server", "timeout_ms": 10000 },
    { "peer": "c", "op": "enter_text", "target": "hint:My Awesome Server", "value": "agd-${RUN}" },
    { "peer": "c", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "server:agd-${RUN}", "timeout_ms": 30000 },
    { "peer": "c", "op": "open_server", "name": "agd-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "c", "op": "tap", "target": "semantics:Server settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Access", "timeout_ms": 15000 },
    { "peer": "c", "op": "tap", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Access", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Adult content", "timeout_ms": 10000 },
    { "peer": "c", "op": "tap", "target": "semantics:Adult content", "index": 0 },
    { "peer": "c", "op": "wait", "ms": 2000 },
    { "peer": "c", "op": "key", "value": "escape" },
    { "peer": "c", "op": "wait", "ms": 1000 },
    { "peer": "c", "op": "key", "value": "escape", "allowMiss": true },
    { "peer": "c", "op": "right_click", "target": "server:agd-${RUN}" },
    { "peer": "c", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "c", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "c", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "c", "op": "key", "value": "escape" },

    { "peer": "a", "op": "log", "message": "PART 2: a (Android, toggle off) taps the invite and is pointed at Settings" },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "a", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Age-restricted server", "timeout_ms": 90000 },
    { "peer": "a", "op": "wait_for", "target": "text:Open settings", "timeout_ms": 5000 },
    { "peer": "a", "op": "expect_no_text", "value": "Sensitive content warning" },
    { "peer": "a", "op": "shot", "name": "agd-01-a-blocked" },
    { "peer": "a", "op": "tap", "target": "text:Open settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Allow age-restricted servers", "timeout_ms": 15000 },
    { "peer": "a", "op": "reveal", "target": "text:Allow age-restricted servers", "allowMiss": true },
    { "peer": "a", "op": "shot", "name": "agd-02-a-toggle-off" },
    { "peer": "a", "op": "tap", "target": "semantics:Allow age-restricted servers", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Allow age-restricted servers?", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "agd-03-a-confirm" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Allow", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:Allow age-restricted servers?", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "agd-04-a-toggle-on" },

    { "peer": "a", "op": "log", "message": "PART 3: with the toggle on, the same invite asks the 18+ consent and joins" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "a", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Sensitive content warning", "timeout_ms": 90000 },
    { "peer": "a", "op": "shot", "name": "agd-05-a-consent" },
    { "peer": "a", "op": "tap", "target": "text:I am 18 or older, join", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:agd-${RUN}", "timeout_ms": 90000 },
    { "peer": "a", "op": "expect_no_text", "value": "Show age-restricted servers on your phones?" },
    { "peer": "a", "op": "shot", "name": "agd-06-a-joined" }
  ]
}
