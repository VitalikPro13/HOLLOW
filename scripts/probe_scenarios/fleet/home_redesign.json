{
  "_": [
    "Home redesign (design language section 5) on three throwaway peers.",
    "a starts empty (the first run), b and c send it friend requests that a",
    "answers from Home's Needs Attention strip, both DM a, and b mentions a in",
    "a server a creates and sits in its voice room, so a's Home shows every",
    "state at once: unread DMs, a mention row, Active Now. Then the New message",
    "dialog, the news post, and the two Settings pages Home's figures moved to.",
    "",
    "The server is created by this run and deleted by its cleanup.",
    "${RUN} is unique per run: the relay holds undelivered traffic for three",
    "days and these identities are stable.",
    "",
    "run: powershell -File scripts\\fleet.ps1 -Scenario home_redesign -Peers a,b,c"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "all", "op": "wait", "ms": 3000 },
    { "peer": "a", "op": "shot", "name": "h-01-first-run" },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "h-02-first-run-light" },
    { "peer": "a", "op": "theme", "value": "dark" },

    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Add Friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Peer ID or nickname...", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send Request", "index": 0 },
    { "peer": "c", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "c", "op": "tap", "target": "text:Add Friend", "index": 0 },
    { "peer": "c", "op": "enter_text", "target": "hint:Peer ID or nickname...", "value": "${PEER_A}" },
    { "peer": "c", "op": "tap", "target": "text:Send Request", "index": 0 },

    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "shot", "name": "h-03-requests" },

    { "peer": "a", "op": "log", "message": "answer both requests from Home itself, not the Friends dialog" },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },

    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "c", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "tooltip:probe-a" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "sent you the stems, tell me what you think ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "c", "op": "tap", "target": "tooltip:probe-a" },
    { "peer": "c", "op": "wait", "ms": 1500 },
    { "peer": "c", "op": "enter_text", "target": "field", "value": "see you on the stream tonight ${RUN}" },
    { "peer": "c", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:see you on the stream tonight ${RUN}", "timeout_ms": 60000 },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "home-probe" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:home-probe", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "home-probe" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "lounge" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:lounge", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:home-probe" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:SelectableText", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:SelectableText", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "tap", "target": "semantics:Home", "index": 0 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:home-probe", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "home-probe" },
    { "peer": "b", "op": "open_channel", "name": "general" },
    { "peer": "b", "op": "wait", "ms": 4000 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "@probe-a can you check the relay logs ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "open_channel", "name": "lounge" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Disconnect", "timeout_ms": 30000 },

    { "peer": "a", "op": "wait_for", "target": "text:#general", "timeout_ms": 60000, "soft": true },
    { "peer": "a", "op": "wait_for", "target": "text:Active Now", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait", "ms": 4000 },
    { "peer": "a", "op": "shot", "name": "h-04-populated" },
    { "peer": "a", "op": "tap", "target": "text:Unread", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "h-05-unread-filter" },
    { "peer": "a", "op": "tap", "target": "text:All", "index": 0 },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "h-06-populated-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "wait", "ms": 600 },

    { "peer": "a", "op": "tap", "target": "text:New message", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "h-07-new-message" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "tap", "target": "text:News", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "h-08-news-post" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 600 },

    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Network", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "shot", "name": "h-09-settings-network" },
    { "peer": "a", "op": "tap", "target": "text:Devices", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "h-10-settings-devices" },
    { "peer": "a", "op": "key", "value": "escape" }
  ],
  "cleanup": [
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "right_click", "target": "server:home-probe" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "tap", "target": "text:Danger", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 1 },
    { "peer": "a", "op": "wait_for", "gone": "server:home-probe", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:home-probe", "timeout_ms": 90000 }
  ]
}
