{
 "_": [
  "HOL-SEC-190 desktop twin of vol_receiver_call: both peers desktop (Windows). Same proof lines.",
  "run (mini): bash scripts/pc_sync.sh t14-vol; pwsh -NoProfile -File scripts/fleet.ps1 -Scenario vol_receiver_call_desktop -Peers a=windows:i,b=windows:j"
 ],
 "peers": [
  "a",
  "b"
 ],
 "steps": [
  {
   "peer": "all",
   "op": "wait_for",
   "provider": "connection",
   "equals": "connected",
   "timeout_ms": 120000
  },
  {
   "peer": "a",
   "op": "capture",
   "from": "provider",
   "key": "peerId",
   "as": "PEER_A"
  },
  {
   "peer": "b",
   "op": "capture",
   "from": "provider",
   "key": "peerId",
   "as": "PEER_B"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Add friend",
   "index": 0
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "type:_FriendsManager > text:Add friend",
   "index": 0
  },
  {
   "peer": "b",
   "op": "enter_text",
   "target": "hint:Paste an ID, or type a nickname",
   "value": "${PEER_A}"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "text:Send request",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "text:Needs Attention",
   "timeout_ms": 60000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "text:Accept",
   "index": 0
  },
  {
   "peer": "b",
   "op": "wait_for",
   "target": "text:probe-a",
   "timeout_ms": 60000
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "type:_FriendsManager > semantics:Close",
   "index": 0
  },
  {
   "peer": "b",
   "op": "wait_for",
   "gone": "type:_FriendsManager",
   "timeout_ms": 10000
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:probe-a"
  },
  {
   "peer": "b",
   "op": "wait",
   "ms": 1500
  },
  {
   "peer": "b",
   "op": "log",
   "message": "b calls a from the open DM; a answers"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Start voice call",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "text:Accept",
   "timeout_ms": 45000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "text:Accept",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "active",
   "timeout_ms": 45000
  },
  {
   "peer": "b",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "active",
   "timeout_ms": 45000
  },
  {
   "peer": "all",
   "op": "wait",
   "ms": 8000,
   "why": "Media flows and both sides hold their receivers."
  },
  {
   "peer": "all",
   "op": "shot",
   "name": "volc-01-in-call"
  },
  {
   "peer": "a",
   "op": "log",
   "message": "PROOF deafen on desktop: deafen then undeafen"
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "semantics:Deafen",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "semantics:Undeafen",
   "timeout_ms": 10000
  },
  {
   "peer": "a",
   "op": "wait",
   "ms": 1500
  },
  {
   "peer": "a",
   "op": "shot",
   "name": "volc-02-a-deafened"
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "semantics:Undeafen",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "semantics:Deafen",
   "timeout_ms": 10000
  },
  {
   "peer": "b",
   "op": "log",
   "message": "PROOF deafen on b: deafen then undeafen"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Deafen",
   "index": 0
  },
  {
   "peer": "b",
   "op": "wait_for",
   "target": "semantics:Undeafen",
   "timeout_ms": 10000
  },
  {
   "peer": "b",
   "op": "wait",
   "ms": 1500
  },
  {
   "peer": "b",
   "op": "shot",
   "name": "volc-03-b-deafened"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Undeafen",
   "index": 0
  },
  {
   "peer": "b",
   "op": "wait_for",
   "target": "semantics:Deafen",
   "timeout_ms": 10000
  },
  {
   "peer": "all",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "active",
   "timeout_ms": 2000
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Leave the call",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "idle",
   "timeout_ms": 30000
  },
  {
   "peer": "b",
   "op": "wait_for",
   "provider": "callStatus",
   "equals": "idle",
   "timeout_ms": 30000
  },
  {
   "peer": "all",
   "op": "shot",
   "name": "volc-04-after"
  }
 ],
 "cleanup": [
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Leave the call",
   "index": 0,
   "soft": true
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "semantics:Leave the call",
   "index": 0,
   "soft": true
  }
 ]
}
