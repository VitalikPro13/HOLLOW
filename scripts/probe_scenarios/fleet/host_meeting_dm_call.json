{
  "_": [
    "A meeting's host starting or answering a DM call is asked first: end the",
    "meeting for everyone or keep it running and step out. a hosts, b is a's",
    "friend and the caller, c (a phone) is a guest in a's meeting. Starting: the",
    "question, Cancel, nothing changes (no call, still hosting). Answering: the",
    "question over the ringing card, Cancel keeps it ringing, Accept again and",
    "Keep it running: a steps out while c stays seated; the meeting screen offers",
    "Rejoin during the call and after it, never a spinner, and nothing rejoins",
    "by itself. Rejoin seats a with c again. Then answering once more with End",
    "for everyone ends the meeting for c too and the call comes up.",
    "",
    "run: FLEET_BACKEND=macos pwsh scripts/fleet.ps1 -Scenario host_meeting_dm_call -Peers a=e,b=windows:g,c=ios:g"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "semantics:probe-a" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "call you in a sec ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "semantics:probe-b", "timeout_ms": 60000 },
    { "peer": "a", "op": "log", "message": "a starts a meeting and hosts it" },
    { "peer": "a", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Create a room", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Create a room", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:e.g. Weekly sync", "value": "fleet-meet" },
    { "peer": "a", "op": "tap", "target": "dialog > type:HollowToggle", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:fleet-meet", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Start meeting", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Copy link", "index": 0 },
    { "peer": "a", "op": "capture", "from": "clipboard", "as": "LINK" },
    { "peer": "c", "op": "log", "message": "c joins a's meeting from the link on a phone" },
    { "peer": "c", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "c", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Join a meeting", "timeout_ms": 20000 },
    { "peer": "c", "op": "tap", "target": "semantics:Join a meeting", "index": 0 },
    { "peer": "c", "op": "enter_text", "target": "dialog > hint:Paste the meeting link", "value": "${LINK}" },
    { "peer": "c", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "c", "op": "wait_for", "provider": "meeting", "equals": "guest inCall", "timeout_ms": 90000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":2", "timeout_ms": 60000 },
    { "peer": "a", "op": "log", "message": "starting a call asks; Cancel changes nothing" },
    { "peer": "a", "op": "tap", "target": "semantics:Home", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait_for", "target": "text:call you in a sec ${RUN}", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:End the meeting too?", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "text:Calling takes you out of the meeting you're hosting. End it for everyone, or keep it running without you.", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "hm-01-host-asked-calling" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Cancel", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:End the meeting too?", "timeout_ms": 5000 },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 2000 },
    { "peer": "b", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 2000 },
    { "peer": "a", "op": "shot", "name": "hm-02-cancel-still-hosting" },
    { "peer": "a", "op": "log", "message": "answering asks; Cancel keeps it ringing; End for everyone ends the meeting" },
    { "peer": "b", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:End the meeting too?", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "text:Answering takes you out of the meeting you're hosting. End it for everyone, or keep it running without you.", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "hm-03-host-asked-answering" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Cancel", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:End the meeting too?", "timeout_ms": 5000 },
    { "peer": "a", "op": "wait_for", "provider": "callStatus", "equals": "ringing", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait_for", "target": "text:Accept", "timeout_ms": 2000 },
    { "peer": "a", "op": "shot", "name": "hm-04-cancel-still-ringing" },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:End the meeting too?", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Keep it running", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "callStatus", "matches": "^(connecting|active)$", "timeout_ms": 30000, "why": "The call went ahead. A macOS fleet peer has no microphone, so a call it is in stays connecting." },
    { "peer": "b", "op": "wait_for", "provider": "callStatus", "matches": "^(connecting|active)$", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host steppedOut", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "provider": "voiceRoom", "equals": "", "timeout_ms": 20000 },
    { "peer": "c", "op": "wait_for", "provider": "meeting", "equals": "guest inCall", "timeout_ms": 5000 },
    { "peer": "c", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":1", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Rejoin", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "hm-05-stepped-out-during-call" },
    { "peer": "a", "op": "log", "message": "the call ends; the meeting screen offers Rejoin and nothing rejoins by itself" },
    { "peer": "b", "op": "tap", "target": "semantics:Leave the call", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 3000 },
    { "peer": "a", "op": "wait_for", "target": "text:Rejoin", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host steppedOut", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait_for", "provider": "voiceRoom", "equals": "", "timeout_ms": 2000 },
    { "peer": "a", "op": "shot", "name": "hm-06-call-over-rejoin-offered" },
    { "peer": "a", "op": "dump", "name": "hm-06-call-over-rejoin-offered" },
    { "peer": "a", "op": "tap", "target": "text:Rejoin", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":2", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":2", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "shot", "name": "hm-07-rejoined-with-guest" },
    { "peer": "c", "op": "shot", "name": "hm-07-guest-sees-host-back" },
    { "peer": "a", "op": "log", "message": "answering once more: End for everyone ends the meeting for c too" },
    { "peer": "b", "op": "tap", "target": "semantics:probe-a" },
    { "peer": "b", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:End the meeting too?", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:End for everyone", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 20000 },
    { "peer": "c", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "provider": "callStatus", "matches": "^(connecting|active)$", "timeout_ms": 30000, "why": "The call went ahead. A macOS fleet peer has no microphone, so a call it is in stays connecting." },
    { "peer": "b", "op": "wait_for", "provider": "callStatus", "matches": "^(connecting|active)$", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait", "ms": 1500 },
    { "peer": "all", "op": "shot", "name": "hm-08-meeting-ended-call-up" },
    { "peer": "all", "op": "dump", "name": "hm-08-meeting-ended-call-up" },
    { "peer": "b", "op": "tap", "target": "semantics:Leave the call", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 }
  ]
}
