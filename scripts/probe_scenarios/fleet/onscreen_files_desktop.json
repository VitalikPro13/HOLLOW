{
  "_": [
    "Files posted in a channel not on screen keep only their card (t18-archive, 2026-11-19).",
    "a owns a server with #general and #second-RUN; b joins and keeps #general open. Phase 1:",
    "a posts a photo and a voice note in #second while b looks at #general. b's node must",
    "DECLINE both pushes (log: 'Auto-download gate declined pushed MLS file'), keeping no",
    "bytes. Phase 2: b opens #second; the viewport sweep pulls both within the limit, so the",
    "photo renders and the note offers Play. Phase 3: with #second on screen a posts again and",
    "both land by themselves (no decline line for them). Phase 4: b opens Settings over #second",
    "(Settings keeps the selection underneath); a posts a third photo; b's node declines it, and",
    "only when b closes Settings does the sweep pull it.",
    "Fixtures: run `python3 scripts/make_regress_fixtures.py` first (build/regress_fixtures,",
    "for 'Voice message.ogg', the name the composer sends with the voice flag).",
    "A throwaway server, deleted at the end.",
    "",
    "run (Mac mini): FLEET_BACKEND=macos pwsh scripts/fleet.ps1 -Scenario onscreen_files_desktop -Peers a,b -Relay hollowtest.duckdns.org"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Add a server", "timeout_ms": 10000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "ofs-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:ofs-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "ofs-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Create channel", "timeout_ms": 10000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "second-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:second-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:ofs-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 5000 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:ofs-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "ofs-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "channel:general", "timeout_ms": 60000 },
    { "peer": "b", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "b is here ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:b is here ${RUN}", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 8000, "why": "b's leaf and the group settle before the files" },

    { "peer": "a", "op": "log", "message": "PHASE 1: a posts a photo and a voice note in #second while b has #general on screen" },
    { "peer": "a", "op": "open_channel", "name": "second-${RUN}" },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "attach_file", "path": "${REPO}/scripts/probe_scenarios/fleet/image_check_fixtures/good_photo.webp" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "index": 0, "value": "unseen photo ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:unseen photo ${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "attach_file", "path": "${REPO}/build/regress_fixtures/Voice message.ogg" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait", "ms": 3000 },
    { "peer": "a", "op": "shot", "name": "ofs-a-01-posted-in-second" },
    { "peer": "b", "op": "wait", "ms": 15000, "why": "Absence proof: the pushes reach b's node while #general stays on screen" },
    { "peer": "b", "op": "expect_no_text", "value": "unseen photo ${RUN}" },
    { "peer": "b", "op": "shot", "name": "ofs-b-01-general-on-screen" },
    { "peer": "b", "op": "log", "message": "MARK-PHASE-1-END (b's log above this line must show the two declines)" },

    { "peer": "b", "op": "log", "message": "PHASE 2: b opens #second; the sweep pulls both" },
    { "peer": "b", "op": "open_channel", "name": "second-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "text:unseen photo ${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Play Voice message.ogg", "timeout_ms": 60000, "soft": true },
    { "peer": "b", "op": "wait", "ms": 5000 },
    { "peer": "b", "op": "shot", "name": "ofs-b-02-second-opened" },

    { "peer": "a", "op": "log", "message": "PHASE 3: with #second on screen on b, a posts again" },
    { "peer": "a", "op": "attach_file", "path": "${REPO}/scripts/probe_scenarios/fleet/image_check_fixtures/good_anim.webp" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "index": 0, "value": "seen photo ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "text:seen photo ${RUN}", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait", "ms": 8000 },
    { "peer": "b", "op": "shot", "name": "ofs-b-03-seen-photo" },

    { "peer": "b", "op": "log", "message": "PHASE 4: b opens Settings over #second (the selection stays underneath); a posts a third photo" },
    { "peer": "b", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 2000 },
    { "peer": "b", "op": "shot", "name": "ofs-b-04-settings-open" },
    { "peer": "a", "op": "attach_file", "path": "${REPO}/scripts/probe_scenarios/fleet/image_check_fixtures/good_photo.webp" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "index": 0, "value": "covered photo ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:covered photo ${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait", "ms": 15000, "why": "Absence proof: the push reaches b's node while Settings covers #second" },
    { "peer": "b", "op": "log", "message": "MARK-PHASE-4-SETTINGS-CLOSING (no File completed for the covered photo above this line)" },
    { "peer": "b", "op": "key", "value": "escape" },
    { "peer": "b", "op": "wait_for", "target": "text:covered photo ${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait", "ms": 8000 },
    { "peer": "b", "op": "shot", "name": "ofs-b-05-settings-closed" }
  ],
  "cleanup": [
    { "peer": "a", "op": "key", "value": "escape", "soft": true },
    { "peer": "a", "op": "right_click", "target": "server:ofs-${RUN}", "soft": true },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "text:Overview", "index": 0, "soft": true },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "gone": "server:ofs-${RUN}", "timeout_ms": 30000, "soft": true }
  ]
}
