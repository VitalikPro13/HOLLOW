{
  "_": [
    "Apple 1.2 proof on desktop: Report on others' messages (DM + channel), Block in the same flow,",
    "the blocked person's channel posts and DM leave the view at once.",
    "run: FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario apple_ugc_desktop -Peers a=r,b=s"
  ],
  "peers": [
    "a",
    "b"
  ],
  "steps": [
    {
      "peer": "all",
      "op": "wait_for",
      "provider": "connection",
      "equals": "connected",
      "timeout_ms": 120000
    },
    {
      "peer": "a",
      "op": "capture",
      "from": "provider",
      "key": "peerId",
      "as": "PEER_A"
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "semantics:Add friend",
      "index": 0
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "type:_FriendsManager > text:Add friend",
      "index": 0
    },
    {
      "peer": "b",
      "op": "enter_text",
      "target": "hint:Paste an ID, or type a nickname",
      "value": "${PEER_A}"
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "text:Send request",
      "index": 0
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Add friend",
      "index": 0
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "text:Requests",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "semantics:Accept friend request",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Accept friend request",
      "index": 0
    },
    {
      "peer": "a",
      "op": "log",
      "message": "the accepted friend must reach the UI on BOTH sides, not just the friends table"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "text:probe-b",
      "timeout_ms": 60000
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:probe-a",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "type:_FriendsManager > semantics:Close",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "gone": "type:_FriendsManager",
      "timeout_ms": 10000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:probe-b"
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 1500
    },
    {
      "peer": "a",
      "op": "enter_text",
      "target": "field",
      "value": "dm from a ${RUN}"
    },
    {
      "peer": "a",
      "op": "key",
      "value": "enter"
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:dm from a ${RUN}",
      "timeout_ms": 60000
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "type:_FriendsManager > semantics:Close",
      "index": 0
    },
    {
      "peer": "b",
      "op": "wait_for",
      "gone": "type:_FriendsManager",
      "timeout_ms": 10000
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "semantics:probe-a"
    },
    {
      "peer": "b",
      "op": "wait",
      "ms": 1500
    },
    {
      "peer": "b",
      "op": "enter_text",
      "target": "field",
      "value": "dm from b ${RUN}"
    },
    {
      "peer": "b",
      "op": "key",
      "value": "enter"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "text:dm from b ${RUN}",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "log",
      "message": "one row per message: the optimistic write and the one that arrives must reconcile"
    },
    {
      "peer": "a",
      "op": "expect_count",
      "target": "text:dm from a ${RUN}",
      "value": 1
    },
    {
      "peer": "b",
      "op": "expect_count",
      "target": "text:dm from b ${RUN}",
      "value": 1
    },
    {
      "peer": "a",
      "op": "log",
      "message": "Apple 1.2: Report on b's DM, right-click menu"
    },
    {
      "peer": "a",
      "op": "right_click",
      "target": "text:dm from b ${RUN}"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "menu > text:Report message",
      "timeout_ms": 5000
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-01-dm-menu"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "menu > text:Report message",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "dialog > text:Report message",
      "timeout_ms": 5000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Harassment",
      "index": 0
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-02-report-dialog"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Report",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "dialog > text:Report sent",
      "timeout_ms": 10000
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-03-offer-block"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Not now",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "gone": "dialog",
      "timeout_ms": 5000
    },
    {
      "peer": "a",
      "op": "log",
      "message": "no Report on our own message"
    },
    {
      "peer": "a",
      "op": "right_click",
      "target": "text:dm from a ${RUN}"
    },
    {
      "peer": "a",
      "op": "expect_no_text",
      "value": "Report message"
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-04-own-menu"
    },
    {
      "peer": "a",
      "op": "key",
      "value": "escape"
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "log",
      "message": "channel: a makes a server, b joins and posts"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Create a server"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "dialog > text:Add a server",
      "timeout_ms": 10000
    },
    {
      "peer": "a",
      "op": "enter_text",
      "target": "hint:My Awesome Server",
      "value": "ugc-${RUN}"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Create",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "server:ugc-${RUN}",
      "timeout_ms": 30000
    },
    {
      "peer": "a",
      "op": "open_server",
      "name": "ugc-${RUN}"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "channel:general",
      "timeout_ms": 30000
    },
    {
      "peer": "a",
      "op": "right_click",
      "target": "server:ugc-${RUN}"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "menu > text:Invite people"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "type:HollowCopyField",
      "timeout_ms": 20000
    },
    {
      "peer": "a",
      "op": "capture",
      "target": "type:HollowCopyField",
      "as": "INVITE"
    },
    {
      "peer": "a",
      "op": "key",
      "value": "escape"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "gone": "dialog",
      "timeout_ms": 5000
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "semantics:Create a server"
    },
    {
      "peer": "b",
      "op": "enter_text",
      "target": "hint:Invite link",
      "value": "${INVITE}"
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "dialog > text:Join",
      "index": 0
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "server:ugc-${RUN}",
      "timeout_ms": 90000
    },
    {
      "peer": "b",
      "op": "open_server",
      "name": "ugc-${RUN}"
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "channel:general",
      "timeout_ms": 60000
    },
    {
      "peer": "b",
      "op": "open_channel",
      "name": "general"
    },
    {
      "peer": "a",
      "op": "open_channel",
      "name": "general"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "key:member:${PEER_B}",
      "timeout_ms": 60000,
      "soft": true
    },
    {
      "peer": "b",
      "op": "wait",
      "ms": 2000
    },
    {
      "peer": "b",
      "op": "enter_text",
      "target": "field",
      "value": "channel post from b ${RUN}"
    },
    {
      "peer": "b",
      "op": "key",
      "value": "enter"
    },
    {
      "peer": "a",
      "op": "enter_text",
      "target": "field",
      "value": "channel post from a ${RUN}"
    },
    {
      "peer": "a",
      "op": "key",
      "value": "enter"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "text:channel post from b ${RUN}",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-05-channel-before-block"
    },
    {
      "peer": "a",
      "op": "right_click",
      "target": "text:channel post from b ${RUN}"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "menu > text:Report message",
      "timeout_ms": 5000
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-06-channel-menu"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "menu > text:Report message",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "dialog > text:Report message",
      "timeout_ms": 5000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Spam",
      "index": 0
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Report",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "dialog > text:Report sent",
      "timeout_ms": 10000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "dialog > text:Block",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "gone": "dialog",
      "timeout_ms": 10000
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "expect_no_text",
      "value": "channel post from b ${RUN}"
    },
    {
      "peer": "a",
      "op": "expect_text",
      "value": "channel post from a ${RUN}"
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-07-channel-after-block"
    },
    {
      "peer": "a",
      "op": "log",
      "message": "the DM with b leaves every list at once; the DM pane shows the notice"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Home",
      "index": 0,
      "soft": true
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 1500
    },
    {
      "peer": "a",
      "op": "expect_no_text",
      "value": "probe-b"
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ugc-d-08-home-after-block"
    },
    {
      "peer": "all",
      "op": "dump",
      "name": "ugc-done"
    }
  ],
  "cleanup": [
    {
      "peer": "a",
      "op": "log",
      "message": "every run restores the fixture data directories; the server only lives in these two fixtures"
    }
  ]
}