{
  "_": [
    "The mobile half of design sweep 8, the dialog pass: the New conversation",
    "dialog, then from three throwaway servers' long-press sheets Create",
    "channel, Invite and the Delete server confirm, dark and light. One server",
    "per sheet: in the simulator a second long-press on a row whose sheet was",
    "dismissed opens nothing (unverified on a device).",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario design_sweep8_mobile -Peers a"
  ],
  "peers": ["a"],
  "steps": [
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "m8-01-new-conversation" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "alpha" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:alpha", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "bravo" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:bravo", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "charlie" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:charlie", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "long_press", "target": "text:alpha", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Create channel", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "m8-02-create-channel", "soft": true },
    { "peer": "a", "op": "tap", "target": "text:Cancel", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "long_press", "target": "text:bravo", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Invite", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "m8-03-invite", "soft": true },
    { "peer": "a", "op": "tap_at", "x": 200, "y": 60, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "long_press", "target": "text:charlie", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "m8-04-delete-server", "soft": true },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "m8-05-delete-server-light", "soft": true },
    { "peer": "a", "op": "theme", "value": "dark" }
  ]
}
