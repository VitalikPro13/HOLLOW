{
  "_": [
    "The mobile half of design sweep 3c: section headers and the tracked-caps",
    "eyebrows, now HollowSectionHeader. Friends groups, Settings pages, the",
    "server settings route and the member sheet.",
    "",
    "Run it on the unswept commit first, then with the sweep applied, and stack",
    "the pairs. One peer; it creates a throwaway server.",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario design_sweep3c_mobile -Peers a"
  ],
  "peers": ["a"],
  "steps": [
    { "peer": "a", "op": "tap", "target": "semantics:Friends", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-01-friends" },

    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-02-settings" },
    { "peer": "a", "op": "tap", "target": "text:Appearance", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-03-appearance" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Security", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-04-security" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:About", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-05-about", "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },

    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-06-new-conversation" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "sweep3c" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:sweep3c", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "long_press", "target": "text:sweep3c", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Server settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-07-server-settings" },
    { "peer": "a", "op": "scroll", "target": "text:Description", "index": 0, "dy": -700, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "mobile-3c-08-server-settings-2" }
  ]
}
