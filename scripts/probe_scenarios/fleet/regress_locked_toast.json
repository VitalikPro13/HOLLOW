{
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "type:_FriendsManager", "timeout_ms": 15000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "wait_for", "target": "type:_FriendsManager > text:${PEER_A}", "timeout_ms": 5000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Send request", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Requests", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager > semantics:Accept friend request", "timeout_ms": 90000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > semantics:Accept friend request", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Friends", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager > text:probe-b", "timeout_ms": 90000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Friends", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "type:_FriendsManager > text:probe-a", "timeout_ms": 90000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendChip > semantics:probe-a", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "b", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "before the lock ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "text:before the lock ${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendChip", "timeout_ms": 60000 },

    { "peer": "a", "op": "log", "message": "a sets an app password and locks" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set password", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Set password", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Set app password", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > type:TextField", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 0, "value": "probe-lock-1" },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 1, "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Set password", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Lock now", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Lock now", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:LockCoverScreen", "timeout_ms": 10000 },
    { "peer": "a", "op": "log", "message": "LOCKED-MARK ${RUN}" },

    { "peer": "b", "op": "log", "message": "b writes while a is locked: a may show only the neutral toast" },
    { "peer": "b", "op": "tap", "target": "type:ChatComposerRow > type:EditableText" },
    { "peer": "b", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "value": "secret while locked ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "text:secret while locked ${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 12000 },
    { "peer": "a", "op": "expect_no_text", "value": "secret while locked ${RUN}" },
    { "peer": "a", "op": "expect_count", "target": "type:HollowShell", "value": 0 },
    { "peer": "a", "op": "shot", "name": "lt-01-locked-after-dm" },

    { "peer": "a", "op": "log", "message": "unlock: the message is there; then the password goes off again" },
    { "peer": "a", "op": "wait_for", "target": "dialog > hint:Password", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "dialog > hint:Password", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Password", "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Unlock", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:LockCoverScreen", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Turn off", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Turn off the password", "timeout_ms": 10000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Turn off", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set password", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "semantics:Close settings", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:_FriendChip > semantics:probe-b", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:secret while locked ${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "shot", "name": "lt-02-unlocked" }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "dialog > hint:Password", "index": 0, "soft": true },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Password", "value": "probe-lock-1", "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:Unlock", "index": 0, "soft": true }
  ]
}
