{
  "_": [
    "The member panel pass and the resizable call side panel (2026-09-26).",
    "a makes a server with a voice room, b joins: the member panel (Owner,",
    "Online), a group folded and unfolded, light theme; then both in the voice",
    "room, the chat seam dragged wide and to the minimum, and a small window",
    "where the panel yields to the stage. A throwaway server, deleted at the end.",
    "",
    "run: powershell -File scripts\\fleet.ps1 -Scenario member_panel_pass -Peers a,b -Attach"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "fleet-members" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:fleet-members", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "fleet-members" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "lounge" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:lounge", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:fleet-members" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:fleet-members", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "fleet-members" },
    { "peer": "b", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },

    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "b", "op": "open_channel", "name": "general" },
    { "peer": "all", "op": "wait", "ms": 6000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "m-01-members" },
    { "peer": "a", "op": "dump", "name": "m-01-members" },

    { "peer": "a", "op": "tap", "target": "semantics:Collapse Online, 1 members", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "m-02-folded" },
    { "peer": "a", "op": "tap", "target": "semantics:Expand Online, 1 members", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 600 },

    { "peer": "a", "op": "theme", "value": "light", "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "m-03-light" },
    { "peer": "a", "op": "theme", "value": "dark", "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "open_channel", "name": "lounge" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_channel", "name": "lounge" },
    { "peer": "b", "op": "open_channel", "name": "lounge" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "open_channel", "name": "lounge" },
    { "peer": "all", "op": "wait", "ms": 6000 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "v-01-default" },

    { "peer": "a", "op": "scroll", "target": "semantics:Resize the side panel", "dx": -220, "dy": 0, "soft": true },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "v-02-wide" },
    { "peer": "a", "op": "scroll", "target": "semantics:Resize the side panel", "dx": 500, "dy": 0, "soft": true },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "v-03-min" },
    { "peer": "a", "op": "scroll", "target": "semantics:Resize the side panel", "dx": -500, "dy": 0, "soft": true },
    { "peer": "a", "op": "view", "width": 1000, "height": 720 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "v-04-small-window" },
    { "peer": "a", "op": "view", "reset": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "v-05-restored" }
  ],
  "cleanup": [
    { "peer": "a", "op": "view", "reset": true },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the room", "index": 0, "allowMiss": true },
    { "peer": "b", "op": "tap", "target": "semantics:Leave the room", "index": 0, "allowMiss": true },
    { "peer": "a", "op": "right_click", "target": "server:fleet-members" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:fleet-members", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:fleet-members", "timeout_ms": 90000 }
  ]
}
