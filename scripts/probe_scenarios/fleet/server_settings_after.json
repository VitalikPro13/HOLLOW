{
 "_": [
  "Server settings as a place: every rail page as the owner (a) and the member view (b), on throwaway peers.",
  "Also: a channel opened, the staged channel list bar, the unsaved text bar, light, 150% zoom, a wide window, the delete confirm.",
  "a creates the server, b joins by invite; cleanup deletes it from Overview's Danger zone.",
  "run: powershell -File scripts\\fleet.ps1 -Scenario server_settings_after -Peers a,b"
 ],
 "peers": ["a", "b"],
 "steps": [
  {"peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000},
  {"peer": "all", "op": "wait", "ms": 2000},
  {"peer": "a", "op": "tap", "target": "semantics:Create a server"},
  {"peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "ss-after"},
  {"peer": "a", "op": "tap", "target": "text:Create", "index": 0},
  {"peer": "a", "op": "wait_for", "target": "server:ss-after", "timeout_ms": 30000},
  {"peer": "a", "op": "right_click", "target": "server:ss-after"},
  {"peer": "a", "op": "tap", "target": "menu > text:Invite people"},
  {"peer": "a", "op": "wait_for", "target": "type:SelectableText", "timeout_ms": 20000},
  {"peer": "a", "op": "capture", "target": "type:SelectableText", "as": "INVITE"},
  {"peer": "a", "op": "key", "value": "escape"},
  {"peer": "b", "op": "tap", "target": "semantics:Create a server"},
  {"peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}"},
  {"peer": "b", "op": "tap", "target": "text:Join", "index": 0},
  {"peer": "b", "op": "wait_for", "target": "server:ss-after", "timeout_ms": 90000},
  {"peer": "b", "op": "open_server", "name": "ss-after"},
  {"peer": "b", "op": "wait", "ms": 3000},

  {"peer": "a", "op": "open_server", "name": "ss-after"},
  {"peer": "a", "op": "wait", "ms": 1500},
  {"peer": "a", "op": "tap", "target": "semantics:Server settings", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1500},
  {"peer": "a", "op": "shot", "name": "ssa-01-overview"},
  {"peer": "a", "op": "enter_text", "target": "hint:What is this server about?", "value": "Patches, jams and the occasional soldering disaster."},
  {"peer": "a", "op": "wait", "ms": 600},
  {"peer": "a", "op": "shot", "name": "ssa-02-overview-unsaved"},
  {"peer": "a", "op": "tap", "target": "text:Save", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1500},
  {"peer": "a", "op": "tap", "target": "semantics:Show advanced settings", "soft": true},
  {"peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0},
  {"peer": "a", "op": "wait", "ms": 600},
  {"peer": "a", "op": "shot", "name": "ssa-03-overview-end"},
  {"peer": "a", "op": "tap", "target": "text:Delete server", "index": 0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "shot", "name": "ssa-04-delete-confirm"},
  {"peer": "a", "op": "tap", "target": "dialog > text:Cancel", "index": 0},
  {"peer": "a", "op": "wait", "ms": 600},

  {"peer": "a", "op": "tap", "target": "text:Access", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-05-access"},

  {"peer": "a", "op": "tap", "target": "text:Channels", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-06-channels"},
  {"peer": "a", "op": "tap", "target": "text:general", "index": 0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "shot", "name": "ssa-07-channel-open"},
  {"peer": "a", "op": "tap", "target": "semantics:Media only", "index": 0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "tap", "target": "contains:general", "index": 0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "shot", "name": "ssa-07b-channel-summary"},
  {"peer": "a", "op": "tap", "target": "text:New category", "index": 0},
  {"peer": "a", "op": "wait", "ms": 600},
  {"peer": "a", "op": "enter_text", "target": "hint:Category name", "value": "Studio"},
  {"peer": "a", "op": "tap", "target": "dialog > text:Add", "index": 0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "shot", "name": "ssa-08-channels-staged"},
  {"peer": "a", "op": "tap", "target": "text:Discard", "index": 0},
  {"peer": "a", "op": "wait", "ms": 600},

  {"peer": "a", "op": "tap", "target": "text:Roles", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-09-roles"},
  {"peer": "a", "op": "theme", "value": "light"},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "shot", "name": "ssa-10-roles-light"},
  {"peer": "a", "op": "theme", "value": "dark"},
  {"peer": "a", "op": "wait", "ms": 600},

  {"peer": "a", "op": "tap", "target": "text:Labels", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-11-labels"},
  {"peer": "a", "op": "tap", "target": "text:Emotes and stickers", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-12-emotes"},
  {"peer": "a", "op": "tap", "target": "text:Members", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1500},
  {"peer": "a", "op": "shot", "name": "ssa-13-members"},
  {"peer": "a", "op": "tap", "target": "text:Profile", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-14-profile"},
  {"peer": "a", "op": "tap", "target": "text:Notifications", "index": 0},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-15-notifications"},

  {"peer": "a", "op": "tap", "target": "text:Overview", "index": 0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "zoom", "value": 1.5},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-16-overview-150"},
  {"peer": "a", "op": "zoom", "value": 0.67},
  {"peer": "a", "op": "wait", "ms": 1200},
  {"peer": "a", "op": "shot", "name": "ssa-17-overview-wide"},
  {"peer": "a", "op": "zoom", "value": 1.0},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "key", "value": "escape"},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "shot", "name": "ssa-18-closed"},

  {"peer": "b", "op": "right_click", "target": "server:ss-after"},
  {"peer": "b", "op": "tap", "target": "menu > text:Server settings"},
  {"peer": "b", "op": "wait", "ms": 1500},
  {"peer": "b", "op": "shot", "name": "ssa-20-member-profile"},
  {"peer": "b", "op": "tap", "target": "text:Members", "index": 0},
  {"peer": "b", "op": "wait", "ms": 1200},
  {"peer": "b", "op": "shot", "name": "ssa-21-member-members"},
  {"peer": "b", "op": "tap", "target": "text:Notifications", "index": 0},
  {"peer": "b", "op": "wait", "ms": 1000},
  {"peer": "b", "op": "shot", "name": "ssa-22-member-notifications"},
  {"peer": "b", "op": "key", "value": "escape"}
 ],
 "cleanup": [
  {"peer": "a", "op": "key", "value": "escape"},
  {"peer": "a", "op": "right_click", "target": "server:ss-after"},
  {"peer": "a", "op": "tap", "target": "menu > text:Server settings"},
  {"peer": "a", "op": "wait", "ms": 800},
  {"peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0},
  {"peer": "a", "op": "tap", "target": "text:Delete server", "index": 0},
  {"peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0},
  {"peer": "a", "op": "wait_for", "gone": "server:ss-after", "timeout_ms": 30000},
  {"peer": "b", "op": "wait_for", "gone": "server:ss-after", "timeout_ms": 90000}
 ]
}
