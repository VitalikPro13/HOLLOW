{
  "_": [
    "Regression pass, the desktop App lock on ONE throwaway peer (a). Settings > Security >",
    "App lock: Set password (typed twice), which also brings the 'Lock after' row with",
    "Lock now and the 'Ask before Hollow starts' switch, which must stay OFF (the app lock",
    "is then the only prompt). Lock now raises the cover with no restart: the cover and",
    "the 'Unlock Hollow' prompt are on stage and the shell under them is not (an opaque",
    "route takes the shell offstage, where no finder sees it); Escape does not lift it.",
    "The password lifts it and the shell is back. Locked again, a wrong password is",
    "refused on the field and the shell stays hidden. Then a duress code is SET, with the",
    "'This device and unlink it' scope, and only shown to have saved: it is never typed at",
    "the prompt, which would wipe this identity. The probe cannot read a switch's value, so",
    "the OFF switch is proven by the absence of the note a wider-scope code would get if",
    "Hollow asked before it starts ('A duress code typed at that prompt destroys this",
    "computer only.'). The duress code is removed, the password turned off, and the shell",
    "must no longer lock or offer to. The shortcut (Ctrl+Shift+L) is not drivable: the",
    "key op sends single keys only.",
    "",
    "PRECONDITION on Windows: flutter_secure_storage keeps the launch secret in",
    "%APPDATA%\\com.anonlisten\\hollow\\flutter_secure_storage.dat, ONE file for every",
    "Hollow exe on this Windows account, the fleet copies AND an installed Hollow. Setting",
    "the password writes this peer's secret there and turning it off deletes it, so an",
    "installed Hollow with its own app lock loses its silent start. Copy that file aside",
    "before the run and put it back after, or run on a machine with no real Hollow.",
    "Setting the password also rewrites the legacy machine-wide Credential Manager slot",
    "com.hollow.identity.wrapping_key (per-profile slots are untouched).",
    "",
    "run: powershell -File scripts/fleet.ps1 -Scenario regress_app_lock -Peers a"
  ],
  "peers": ["a"],
  "steps": [
    { "peer": "a", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0 },
    { "peer": "a", "op": "log", "message": "a fixture with a password already set stops the run here, before anything changes" },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set password", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs a password first", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "lock-01-none" },

    { "peer": "a", "op": "log", "message": "turn the app lock on: Set password, the password twice" },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Set password", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Set app password", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > type:TextField", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 0, "value": "probe-lock-1" },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 1, "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Set password", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Lock now", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Ask before Hollow starts", "timeout_ms": 5000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "lock-02-on" },

    { "peer": "a", "op": "log", "message": "Lock now: the cover and the prompt, and nothing of the shell under them" },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Lock now", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:LockCoverScreen", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "text:Hollow is locked", "timeout_ms": 5000 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Unlock Hollow", "timeout_ms": 15000 },
    { "peer": "a", "op": "expect_count", "target": "type:HollowShell", "value": 0 },
    { "peer": "a", "op": "expect_count", "target": "type:SettingsPlace", "value": 0 },
    { "peer": "a", "op": "expect_count", "target": "semantics:Create a server", "value": 0 },
    { "peer": "a", "op": "shot", "name": "lock-03-locked" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "wait_for", "target": "type:LockCoverScreen", "timeout_ms": 2000 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Unlock Hollow", "timeout_ms": 10000 },
    { "peer": "a", "op": "expect_count", "target": "type:SettingsPlace", "value": 0 },

    { "peer": "a", "op": "tap", "target": "dialog > hint:Password", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Password", "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Unlock", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:LockCoverScreen", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Create a server", "timeout_ms": 10000 },
    { "peer": "a", "op": "expect_count", "target": "dialog", "value": 0 },
    { "peer": "a", "op": "shot", "name": "lock-04-unlocked" },

    { "peer": "a", "op": "log", "message": "locked again: a wrong password is refused and the shell stays hidden" },
    { "peer": "a", "op": "reveal", "target": "type:SettingsPlace > text:Lock now" },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Lock now", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:LockCoverScreen", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait_for", "target": "dialog > hint:Password", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "dialog > hint:Password", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Password", "value": "not-the-password-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Unlock", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Wrong password. Try again.", "timeout_ms": 60000 },
    { "peer": "a", "op": "expect_count", "target": "type:LockCoverScreen", "value": 1 },
    { "peer": "a", "op": "expect_count", "target": "type:HollowShell", "value": 0 },
    { "peer": "a", "op": "expect_count", "target": "type:SettingsPlace", "value": 0 },
    { "peer": "a", "op": "shot", "name": "lock-05-wrong-refused" },
    { "peer": "a", "op": "tap", "target": "dialog > hint:Password", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Password", "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Unlock", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:LockCoverScreen", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 10000 },

    { "peer": "a", "op": "log", "message": "duress: set and shown saved, NEVER typed at the prompt (that wipes this identity)" },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set up", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Set up", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Set a duress code", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > type:TextField", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 0, "value": "probe-lock-1" },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 1, "value": "probe-duress-1" },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "index": 2, "value": "probe-duress-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:This device and unlink it", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Set code", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "text:Deletes this device's data and unlinks it from your identity.", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Remove", "timeout_ms": 5000 },
    { "peer": "a", "op": "log", "message": "Ask before Hollow starts is OFF: with it on, a wider-scope code gets a 'this computer only' note" },
    { "peer": "a", "op": "expect_no_text", "value": "A duress code typed at that prompt destroys this computer only." },
    { "peer": "a", "op": "shot", "name": "lock-06-duress-saved" },

    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Remove", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Remove duress code", "timeout_ms": 10000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:App password", "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Remove", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set up", "timeout_ms": 15000 },

    { "peer": "a", "op": "log", "message": "the password off again: no Lock now, the duress row back to needing one, and no lock" },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Turn off", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Turn off the password", "timeout_ms": 10000 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "probe-lock-1" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Turn off", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set password", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "gone": "text:Lock now", "timeout_ms": 5000 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs a password first", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "lock-07-off" },
    { "peer": "a", "op": "tap", "target": "semantics:Close settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:SettingsPlace", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait", "ms": 5000 },
    { "peer": "a", "op": "expect_count", "target": "type:LockCoverScreen", "value": 0 },
    { "peer": "a", "op": "expect_count", "target": "dialog", "value": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Create a server", "timeout_ms": 5000 },
    { "peer": "a", "op": "dump", "name": "lock-final" }
  ],
  "cleanup": [
    { "peer": "a", "op": "log", "message": "best effort back to no password, whatever step failed; the next boot restores the fixture anyway" },
    { "peer": "a", "op": "tap", "target": "dialog > hint:Password", "index": 0, "soft": true },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:Password", "value": "probe-lock-1", "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:Unlock", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "gone": "type:LockCoverScreen", "timeout_ms": 60000, "soft": true },
    { "peer": "a", "op": "key", "value": "escape", "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Close settings", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Remove", "index": 0, "soft": true },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:App password", "value": "probe-lock-1", "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:Remove", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 60000, "soft": true },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Turn off", "index": 0, "soft": true },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "probe-lock-1", "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:Turn off", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace > text:Set password", "timeout_ms": 60000, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Close settings", "index": 0, "soft": true }
  ]
}
