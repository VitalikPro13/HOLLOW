{
  "_": [
    "The mobile Chats tab BEFORE the Home redesign reached it: first run, a",
    "pending friend request, then a DM and a server with a mention. The same",
    "journey as home_mobile.json, answering the request from the Friends tab",
    "because the old Chats tab has no Needs Attention strip.",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario home_mobile_before -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "all", "op": "wait", "ms": 3000 },
    { "peer": "a", "op": "shot", "name": "mb-01-first-run" },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },

    { "peer": "b", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "wait_for", "target": "text:${PEER_A}", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },

    { "peer": "a", "op": "wait_for", "target": "semantics:Accept friend request", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mb-02-request" },
    { "peer": "a", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Accept friend request", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0 },

    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "text:probe-a" },
    { "peer": "b", "op": "wait_for", "target": "hint:Type a message...", "timeout_ms": 15000 },
    { "peer": "b", "op": "tap", "target": "hint:Type a message...", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Type a message...", "value": "sent you the stems ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:sent you the stems ${RUN}", "timeout_ms": 60000 },

    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "home-m" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:home-m", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "long_press", "target": "text:home-m", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Invite", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SelectableText", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:SelectableText", "as": "INVITE" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },

    { "peer": "b", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:home-m", "timeout_ms": 90000 },
    { "peer": "b", "op": "wait", "ms": 3000 },
    { "peer": "b", "op": "tap", "target": "text:home-m", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:general", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:general", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "hint:Type a message...", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait", "ms": 3000 },
    { "peer": "b", "op": "tap", "target": "hint:Type a message...", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Type a message...", "value": "@probe-a can you check the relay logs ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send", "index": 0 },

    { "peer": "a", "op": "wait", "ms": 6000 },
    { "peer": "a", "op": "shot", "name": "mb-03-populated" },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "mb-04-populated-light" },
    { "peer": "a", "op": "theme", "value": "dark" }
  ]
}
