{
  "_": [
    "t14-reset: the owner resets the server's invite link from Access. The old link is",
    "refused with the reset copy (never admitted), the Invite people dialog shows the new",
    "link, and the new link joins (the server and its channels reach the joiner).",
    "",
    "run (Mac lead, 0.14 test relay): FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario t14_reset_invite -Peers m=windows:m,n=windows:n"
  ],
  "peers": ["m", "n"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "m", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "m", "op": "enter_text", "target": "hint:My Awesome Server", "value": "t14-reset" },
    { "peer": "m", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "m", "op": "wait_for", "target": "server:t14-reset", "timeout_ms": 30000 },
    { "peer": "m", "op": "open_server", "name": "t14-reset" },
    { "peer": "m", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "m", "op": "right_click", "target": "server:t14-reset" },
    { "peer": "m", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "m", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "m", "op": "capture", "target": "type:HollowCopyField", "as": "OLD_INVITE" },
    { "peer": "m", "op": "shot", "name": "t14r-01-invite-before" },
    { "peer": "m", "op": "key", "value": "escape" },
    { "peer": "m", "op": "right_click", "target": "server:t14-reset" },
    { "peer": "m", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "m", "op": "tap", "target": "text:Access", "index": 0 },
    { "peer": "m", "op": "wait_for", "target": "text:Reset invite link", "timeout_ms": 15000 },
    { "peer": "m", "op": "shot", "name": "t14r-02-access-row" },
    { "peer": "m", "op": "theme", "value": "light" },
    { "peer": "m", "op": "wait", "ms": 600 },
    { "peer": "m", "op": "shot", "name": "t14r-02b-access-row-light" },
    { "peer": "m", "op": "theme", "value": "dark" },
    { "peer": "m", "op": "tap", "target": "text:Reset link", "index": 0 },
    { "peer": "m", "op": "wait_for", "target": "text:Reset the invite link?", "timeout_ms": 10000 },
    { "peer": "m", "op": "shot", "name": "t14r-03-confirm" },
    { "peer": "m", "op": "tap", "target": "dialog > text:Reset link", "index": 0 },
    { "peer": "m", "op": "wait_for", "gone": "text:Reset the invite link?", "timeout_ms": 15000 },
    { "peer": "m", "op": "wait_for", "target": "text:Invite link reset", "timeout_ms": 10000, "soft": true },
    { "peer": "m", "op": "shot", "name": "t14r-04-reset-done" },
    { "peer": "m", "op": "key", "value": "escape" },
    { "peer": "m", "op": "wait", "ms": 2000 },
    { "peer": "m", "op": "right_click", "target": "server:t14-reset" },
    { "peer": "m", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "m", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "m", "op": "capture", "target": "type:HollowCopyField", "as": "NEW_INVITE" },
    { "peer": "m", "op": "shot", "name": "t14r-05-invite-after" },
    { "peer": "m", "op": "key", "value": "escape" },
    { "peer": "n", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "n", "op": "enter_text", "target": "hint:Invite link", "value": "${OLD_INVITE}" },
    { "peer": "n", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "n", "op": "wait_for", "target": "text:This invite link was reset. Ask for a new one.", "timeout_ms": 90000 },
    { "peer": "n", "op": "shot", "name": "t14r-06-old-link-refused" },
    { "peer": "n", "op": "wait", "ms": 6000 },
    { "peer": "n", "op": "shot", "name": "t14r-07-old-link-tile" },
    { "peer": "n", "op": "dump", "name": "t14r-old-link" },
    { "peer": "n", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "n", "op": "enter_text", "target": "hint:Invite link", "value": "${NEW_INVITE}" },
    { "peer": "n", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "n", "op": "wait_for", "target": "server:t14-reset", "timeout_ms": 90000 },
    { "peer": "n", "op": "open_server", "name": "t14-reset" },
    { "peer": "n", "op": "open_channel", "name": "general" },
    { "peer": "n", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "all", "op": "shot", "name": "t14r-08-joined" },
    { "peer": "all", "op": "dump", "name": "t14r-converged" }
  ],
  "cleanup": [
    { "peer": "m", "op": "right_click", "target": "server:t14-reset" },
    { "peer": "m", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "m", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "m", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "m", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "m", "op": "wait_for", "gone": "server:t14-reset", "timeout_ms": 30000 },
    { "peer": "n", "op": "wait_for", "gone": "server:t14-reset", "timeout_ms": 90000 }
  ]
}
