{
  "_": [
    "Age-restricted servers (t14-agegate): c (macOS) owns a server with a public #general and flags it 18+;",
    "the Public switch goes off and says why. b (macOS) joins with the 18+ consent and is offered the phones' setting once,",
    "which its Network settings hold. a (iPhone, gate closed) joins by the same invite: the age-restricted message,",
    "never the consent, and no server in Chats; its Network settings say nothing about it. Needs FRESH identities.",
    "run: FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario agegate_mobile -Peers a=ios:<x>,b=<y>,c=<z>"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },

    { "peer": "c", "op": "log", "message": "PART 1: c makes the server, opens #general to guests, then flags it 18+" },
    { "peer": "c", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "c", "op": "wait_for", "target": "dialog > text:Add a server", "timeout_ms": 10000 },
    { "peer": "c", "op": "enter_text", "target": "hint:My Awesome Server", "value": "nsfwsrv-${RUN}" },
    { "peer": "c", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "server:nsfwsrv-${RUN}", "timeout_ms": 30000 },
    { "peer": "c", "op": "open_server", "name": "nsfwsrv-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "c", "op": "tap", "target": "semantics:Server settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Channels", "timeout_ms": 15000 },
    { "peer": "c", "op": "tap", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Channels", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:general. Open its settings", "timeout_ms": 10000 },
    { "peer": "c", "op": "tap", "target": "semantics:general. Open its settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:ServerSettingsPlace > semantics:Public", "timeout_ms": 5000 },
    { "peer": "c", "op": "tap", "target": "type:ServerSettingsPlace > semantics:Public", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:general, Public. Close its settings", "timeout_ms": 10000 },
    { "peer": "c", "op": "shot", "name": "ag-01-c-public-before" },
    { "peer": "c", "op": "tap", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Access", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Adult content", "timeout_ms": 10000 },
    { "peer": "c", "op": "tap", "target": "semantics:Adult content", "index": 0 },
    { "peer": "c", "op": "wait", "ms": 2000 },
    { "peer": "c", "op": "shot", "name": "ag-02-c-adult-on" },
    { "peer": "c", "op": "tap", "target": "type:ServerSettingsPlace > type:SettingsRailItem > text:Channels", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:general. Open its settings", "timeout_ms": 10000 },
    { "peer": "c", "op": "tap", "target": "semantics:general. Open its settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "text:Public channels are off for age-restricted servers", "timeout_ms": 15000 },
    { "peer": "c", "op": "shot", "name": "ag-03-c-public-off" },
    { "peer": "c", "op": "key", "value": "escape" },
    { "peer": "c", "op": "wait", "ms": 1000 },
    { "peer": "c", "op": "key", "value": "escape", "allowMiss": true },

    { "peer": "c", "op": "right_click", "target": "server:nsfwsrv-${RUN}" },
    { "peer": "c", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "c", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "c", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "c", "op": "key", "value": "escape" },

    { "peer": "b", "op": "log", "message": "PART 2: b (a computer) joins with consent and is offered the phones' setting once" },
    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Sensitive content warning", "timeout_ms": 90000 },
    { "peer": "b", "op": "shot", "name": "ag-04-b-consent" },
    { "peer": "b", "op": "tap", "target": "text:I am 18 or older, join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Show age-restricted servers on your phones?", "timeout_ms": 90000 },
    { "peer": "b", "op": "shot", "name": "ag-05-b-offer" },
    { "peer": "b", "op": "tap", "target": "text:Not now", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:nsfwsrv-${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:SettingsPlace > text:Network", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Allow age-restricted servers on my phones", "timeout_ms": 10000 },
    { "peer": "b", "op": "reveal", "target": "text:Allow age-restricted servers on my phones", "allowMiss": true },
    { "peer": "b", "op": "shot", "name": "ag-06-b-settings" },
    { "peer": "b", "op": "tap", "target": "semantics:Close settings", "index": 0, "allowMiss": true },

    { "peer": "a", "op": "log", "message": "PART 3: a (iPhone, gate closed) taps the same invite" },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "a", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Age-restricted server", "timeout_ms": 90000 },
    { "peer": "a", "op": "expect_no_text", "value": "Sensitive content warning" },
    { "peer": "a", "op": "shot", "name": "ag-07-a-blocked" },
    { "peer": "a", "op": "tap", "target": "semantics:Close", "index": 0, "allowMiss": true },
    { "peer": "a", "op": "wait", "ms": 3000 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "expect_no_text", "value": "nsfwsrv-${RUN}" },
    { "peer": "a", "op": "shot", "name": "ag-08-a-chats" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "text:Network", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:GIF rating", "timeout_ms": 10000 },
    { "peer": "a", "op": "expect_no_text", "value": "Age-restricted servers" },
    { "peer": "a", "op": "shot", "name": "ag-09-a-network" }
  ]
}
