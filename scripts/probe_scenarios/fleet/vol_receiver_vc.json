{
  "_": [
    "HOL-SEC-190: a received voice's volume is set by its connection and receiver, never a",
    "track id. a (desktop, a Windows peer) makes a server with a voice room, b (a phone, an",
    "Android emulator) joins it, both enter the room and mute. a turns b down from b's",
    "participant menu (the Volume slider, tapped at its left end), deafens, undeafens; b",
    "deafens and undeafens. Every one of those must leave a '[HOLLOW-VC] Volume' line in that",
    "peer's hollow_debug.log naming as many applied receivers as it found (n/n, n >= 1),",
    "with no 'receiver not found' and no 'setVolume skipped'.",
    "",
    "What the widgets cannot prove: what plays. The log lines prove the native lookup found",
    "the receivers on that platform; the unit tests prove which ones.",
    "",
    "run (mini): bash scripts/pc_sync.sh t14-vol; FLEET_BACKEND=android pwsh -NoProfile -File scripts/fleet.ps1 -Scenario vol_receiver_vc -Peers a=windows:i,b=j"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_B" },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "vol-${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:vol-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "vol-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Create channel", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "room-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:room-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:vol-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 10000 },

    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:room-${RUN}", "timeout_ms": 120000 },

    { "peer": "a", "op": "open_channel", "name": "room-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Mute", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Unmute", "timeout_ms": 10000 },
    { "peer": "a", "op": "open_channel", "name": "room-${RUN}" },

    { "peer": "b", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "tap", "target": "text:vol-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "tap", "target": "text:room-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "semantics:Mute", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Unmute", "timeout_ms": 10000 },

    { "peer": "a", "op": "wait_for", "target": "type:_VoiceParticipantRow", "count": 2, "timeout_ms": 60000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:probe-a", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 8000, "why": "The leg connects and both sides hold their receivers." },
    { "peer": "all", "op": "shot", "name": "vol-01-in-room" },

    { "peer": "a", "op": "log", "message": "PROOF member volume: a turns b down from b's participant menu" },
    { "peer": "a", "op": "right_click", "target": "type:_VoiceParticipantRow > text:probe-b", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "menu > type:HollowSlider", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap_at", "of": "menu > type:HollowSlider", "align": "centerLeft", "dx": 2 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "vol-02-b-turned-down" },
    { "peer": "a", "op": "key", "value": "escape", "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "log", "message": "PROOF deafen on desktop: deafen then undeafen" },
    { "peer": "a", "op": "tap", "target": "semantics:Deafen", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Undeafen", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "vol-03-a-deafened" },
    { "peer": "a", "op": "tap", "target": "semantics:Undeafen", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Deafen", "timeout_ms": 10000 },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "b", "op": "log", "message": "PROOF deafen on the phone: deafen then undeafen" },
    { "peer": "b", "op": "tap", "target": "semantics:Deafen", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Undeafen", "timeout_ms": 10000 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "shot", "name": "vol-04-b-deafened" },
    { "peer": "b", "op": "tap", "target": "semantics:Undeafen", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Deafen", "timeout_ms": 10000 },
    { "peer": "all", "op": "wait", "ms": 1500 },
    { "peer": "all", "op": "shot", "name": "vol-05-after" }
  ],
  "cleanup": [
    {"peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0, "soft": true},
    {"peer": "a", "op": "right_click", "target": "server:vol-${RUN}"},
    {"peer": "a", "op": "tap", "target": "menu > text:Server settings"},
    {"peer": "a", "op": "wait", "ms": 400},
    {"peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0},
    {"peer": "a", "op": "tap", "target": "text:Delete server", "index": 0},
    {"peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0},
    {"peer": "a", "op": "wait_for", "gone": "server:vol-${RUN}", "timeout_ms": 30000},
    {"peer": "b", "op": "wait_for", "gone": "text:vol-${RUN}", "timeout_ms": 90000, "soft": true}
  ]
}
