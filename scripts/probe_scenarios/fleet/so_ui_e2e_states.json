{
  "_": [
    "Stream overlay end to end (#97), part 2 of 2, while curl reads the room's /events stream:",
    "b mutes, deafens, undeafens and unmutes with pauses, then both leave, a deletes the server",
    "and turns the overlay off.",
    "run: powershell -File scripts\\fleet.ps1 -Scenario so_ui_e2e_states -Peers a,b -Attach"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "a", "op": "log", "message": "b mutes" },
    { "peer": "b", "op": "tap", "target": "semantics:Mute", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Unmute", "timeout_ms": 10000 },
    { "peer": "all", "op": "wait", "ms": 5000 },
    { "peer": "a", "op": "log", "message": "b deafens" },
    { "peer": "b", "op": "tap", "target": "semantics:Deafen", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 5000 },
    { "peer": "a", "op": "log", "message": "b undeafens and unmutes" },
    { "peer": "b", "op": "tap", "target": "semantics:Undeafen", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 2000 },
    { "peer": "b", "op": "tap", "target": "semantics:Unmute", "index": 0, "allowMiss": true },
    { "peer": "all", "op": "wait", "ms": 5000 },
    { "peer": "a", "op": "shot", "name": "e2e-03-room-after" },
    { "peer": "a", "op": "log", "message": "b leaves the room" },
    { "peer": "b", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 5000 }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "semantics:Leave the room", "index": 0, "allowMiss": true },
    { "peer": "a", "op": "right_click", "target": "server:fleet-overlay" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:fleet-overlay", "timeout_ms": 30000 },
    { "peer": "a", "op": "overlay_server", "value": "off" }
  ]
}
