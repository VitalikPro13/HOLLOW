{
  "_": [
    "Video and voice-note PLAYBACK across a desktop and a phone (fvp/mdk bumps, any media",
    "engine change): a is a desktop (macOS, Windows or Linux), b a phone (iOS Simulator or",
    "Android emulator). They become friends, a sends regress_clip.mp4 and a voice note",
    "('Voice message.ogg', the name that marks a voice note on the wire) over the DM, and",
    "BOTH sides play both: b the received copies, a its own sent copies. video_state reads",
    "the VideoPlayer controller (initialised, size, position), audio_state waits for the",
    "voice note's position to advance; a screenshot alone cannot tell a texture that",
    "plays from one that failed to open.",
    "",
    "Desktops decode video with fvp (mdk); phones use the platform video_player engines,",
    "with fvp's native plugin still registered at start. Voice notes play through",
    "audioplayers everywhere.",
    "",
    "Fixtures: run `python3 scripts/make_regress_fixtures.py` first (build/regress_fixtures).",
    "The repo path must not contain 'temp': the DM send deletes a sent .ogg whose path does.",
    "Run on FRESH peers: the friendship is not per run.",
    "",
    "run (on the Mac mini, a = macOS, b = a simulator or emulator letter):",
    "  pwsh scripts/fleet.ps1 -Scenario media_play_mixed -Peers a,b -StepTimeoutSeconds 300"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },

    { "peer": "b", "op": "log", "message": "friends first: the phone sends the request, the desktop accepts it" },
    { "peer": "b", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "wait_for", "target": "text:${PEER_A}", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Requests", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Accept friend request", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:Accept friend request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:probe-b", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait_for", "target": "type:ChatComposerRow > type:EditableText", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "text:probe-a" },
    { "peer": "b", "op": "wait_for", "target": "field", "timeout_ms": 15000 },
    { "peer": "all", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "log", "message": "a video: the phone plays the received copy, the desktop its own" },
    { "peer": "a", "op": "attach_file", "path": "${REPO}/build/regress_fixtures/regress_clip.mp4" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "index": 0, "value": "clip ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:clip ${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait_for", "target": "type:VideoMessageBubble", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "text:clip ${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "tap", "target": "semantics:Download regress_clip.mp4", "index": 0, "soft": true },
    { "peer": "b", "op": "wait_for", "target": "semantics:Play regress_clip.mp4", "timeout_ms": 120000 },
    { "peer": "b", "op": "tap", "target": "semantics:Play regress_clip.mp4", "index": 0 },
    { "peer": "b", "op": "video_state", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "video_state", "timeout_ms": 5000 },
    { "peer": "b", "op": "shot", "name": "mixed-01-video-received" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Play regress_clip.mp4", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Play regress_clip.mp4", "index": 0 },
    { "peer": "a", "op": "video_state", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "video_state", "timeout_ms": 5000 },
    { "peer": "a", "op": "shot", "name": "mixed-02-video-own" },
    { "peer": "b", "op": "key", "value": "escape", "soft": true },
    { "peer": "b", "op": "tap", "target": "semantics:Close", "index": 0, "soft": true },
    { "peer": "a", "op": "key", "value": "escape", "soft": true },
    { "peer": "all", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "log", "message": "a voice note: it arrives on its own (voice notes skip the gate) and plays on both sides" },
    { "peer": "a", "op": "attach_file", "path": "${REPO}/build/regress_fixtures/Voice message.ogg" },
    { "peer": "a", "op": "tap", "target": "type:ChatComposerRow > type:EditableText", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "type:ChatComposerRow > type:EditableText", "index": 0, "value": "voice ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:voice ${RUN}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "target": "text:voice ${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Play Voice message.ogg", "timeout_ms": 90000 },
    { "peer": "b", "op": "wait_for", "gone": "contains:Downloading...", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait", "ms": 3000, "why": "The downloaded voice note is finalised before Play is pressed; the button reads Play throughout." },
    { "peer": "b", "op": "tap", "target": "semantics:Play Voice message.ogg", "index": 0 },
    { "peer": "b", "op": "audio_state", "timeout_ms": 20000 },
    { "peer": "b", "op": "shot", "name": "mixed-03-voice-received" },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "semantics:Play Voice message.ogg", "index": 0 },
    { "peer": "a", "op": "audio_state", "timeout_ms": 20000 },
    { "peer": "a", "op": "shot", "name": "mixed-04-voice-own" },
    { "peer": "all", "op": "dump", "name": "media-play-mixed" }
  ],
  "cleanup": [
    { "peer": "a", "op": "log", "message": "the friendship goes from a's Friends tab: More for probe-b, then Remove friend, which asks first" },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Add friend", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Friends", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "target": "semantics:More for probe-b", "timeout_ms": 15000, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:More for probe-b", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "menu > text:Remove friend", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Remove friend", "timeout_ms": 5000, "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:Remove friend", "index": 0, "soft": true },
    { "peer": "a", "op": "wait_for", "target": "text:No friends yet", "timeout_ms": 30000, "soft": true },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0, "soft": true }
  ]
}
