{
 "_": [
  "#140/#159 proof on one phone (iOS Simulator, throwaway identity): the editor red on dark and light,",
  "your own name in a server chat, and an emoji held in the picker sheet then let go.",
  "Same file for the BEFORE tree (base ca9836bd) and the AFTER tree.",
  "run (Mac mini): pwsh -NoProfile -File scripts/fleet.ps1 -Scenario ui158_mobile -Peers a=ios:<letter>"
 ],
 "peers": [
  "a"
 ],
 "steps": [
  {
   "peer": "all",
   "op": "wait_for",
   "provider": "connection",
   "equals": "connected",
   "timeout_ms": 120000
  },
  {
   "peer": "a",
   "op": "wait",
   "ms": 2000
  },
  {
   "peer": "a",
   "op": "log",
