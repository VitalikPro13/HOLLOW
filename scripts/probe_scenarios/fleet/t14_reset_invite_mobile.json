{
  "_": [
    "t14-reset on a phone: the owner's Access page in the phone's server settings route",
    "shows Reset invite link; the confirm and its result. A throwaway server, deleted at",
    "the end.",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario t14_reset_invite_mobile -Peers a"
  ],
  "peers": ["a"],
  "steps": [
    { "peer": "a", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "reset-phone" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:reset-phone", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "long_press", "target": "text:reset-phone", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Server settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "text:Access", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Reset invite link", "timeout_ms": 15000 },
    { "peer": "a", "op": "shot", "name": "t14rm-01-access" },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "t14rm-01b-access-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "tap", "target": "text:Reset link", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Reset the invite link?", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "t14rm-02-confirm" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Reset link", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:Reset the invite link?", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "text:Invite link reset", "timeout_ms": 10000, "soft": true },
    { "peer": "a", "op": "shot", "name": "t14rm-03-done" }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Overview", "index": 0, "soft": true },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0, "soft": true }
  ]
}
