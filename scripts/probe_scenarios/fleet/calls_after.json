{
  "_": [
    "Call surfaces rebuilt (design language session 22, tmp3.txt), the DM half.",
    "a and b befriend; a rings and cancels; a rings again and b accepts from",
    "Home through the incoming card (it lands b in the DM); the chat-first call",
    "row on both; Open the call and back; a shares (b sees the offer in the row),",
    "b watches (strip on top), fullscreen, idle, Escape; b shares too, a watches",
    "it and swaps back from the strip; light theme; 150% zoom; Home with the call",
    "in the dock, the header chip and the Home row; Leave.",
    "",
    "Needs FRESH peers (not yet friends). Leaves both peers up for",
    "calls_after_vc (attach it).",
    "",
    "run: powershell -File scripts\\fleet.ps1 -Scenario calls_after -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },

    { "peer": "b", "op": "tap", "target": "semantics:probe-a" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "got a minute to go over the mix? ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "semantics:probe-b", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait_for", "target": "text:got a minute to go over the mix? ${RUN}", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "semantics:Home", "index": 0 },

    { "peer": "a", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "c-01-ringing-out" },
    { "peer": "b", "op": "shot", "name": "c-02-incoming-card" },
    { "peer": "a", "op": "tap", "target": "text:Cancel", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 2500 },
    { "peer": "all", "op": "shot", "name": "c-03-cancelled" },

    { "peer": "a", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "all", "op": "wait_for", "target": "semantics:Leave the call", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait", "ms": 6000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "c-04-call-row" },
    { "peer": "all", "op": "dump", "name": "c-04-call-row" },

    { "peer": "a", "op": "tap", "target": "semantics:Open the call", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "c-05-stage-opened" },
    { "peer": "a", "op": "tap", "target": "semantics:Back to the chat", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },

    { "peer": "a", "op": "tap", "target": "semantics:Share your screen", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Screen 1", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "text:Screen 1", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Share", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 6000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "c-06-a-shares" },
    { "peer": "all", "op": "dump", "name": "c-06-a-shares" },

    { "peer": "b", "op": "tap", "target": "text:Watch", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 8000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "c-07-b-watches" },
    { "peer": "all", "op": "dump", "name": "c-07-b-watches" },

    { "peer": "b", "op": "tap", "target": "type:ShareTile", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 3500 },
    { "peer": "b", "op": "shot", "name": "c-08-fullscreen-idle" },
    { "peer": "b", "op": "hover_at", "x": 700, "y": 500, "frames": 4 },
    { "peer": "b", "op": "shot", "name": "c-09-fullscreen-chrome" },
    { "peer": "b", "op": "key", "value": "escape" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "b", "op": "shot", "name": "c-10-after-escape" },

    { "peer": "b", "op": "tap", "target": "semantics:Share your screen", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Screen 1", "timeout_ms": 15000 },
    { "peer": "b", "op": "tap", "target": "text:Screen 1", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Share", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 6000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "c-11-both-sharing" },
    { "peer": "a", "op": "tap", "target": "text:Watch", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 8000 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "c-12-a-watches-b" },
    { "peer": "a", "op": "tap", "target": "type:ShareTile", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "c-13-swapped" },

    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "c-14-stage-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "zoom", "value": 1.5 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "c-15-zoom150" },
    { "peer": "a", "op": "zoom", "value": 1.0 },
    { "peer": "a", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "tap", "target": "semantics:Home", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "c-16-home-in-call" },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the call", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 3000 },
    { "peer": "all", "op": "shot", "name": "c-17-after-leave" }
  ],
  "cleanup": [
    { "peer": "a", "op": "zoom", "value": 1.0 },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "b", "op": "key", "value": "escape" },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the call", "index": 0, "allowMiss": true },
    { "peer": "a", "op": "tap", "target": "semantics:Cancel", "index": 0, "allowMiss": true }
  ]
}
