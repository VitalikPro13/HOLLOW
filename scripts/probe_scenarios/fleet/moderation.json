{
  "_": [
    "Rungs 2 and 3 of the fleet ladder: moderation and visibility across three",
    "real instances. a makes a server with a #staff channel only moderators see,",
    "b and c join; c is made a moderator and #staff appears for c alone, and a",
    "post there reaches c and never b. Then a kicks b (b loses the server), b",
    "rejoins by the invite, a bans b (b loses it again) and b's next try never",
    "gives it back the server. Cleanup deletes the server, which c has to lose.",
    "",
    "Each of these is a security gate (op_allowed, the restricted-channel",
    "subgroup, the join lock) that must let honest traffic through and stop the",
    "rest, watched in the widgets rather than in the CRDT.",
    "",
    "run: powershell -File scripts/fleet.ps1 -Scenario moderation -Peers a,b,c"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_B" },
    { "peer": "c", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_C" },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "mod-${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:mod-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "mod-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "staff" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:staff", "timeout_ms": 30000 },

    { "peer": "a", "op": "log", "message": "#staff is for moderators and up BEFORE anyone joins, so nobody else ever holds it" },
    { "peer": "a", "op": "right_click", "target": "channel:staff" },
    { "peer": "a", "op": "tap", "target": "menu > text:Visibility", "index": 0 },
    { "peer": "a", "op": "tap", "target": "menu > text:Moderator and above", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "right_click", "target": "server:mod-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:mod-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "mod-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "channel:general", "timeout_ms": 60000 },

    { "peer": "c", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "c", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "c", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "server:mod-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "open_server", "name": "mod-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "channel:general", "timeout_ms": 60000 },

    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_B}", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_C}", "timeout_ms": 60000 },
    { "peer": "b", "op": "expect_count", "target": "channel:staff", "value": 0 },
    { "peer": "c", "op": "expect_count", "target": "channel:staff", "value": 0 },
    { "peer": "all", "op": "shot", "name": "mod-01-joined" },

    { "peer": "a", "op": "log", "message": "c becomes a moderator, and #staff appears for c" },
    { "peer": "a", "op": "right_click", "target": "key:member:${PEER_C}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Manage member", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Moderator", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Moderator", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Make moderator", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "text:Make moderator", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "mod-02-manage-c" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 10000 },
    { "peer": "c", "op": "wait_for", "target": "channel:staff", "timeout_ms": 90000 },

    { "peer": "a", "op": "open_channel", "name": "staff" },
    { "peer": "a", "op": "tap", "target": "hint:Message #staff" },
    { "peer": "a", "op": "enter_text", "target": "hint:Message #staff", "value": "staff only ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:staff only ${RUN}", "timeout_ms": 15000 },
    { "peer": "c", "op": "open_channel", "name": "staff" },
    { "peer": "c", "op": "wait_for", "target": "text:staff only ${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "expect_count", "target": "channel:staff", "value": 0 },
    { "peer": "all", "op": "shot", "name": "mod-03-staff" },

    { "peer": "a", "op": "log", "message": "a kicks b: b loses the server" },
    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "right_click", "target": "key:member:${PEER_B}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Kick member", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Kick", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Kick", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "key:member:${PEER_B}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:mod-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "gone": "key:member:${PEER_B}", "timeout_ms": 90000 },
    { "peer": "all", "op": "shot", "name": "mod-04-kicked" },

    { "peer": "b", "op": "log", "message": "a kick is not a ban: the invite lets b back in" },
    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:mod-${RUN}", "timeout_ms": 120000 },
    { "peer": "a", "op": "wait_for", "target": "key:member:${PEER_B}", "timeout_ms": 120000 },

    { "peer": "a", "op": "log", "message": "a bans b: b loses the server, and the invite no longer works for b" },
    { "peer": "a", "op": "right_click", "target": "key:member:${PEER_B}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Ban member", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Ban", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "mod-05-ban-confirm" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Ban", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "key:member:${PEER_B}", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:mod-${RUN}", "timeout_ms": 90000 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 30000 },
    { "peer": "b", "op": "shot", "name": "mod-06-banned-rejoin" },
    { "peer": "b", "op": "expect_count", "target": "channel:general", "value": 0 },
    { "peer": "a", "op": "expect_count", "target": "key:member:${PEER_B}", "value": 0 },

    { "peer": "all", "op": "dump", "name": "moderation" }
  ],
  "cleanup": [
    { "peer": "a", "op": "right_click", "target": "server:mod-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:mod-${RUN}", "timeout_ms": 30000 },
    { "peer": "c", "op": "wait_for", "gone": "server:mod-${RUN}", "timeout_ms": 90000 }
  ]
}
