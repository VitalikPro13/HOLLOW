{
  "_": [
    "0.14 call route badge, the DM half (project_call_route_badge_014).",
    "",
    "a and b befriend, a calls, b accepts: both peers sit on one PC, so the",
    "call row and the stage bar say Direct. a shares a screen and b watches:",
    "the share's title row says Direct too. Leave. Then a turns on Always",
    "relay calls (Later: a new call reads the policy at once) and calls",
    "again: both ends say Relayed. a turns it off again in cleanup.",
    "",
    "Needs FRESH Windows peers (DM calls need a microphone) on the 0.14",
    "test relay (it has TURN).",
    "",
    "run: FLEET_BACKEND=macos pwsh scripts/fleet.ps1 -Scenario t14_route_badge_dm -Peers a=windows:g,b=windows:h"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "semantics:probe-a" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "route check ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "semantics:probe-b", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait_for", "target": "text:route check ${RUN}", "timeout_ms": 60000 },

    { "peer": "a", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "callStatus", "equals": "active", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait_for", "target": "type:DmCallRow > text:Direct", "timeout_ms": 30000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "rd-01-call-row-direct" },
    { "peer": "all", "op": "dump", "name": "rd-01-call-row-direct" },
    { "peer": "a", "op": "tap", "target": "semantics:Open the call", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:CallStageBar > text:Direct", "timeout_ms": 15000 },
    { "peer": "a", "op": "hover", "target": "type:CallStageBar > text:Direct", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200, "why": "The tooltip opens after its hover delay." },
    { "peer": "a", "op": "shot", "name": "rd-02-stage-direct-tooltip" },
    { "peer": "a", "op": "tap", "target": "semantics:Back to the chat", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },

    { "peer": "a", "op": "tap", "target": "semantics:Share your screen", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Screen 1", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "text:Screen 1", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Share", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Watch", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:Watch", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "type:ShareTile > text:Direct", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait", "ms": 4000, "why": "Video frames for the shot; no op reads an RTC view's frame count." },
    { "peer": "b", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "b", "op": "shot", "name": "rd-03-share-direct" },
    { "peer": "b", "op": "dump", "name": "rd-03-share-direct" },
    { "peer": "a", "op": "tap", "target": "semantics:Stop sharing", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the call", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 },

    { "peer": "a", "op": "log", "message": "a turns on Always relay calls and picks Later; a new call reads the policy at once" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0 },
    { "peer": "a", "op": "reveal", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Later", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Later", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 10000 },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait", "ms": 1500 },

    { "peer": "a", "op": "tap", "target": "semantics:Start voice call", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Accept", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "callStatus", "equals": "active", "timeout_ms": 45000 },
    { "peer": "all", "op": "wait_for", "target": "type:DmCallRow > text:Relayed", "timeout_ms": 45000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "rd-04-call-row-relayed" },
    { "peer": "all", "op": "dump", "name": "rd-04-call-row-relayed" },
    { "peer": "a", "op": "tap", "target": "semantics:Open the call", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:CallStageBar > text:Relayed", "timeout_ms": 15000 },
    { "peer": "a", "op": "hover", "target": "type:CallStageBar > text:Relayed", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200, "why": "The tooltip opens after its hover delay." },
    { "peer": "a", "op": "shot", "name": "rd-05-stage-relayed-tooltip" },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the call", "index": 0 },
    { "peer": "all", "op": "wait_for", "provider": "callStatus", "equals": "idle", "timeout_ms": 30000 }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "semantics:Leave the call", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0 },
    { "peer": "a", "op": "reveal", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Later", "index": 0, "soft": true },
    { "peer": "a", "op": "key", "value": "escape" }
  ]
}
