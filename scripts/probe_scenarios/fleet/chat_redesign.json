{
  "_": [
    "Chat redesign (design language section 5) on two throwaway peers.",
    "a and b befriend, talk in a DM (a reply, a reaction, a long line), then",
    "in a server a creates, where b mentions a. Shots cover the DM with its",
    "profile panel on the right, the hover bar and its More menu, the composer",
    "with and without text, the one expression picker on each tab, the",
    "panel's More menu, the channel, and both in light.",
    "",
    "The server is created by this run and deleted by its cleanup.",
    "${RUN} is unique per run: the relay holds undelivered traffic for three",
    "days and these identities are stable.",
    "",
    "run: powershell -File scripts\\fleet.ps1 -Scenario chat_redesign -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },

    { "peer": "b", "op": "tap", "target": "semantics:probe-a" },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "ok the stems are up, mind giving the second half a listen? ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "the low end on track 3 still feels muddy to me, no idea if it is the kick or the bass" },
    { "peer": "b", "op": "key", "value": "enter" },

    { "peer": "a", "op": "wait_for", "target": "semantics:probe-b", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait_for", "target": "text:ok the stems are up, mind giving the second half a listen? ${RUN}", "timeout_ms": 60000 },
    { "peer": "a", "op": "hover", "target": "text:the low end on track 3 still feels muddy to me, no idea if it is the kick or the bass" },
    { "peer": "a", "op": "tap", "target": "semantics:Reply" },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "cut everything under 40 Hz and it breathes now" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "sending the new bounce in a minute" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "text:sending the new bounce in a minute", "timeout_ms": 60000 },
    { "peer": "b", "op": "hover", "target": "text:sending the new bounce in a minute" },
    { "peer": "b", "op": "tap", "target": "semantics:React 👍" },
    { "peer": "b", "op": "wait", "ms": 600 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "perfect, around for a call later?" },
    { "peer": "b", "op": "key", "value": "enter" },

    { "peer": "a", "op": "wait_for", "target": "text:perfect, around for a call later?", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "d-01-dm" },
    { "peer": "a", "op": "hover", "target": "text:perfect, around for a call later?" },
    { "peer": "a", "op": "shot", "name": "d-02-hover" },
    { "peer": "a", "op": "tap", "target": "semantics:More message actions" },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "shot", "name": "d-03-more-menu" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "yes, 8 works" },
    { "peer": "a", "op": "wait", "ms": 300 },
    { "peer": "a", "op": "shot", "name": "d-04-typing" },
    { "peer": "a", "op": "tap", "target": "semantics:Emoji, GIFs and stickers" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "d-05-picker-emoji" },
    { "peer": "a", "op": "tap", "target": "text:GIFs", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "shot", "name": "d-06-picker-gifs" },
    { "peer": "a", "op": "tap", "target": "text:Stickers", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "d-07-picker-stickers" },
    { "peer": "a", "op": "tap_at", "x": 300, "y": 200 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap", "target": "semantics:More", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "shot", "name": "d-08-panel-menu" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "d-09-dm-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "tap", "target": "semantics:Hide profile" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "d-10-dm-no-panel" },
    { "peer": "a", "op": "tap", "target": "semantics:Show profile" },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "chat-probe" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:chat-probe", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:chat-probe" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:SelectableText", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:SelectableText", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:chat-probe", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "chat-probe" },
    { "peer": "b", "op": "open_channel", "name": "general" },
    { "peer": "b", "op": "wait", "ms": 4000 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "anyone tried the new firmware on the clock divider? ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "@probe-a can you include the tempo sync fix in tonight's notes?" },
    { "peer": "b", "op": "key", "value": "enter" },

    { "peer": "a", "op": "open_server", "name": "chat-probe" },
    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "wait_for", "target": "text:anyone tried the new firmware on the clock divider? ${RUN}", "timeout_ms": 60000 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "yes, pushing the patch notes tonight" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "c-01-channel" },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "c-02-channel-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Appearance", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "scroll", "target": "text:Window layout", "dy": -300 },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "tap", "target": "text:Compact", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "shot", "name": "c-03-appearance-display" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "c-04-channel-compact" },
    { "peer": "a", "op": "tap", "target": "semantics:probe-b" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "d-11-dm-compact" }
  ],
  "cleanup": [
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "right_click", "target": "server:chat-probe" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "tap", "target": "semantics:Scroll settings tabs right", "allowMiss": true },
    { "peer": "a", "op": "tap", "target": "semantics:Scroll settings tabs right", "allowMiss": true },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "tap", "target": "text:Danger", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 1 },
    { "peer": "a", "op": "wait_for", "gone": "server:chat-probe", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:chat-probe", "timeout_ms": 90000 }
  ]
}
