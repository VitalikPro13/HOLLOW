{
  "_": [
    "0.14 call route badge, the voice room half (project_call_route_badge_014).",
    "",
    "a creates a server and a voice room, b and c join, all three sit in it:",
    "every leg is on one machine, so the bar says Direct. Then a turns on",
    "Always relay calls (Later, no restart: new peer connections read the",
    "policy at once), everyone leaves and comes back: a's legs ride TURN, so",
    "a's bar says Relayed, and b and c (direct to each other, relayed to a)",
    "say Partly relayed. a turns Always relay off again in cleanup.",
    "",
    "Joining a room keeps the chat in view; opening it again shows the stage",
    "and its bar.",
    "",
    "Works on macOS peers (a voice room connects without a microphone).",
    "Needs FRESH peers on the 0.14 test relay (it has TURN).",
    "",
    "run: FLEET_BACKEND=macos pwsh scripts/fleet.ps1 -Scenario t14_route_badge_vc -Peers a=w,b=x,c=y"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "route-${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:route-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "route-${RUN}" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "room" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:room", "timeout_ms": 30000 },

    { "peer": "a", "op": "right_click", "target": "server:route-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "c", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "c", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "c", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:route-${RUN}", "timeout_ms": 90000 },
    { "peer": "c", "op": "wait_for", "target": "server:route-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "route-${RUN}" },
    { "peer": "b", "op": "wait_for", "target": "channel:room", "timeout_ms": 30000 },
    { "peer": "c", "op": "open_server", "name": "route-${RUN}" },
    { "peer": "c", "op": "wait_for", "target": "channel:room", "timeout_ms": 30000 },

    { "peer": "a", "op": "open_channel", "name": "room" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_channel", "name": "room" },
    { "peer": "a", "op": "wait", "ms": 1500, "why": "A second open shows the room stage; the first only joins." },
    { "peer": "b", "op": "open_channel", "name": "room" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "open_channel", "name": "room" },
    { "peer": "b", "op": "wait", "ms": 1500, "why": "A second open shows the room stage; the first only joins." },
    { "peer": "c", "op": "open_channel", "name": "room" },
    { "peer": "c", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "c", "op": "open_channel", "name": "room" },
    { "peer": "c", "op": "wait", "ms": 1500, "why": "A second open shows the room stage; the first only joins." },

    { "peer": "all", "op": "log", "message": "every leg is host to host on one machine: the bar says Direct" },
    { "peer": "all", "op": "wait_for", "target": "type:CallStageBar > text:Direct", "timeout_ms": 30000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "rb-01-room-direct" },
    { "peer": "all", "op": "dump", "name": "rb-01-room-direct" },
    { "peer": "a", "op": "hover", "target": "type:CallStageBar > text:Direct", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200, "why": "The tooltip opens after its hover delay." },
    { "peer": "a", "op": "shot", "name": "rb-02-room-direct-tooltip" },

    { "peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "all", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 },

    { "peer": "a", "op": "log", "message": "a turns on Always relay calls and picks Later; new peer connections read the policy at once" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0 },
    { "peer": "a", "op": "reveal", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Later", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "rb-03-always-relay-on" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Later", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 10000 },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "open_server", "name": "route-${RUN}" },

    { "peer": "a", "op": "open_channel", "name": "room" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_channel", "name": "room" },
    { "peer": "a", "op": "wait", "ms": 1500, "why": "A second open shows the room stage; the first only joins." },
    { "peer": "b", "op": "open_channel", "name": "room" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "open_channel", "name": "room" },
    { "peer": "b", "op": "wait", "ms": 1500, "why": "A second open shows the room stage; the first only joins." },
    { "peer": "c", "op": "open_channel", "name": "room" },
    { "peer": "c", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "c", "op": "open_channel", "name": "room" },
    { "peer": "c", "op": "wait", "ms": 1500, "why": "A second open shows the room stage; the first only joins." },

    { "peer": "a", "op": "wait_for", "target": "type:CallStageBar > text:Relayed", "timeout_ms": 45000 },
    { "peer": "b", "op": "wait_for", "target": "type:CallStageBar > text:Partly relayed", "timeout_ms": 45000 },
    { "peer": "c", "op": "wait_for", "target": "type:CallStageBar > text:Partly relayed", "timeout_ms": 45000 },
    { "peer": "all", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "all", "op": "shot", "name": "rb-04-room-relayed" },
    { "peer": "all", "op": "dump", "name": "rb-04-room-relayed" },
    { "peer": "a", "op": "hover", "target": "type:CallStageBar > text:Relayed", "index": 0 },
    { "peer": "b", "op": "hover", "target": "type:CallStageBar > text:Partly relayed", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 1200, "why": "The tooltip opens after its hover delay." },
    { "peer": "a", "op": "shot", "name": "rb-05-room-relayed-tooltip" },
    { "peer": "b", "op": "shot", "name": "rb-06-room-partly-tooltip" },

    { "peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "all", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "semantics:Leave the room", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Security", "index": 0 },
    { "peer": "a", "op": "reveal", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Later", "index": 0, "soft": true },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "right_click", "target": "server:route-${RUN}" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:route-${RUN}", "timeout_ms": 30000 }
  ]
}
