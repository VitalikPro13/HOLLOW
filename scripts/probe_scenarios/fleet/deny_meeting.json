{
  "_": [
    "The relay operator's denylist refusing a MEETING (conf: id; t14-deny + t14-deny-client), on a THROWAWAY test relay.",
    "a hosts a meeting, b joins by its link, the meeting chat is open. The meeting id goes on the list: both",
    "show the meeting notice, then leave the meeting with the meeting sentence as a toast. Lifted, a starts it again and b rejoins.",
    "Needs: identities onboarded onto the test relay, FLEET_RELAY_SSH (+ FLEET_RELAY_SSH_OPTS) naming it.",
    "run: FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario deny_meeting -Attach -Peers a=q,b=windows:e"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "log", "message": "a starts a meeting, b joins by its link" },
    { "peer": "all", "op": "tap", "target": "semantics:Home", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Create a room", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Create a room", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > hint:e.g. Weekly sync", "value": "denymeet-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > type:HollowToggle", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:denymeet-${RUN}", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Start meeting", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Copy link", "index": 0 },
    { "peer": "a", "op": "capture", "from": "clipboard", "as": "LINK", "regex": "(https://\\S+#conf=[0-9a-f]{40}\\S*)" },
    { "peer": "a", "op": "capture", "from": "provider", "key": "meetingSeats", "as": "CONFID", "regex": "\"conf:([0-9a-f]{40})\"" },
    { "peer": "b", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Join a meeting", "timeout_ms": 20000 },
    { "peer": "b", "op": "tap", "target": "text:Join a meeting", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "dialog > hint:Paste the meeting link", "value": "${LINK}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "guest inCall", "timeout_ms": 90000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:[0-9a-f]+\":2", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:${CONFID}\":2", "timeout_ms": 5000 },
    { "peer": "a", "op": "log", "message": "meeting id conf:${CONFID}" },
    { "peer": "a", "op": "log", "message": "the meeting chat panel opens with the meeting" },
    { "peer": "a", "op": "wait_for", "target": "type:ChatComposerRow", "timeout_ms": 10000 },
    { "peer": "b", "op": "wait_for", "target": "type:ChatComposerRow", "timeout_ms": 10000 },
    { "peer": "all", "op": "shot", "name": "dm-01-before" },
    { "peer": "a", "op": "log", "message": "the meeting goes on the list" },
    { "peer": "a", "op": "relay_deny", "value": "add server conf:${CONFID}" },
    { "peer": "a", "op": "wait_for", "target": "contains:This meeting is not available on this relay", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "target": "contains:This meeting is not available on this relay", "timeout_ms": 15000 },
    { "peer": "a", "op": "expect_count", "target": "type:ChatComposerRow", "value": 0 },
    { "peer": "all", "op": "shot", "name": "dm-02-denied" },
    { "peer": "a", "op": "log", "message": "a refused meeting is left on every device (leaveRefusedVoice), with the meeting sentence as a toast" },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 15000 },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 15000 },
    { "peer": "all", "op": "shot", "name": "dm-03-left" },
    { "peer": "a", "op": "log", "message": "lifted: the host starts the same room again and b rejoins by the same link" },
    { "peer": "a", "op": "relay_deny", "value": "remove server conf:${CONFID}" },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "wait_for", "target": "text:denymeet-${RUN}", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "text:Start meeting", "index": 0 },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "host inCall", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "text:Join a meeting", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "dialog > hint:Paste the meeting link", "value": "${LINK}" },
    { "peer": "b", "op": "tap", "target": "dialog > text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "guest inCall", "timeout_ms": 90000 },
    { "peer": "a", "op": "wait_for", "provider": "meetingSeats", "matches": "\"conf:${CONFID}\":2", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "type:ChatComposerRow", "timeout_ms": 10000 },
    { "peer": "all", "op": "wait", "ms": 1000 },
    { "peer": "all", "op": "shot", "name": "dm-04-lifted" }
  ],
  "cleanup": [
    { "peer": "a", "op": "relay_deny", "value": "remove server conf:${CONFID}", "soft": true, "allowMiss": true },
    { "peer": "a", "op": "tap", "target": "text:End meeting", "index": 0, "allowMiss": true, "soft": true },
    { "peer": "a", "op": "tap", "target": "dialog > text:End meeting", "index": 0, "allowMiss": true, "soft": true },
    { "peer": "a", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 20000, "soft": true },
    { "peer": "b", "op": "wait_for", "provider": "meeting", "equals": "none", "timeout_ms": 30000, "soft": true }
  ]
}
