{
  "_": [
    "0.14 call route badge on the phone (project_call_route_badge_014).",
    "",
    "a creates a server and a voice room, b joins, both sit in it: the top",
    "bar's subtitle carries the timer and Direct. Then a turns on Always",
    "relay calls (Later), both leave and come back: both say Relayed. a",
    "turns it off again as the last step (never in cleanup: a run that stops",
    "early would turn it ON).",
    "",
    "Needs FRESH phone peers on the 0.14 test relay (it has TURN).",
    "A phone's server row starts collapsed and keeps its state while the",
    "Chats tab lives: expand it once, then tap the room straight away.",
    "Leaving the room lands on its text page: Back returns to Chats.",
    "",
    "run: pwsh scripts/fleet.ps1 -Scenario t14_route_badge_mobile -Peers a=r,b=s"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "rbm-${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:rbm-${RUN}", "timeout_ms": 30000 },
    { "peer": "all", "op": "tap", "target": "text:Hide", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "long_press", "target": "text:rbm-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Create channel", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Voice", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:EditableText", "value": "room-${RUN}" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait_for", "target": "text:room-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "long_press", "target": "text:rbm-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Invite people", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:room-${RUN}", "timeout_ms": 120000 },

    { "peer": "all", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "tap", "target": "text:rbm-${RUN}", "index": 0 },
    { "peer": "all", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:room-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:room-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },

    { "peer": "all", "op": "wait_for", "target": "type:MobileCallTopBar > text:Direct", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 1000 },
    { "peer": "all", "op": "shot", "name": "rm-01-room-direct" },
    { "peer": "all", "op": "dump", "name": "rm-01-room-direct" },
    { "peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "all", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "all", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "log", "message": "a turns on Always relay calls and picks Later" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Security", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "reveal", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "dialog > text:Later", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Later", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "dialog", "timeout_ms": 10000 },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },
    { "peer": "all", "op": "shot", "name": "rm-01b-home-expanded" },

    { "peer": "a", "op": "tap", "target": "text:room-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "tap", "target": "text:room-${RUN}", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1500 },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait_for", "target": "type:MobileCallTopBar > text:Relayed", "timeout_ms": 45000 },
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 1000 },
    { "peer": "all", "op": "shot", "name": "rm-02-room-relayed" },
    { "peer": "all", "op": "dump", "name": "rm-02-room-relayed" },
    { "peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0 },
    { "peer": "all", "op": "wait_for", "gone": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "all", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "all", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "log", "message": "a turns Always relay calls off again" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Security", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "reveal", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Always relay calls", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 }
  ],
  "cleanup": [
    { "peer": "all", "op": "tap", "target": "semantics:Leave the room", "index": 0, "soft": true }
  ]
}
