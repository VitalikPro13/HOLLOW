{
  "_": [
    "g13 member cap: the owner lowers the member limit to 1, so the server is full with",
    "the owner alone. The owner's Access page and invite say so, and a joiner gets the",
    "'Server is full' answer. Then the limit goes back to blank (up to the hard cap of",
    "512) and the same joiner gets in: members and presence on both sides.",
    "",
    "run (Mac lead): FLEET_BACKEND=macos pwsh -NoProfile -File scripts/fleet.ps1 -Scenario g13_member_cap -Peers a=g,b=windows:h"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "g13-cap" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:g13-cap", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "g13-cap" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },

    { "peer": "a", "op": "right_click", "target": "server:g13-cap" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "tap", "target": "text:Access", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Blank means up to 512. Nobody already here is removed.", "timeout_ms": 15000 },
    { "peer": "a", "op": "shot", "name": "g13-01-access-room" },
    { "peer": "a", "op": "enter_text", "target": "hint:Up to 512", "value": "1" },
    { "peer": "a", "op": "tap", "target": "text:Save", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:This server is full (1 member). New people can join once someone leaves.", "timeout_ms": 20000 },
    { "peer": "a", "op": "shot", "name": "g13-02-access-full" },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "g13-02b-access-full-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait_for", "gone": "text:This server is full (1 member). New people can join once someone leaves.", "timeout_ms": 5000 },
    { "peer": "a", "op": "shot", "name": "g13-02c-escape-closed" },

    { "peer": "a", "op": "right_click", "target": "server:g13-cap" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "wait_for", "target": "text:This server is full. New people can join once someone leaves.", "timeout_ms": 10000 },
    { "peer": "a", "op": "shot", "name": "g13-03-invite-full" },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:Server is full", "timeout_ms": 90000 },
    { "peer": "b", "op": "shot", "name": "g13-04-joiner-full" },
    { "peer": "b", "op": "key", "value": "escape" },
    { "peer": "b", "op": "wait", "ms": 800 },

    { "peer": "a", "op": "right_click", "target": "server:g13-cap" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "tap", "target": "text:Access", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "enter_text", "target": "hint:Up to 512", "value": "" },
    { "peer": "a", "op": "look", "filter": "Member limit" },
    { "peer": "a", "op": "tap", "target": "text:Save", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Blank means up to 512. Nobody already here is removed.", "timeout_ms": 20000 },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "wait_for", "gone": "text:Blank means up to 512. Nobody already here is removed.", "timeout_ms": 5000 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:g13-cap", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "g13-cap" },
    { "peer": "b", "op": "open_channel", "name": "general" },

    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "hello from a ${RUN}" },
    { "peer": "a", "op": "key", "value": "enter" },
    { "peer": "b", "op": "wait_for", "target": "text:hello from a ${RUN}", "timeout_ms": 60000 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "hello back from b ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "a", "op": "wait_for", "target": "text:hello back from b ${RUN}", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait", "ms": 3000 },
    { "peer": "all", "op": "shot", "name": "g13-05-members-presence" },
    { "peer": "all", "op": "dump", "name": "g13-converged" }
  ],
  "cleanup": [
    { "peer": "a", "op": "right_click", "target": "server:g13-cap" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:g13-cap", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:g13-cap", "timeout_ms": 90000 }
  ]
}
