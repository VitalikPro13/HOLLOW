{
  "_": [
    "Settings > Stream overlay (#97): every section dark and light, the look editor in motion,",
    "the local editor for a person. a and b befriend; b shares a look; a sets its own look,",
    "runs the overlay for OBS and adds b. Art: .team/art (make_art.py).",
    "Needs FRESH peers (not yet friends).",
    "run: powershell -File scripts\\fleet.ps1 -Scenario so_ui_settings -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_B" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "overlay_look", "value": "set",
      "images": { "idle": "D:/dev/wt/so-ui/.team/art/b_idle.png", "talking": "D:/dev/wt/so-ui/.team/art/b_talking.png" },
      "effects": { "talking": "shake", "idle": "dim" } },
    { "peer": "a", "op": "overlay_look", "value": "set",
      "images": {
        "idle": "D:/dev/wt/so-ui/.team/art/idle.png",
        "talking": "D:/dev/wt/so-ui/.team/art/talking.png",
        "loud": "D:/dev/wt/so-ui/.team/art/loud.png",
        "blink": "D:/dev/wt/so-ui/.team/art/blink.png",
        "muted": "D:/dev/wt/so-ui/.team/art/muted.png",
        "deafened": "D:/dev/wt/so-ui/.team/art/deafened.png" },
      "effects": { "talking": "bounce", "scale_with_voice": true, "idle": "none", "transition": "crossfade",
                   "hold_ms": 250, "blink_every_s": 5, "loud_threshold": 0.75, "mirror": false, "shadow": "soft" } },
    { "peer": "a", "op": "overlay_server", "value": "on" },
    { "peer": "a", "op": "overlay_person", "value": "add", "master": "${PEER_B}" },
    { "peer": "a", "op": "wait", "ms": 8000, "why": "b's shared look arrives over Olm" },
    { "peer": "a", "op": "dump", "name": "so-people" },

    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:Stream overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "hover_at", "x": 5, "y": 400 },
    { "peer": "a", "op": "shot", "name": "so-01-top-dark" },
    { "peer": "a", "op": "reveal", "target": "text:My overlay look", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-02-look-dark" },

    { "peer": "a", "op": "tap", "target": "semantics:Preview Talk. Hold to keep it going", "index": 0, "frames": 1 },
    { "peer": "a", "op": "shot", "name": "so-03-talk-f1" },
    { "peer": "a", "op": "wait", "frames": 2 },
    { "peer": "a", "op": "shot", "name": "so-03-talk-f2" },
    { "peer": "a", "op": "wait", "frames": 2 },
    { "peer": "a", "op": "shot", "name": "so-03-talk-f3" },
    { "peer": "a", "op": "wait", "frames": 2 },
    { "peer": "a", "op": "shot", "name": "so-03-talk-f4" },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "semantics:Preview Loud. Hold to keep it going", "index": 0, "frames": 2 },
    { "peer": "a", "op": "shot", "name": "so-04-loud" },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "text:Blink", "index": 0, "frames": 1 },
    { "peer": "a", "op": "shot", "name": "so-05-blink" },
    { "peer": "a", "op": "tap", "target": "text:Muted", "index": 0 },
    { "peer": "a", "op": "shot", "name": "so-06-muted" },
    { "peer": "a", "op": "tap", "target": "text:Deafened", "index": 0 },
    { "peer": "a", "op": "shot", "name": "so-07-deafened" },
    { "peer": "a", "op": "tap", "target": "text:Idle", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Glow", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Preview Talk. Hold to keep it going", "index": 0, "frames": 3 },
    { "peer": "a", "op": "shot", "name": "so-08-glow" },
    { "peer": "a", "op": "tap", "target": "text:Bounce", "index": 0, "why": "edits save at once; back to the fixture's effect" },

    { "peer": "a", "op": "reveal", "target": "text:People on my overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-09-people-dark" },
    { "peer": "a", "op": "tap", "target": "text:Pick images", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "so-10-local-editor-dark" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Pop", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "shot", "name": "so-11-local-override-dark" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Done", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },

    { "peer": "a", "op": "reveal", "target": "text:Run the overlay for OBS", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-12-obs-dark" },
    { "peer": "a", "op": "reveal", "target": "text:Avatars while quiet", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-13-layout-dark" },
    { "peer": "a", "op": "reveal", "target": "text:Customise with CSS in OBS", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-14-listen-dark" },
    { "peer": "a", "op": "reveal", "target": "text:Example", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-15-css-dark" },

    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "so-16-css-light" },
    { "peer": "a", "op": "reveal", "target": "text:Listen to my mic now", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-17-listen-light" },
    { "peer": "a", "op": "reveal", "target": "text:Arrange", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-18-layout-light" },
    { "peer": "a", "op": "reveal", "target": "text:Run the overlay for OBS", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-19-obs-light" },
    { "peer": "a", "op": "reveal", "target": "text:People on my overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-20-people-light" },
    { "peer": "a", "op": "tap", "target": "text:Pick images", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "so-21-local-editor-light" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Done", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "reveal", "target": "text:My overlay look", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "so-22-look-light" },
    { "peer": "a", "op": "reveal", "target": "text:Who can show me", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Let others show me on their stream overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "so-23-privacy-off-light" },
    { "peer": "a", "op": "tap", "target": "semantics:Let others show me on their stream overlay", "index": 0 },
    { "peer": "a", "op": "tap", "target": "semantics:Share my overlay images", "index": 0 },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "key", "value": "escape" }
  ],
  "cleanup": [
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "overlay_server", "value": "off" }
  ]
}
