{
  "_": [
    "#140 name colours on two phones (iOS Simulators): b sees a's hashed name, a",
    "picks a two-stop gradient in Settings > Profile and saves, b sees it in the DM",
    "on dark and light. Friend steps copied from mobile_friend_dm.json.",
    "run (Mac mini): pwsh scripts/fleet.ps1 -Scenario name_colors_mobile -Peers a,b"
  ],
  "peers": [
    "a",
    "b"
  ],
  "steps": [
    {
      "peer": "all",
      "op": "wait_for",
      "provider": "connection",
      "equals": "connected",
      "timeout_ms": 120000
    },
    {
      "peer": "a",
      "op": "capture",
      "from": "provider",
      "key": "peerId",
      "as": "PEER_A"
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "semantics:Friends",
      "index": 0
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "text:Add friend",
      "index": 0
    },
    {
      "peer": "b",
      "op": "enter_text",
      "target": "hint:Paste an ID, or type a nickname",
      "value": "${PEER_A}"
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:${PEER_A}",
      "timeout_ms": 10000
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "text:Send request",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "semantics:Friends, 1 friend request",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Friends",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "semantics:Accept friend request",
      "timeout_ms": 10000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Accept friend request",
      "index": 0
    },
    {
      "peer": "a",
      "op": "log",
      "message": "the accepted friend must reach the UI on BOTH sides, not just the friends table"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "text:probe-b",
      "timeout_ms": 60000
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:probe-a",
      "timeout_ms": 60000
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "text:probe-a"
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "field",
      "timeout_ms": 15000
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "field",
      "index": 0
    },
    {
      "peer": "b",
      "op": "enter_text",
      "target": "field",
      "value": "dm from b ${RUN}"
    },
    {
      "peer": "b",
      "op": "tap",
      "target": "semantics:Send message",
      "index": 0
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:dm from b ${RUN}",
      "timeout_ms": 15000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Chats",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "text:dm from b ${RUN}",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "text:probe-b"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "field",
      "timeout_ms": 15000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "field",
      "index": 0
    },
    {
      "peer": "a",
      "op": "enter_text",
      "target": "field",
      "value": "dm from a ${RUN}"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Send message",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "text:dm from a ${RUN}",
      "timeout_ms": 15000
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:dm from a ${RUN}",
      "timeout_ms": 60000
    },
    {
      "peer": "a",
      "op": "log",
      "message": "one row per message in the open chat; the Chats list preview may add a second match, so the count is reported, not asserted"
    },
    {
      "peer": "a",
      "op": "expect_count",
      "target": "text:dm from a ${RUN}",
      "value": 1,
      "soft": true
    },
    {
      "peer": "b",
      "op": "expect_count",
      "target": "text:dm from b ${RUN}",
      "value": 1,
      "soft": true
    },
    {
      "peer": "b",
      "op": "shot",
      "name": "ncm-01-b-dm-hashed-dark"
    },
    {
      "peer": "a",
      "op": "log",
      "message": "a leaves the chat for Settings > Profile, picks a gradient, saves"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Back",
      "index": 0,
      "soft": true
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Settings",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "text:Profile",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 1000
    },
    {
      "peer": "a",
      "op": "reveal",
      "target": "text:Name colour"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Use this colour",
      "index": 2
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Add a colour",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 500
    },
    {
      "peer": "a",
      "op": "reveal",
      "target": "text:Name colour"
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ncm-02-a-picker-dark"
    },
    {
      "peer": "a",
      "op": "theme",
      "value": "light"
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ncm-03-a-picker-light"
    },
    {
      "peer": "a",
      "op": "theme",
      "value": "dark"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "text:Save",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 1500
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Back",
      "index": 0,
      "soft": true
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Chats",
      "index": 0
    },
    {
      "peer": "a",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "text:probe-b"
    },
    {
      "peer": "a",
      "op": "wait_for",
      "target": "field",
      "timeout_ms": 15000
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "field",
      "index": 0
    },
    {
      "peer": "a",
      "op": "enter_text",
      "target": "field",
      "value": "gradient from a ${RUN}"
    },
    {
      "peer": "a",
      "op": "tap",
      "target": "semantics:Send message",
      "index": 0
    },
    {
      "peer": "b",
      "op": "wait_for",
      "target": "text:gradient from a ${RUN}",
      "timeout_ms": 60000
    },
    {
      "peer": "b",
      "op": "wait",
      "ms": 1500
    },
    {
      "peer": "b",
      "op": "shot",
      "name": "ncm-04-b-dm-gradient-dark"
    },
    {
      "peer": "b",
      "op": "theme",
      "value": "light"
    },
    {
      "peer": "b",
      "op": "wait",
      "ms": 800
    },
    {
      "peer": "b",
      "op": "shot",
      "name": "ncm-05-b-dm-gradient-light"
    },
    {
      "peer": "b",
      "op": "theme",
      "value": "dark"
    },
    {
      "peer": "a",
      "op": "shot",
      "name": "ncm-06-a-dm-own-gradient"
    }
  ],
  "cleanup": [
    {
      "peer": "all",
      "op": "log",
      "message": "fixture data directories are restored per run; nothing to undo"
    }
  ]
}