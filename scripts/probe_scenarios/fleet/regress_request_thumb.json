{
  "peers": ["a", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "c", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_C" },

    { "peer": "a", "op": "log", "message": "a sets a still avatar (through the cropper)" },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsPlace > text:Profile", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "semantics:Change avatar", "timeout_ms": 20000 },
    { "peer": "a", "op": "arm_file_pick", "path": "${REPO}/build/s36_fixtures/avatar_a.png" },
    { "peer": "a", "op": "tap", "target": "semantics:Change avatar", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Apply", "timeout_ms": 20000 },
    { "peer": "a", "op": "tap", "target": "text:Apply", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:You have unsaved profile changes", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:SettingsUnsavedBar > text:Save", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:You have unsaved profile changes", "timeout_ms": 30000 },
    { "peer": "a", "op": "shot", "name": "rt-01-a-avatar-saved", "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Close settings", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "type:SettingsPlace", "timeout_ms": 10000 },

    { "peer": "c", "op": "log", "message": "c sets an animated avatar (skips the cropper)" },
    { "peer": "c", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:SettingsPlace", "timeout_ms": 20000 },
    { "peer": "c", "op": "tap", "target": "type:SettingsPlace > text:Profile", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "semantics:Change avatar", "timeout_ms": 20000 },
    { "peer": "c", "op": "arm_file_pick", "path": "${REPO}/build/s36_fixtures/avatar_c.gif" },
    { "peer": "c", "op": "tap", "target": "semantics:Change avatar", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "text:You have unsaved profile changes", "timeout_ms": 15000 },
    { "peer": "c", "op": "tap", "target": "type:SettingsUnsavedBar > text:Save", "index": 0 },
    { "peer": "c", "op": "wait_for", "gone": "text:You have unsaved profile changes", "timeout_ms": 30000 },
    { "peer": "c", "op": "shot", "name": "rt-02-c-avatar-saved", "soft": true },
    { "peer": "c", "op": "tap", "target": "semantics:Close settings", "index": 0 },
    { "peer": "c", "op": "wait_for", "gone": "type:SettingsPlace", "timeout_ms": 10000 },

    { "peer": "a", "op": "log", "message": "a, a stranger to c, sends c a request by ID" },
    { "peer": "a", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager", "timeout_ms": 15000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Add friend", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_C}" },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager > text:${PEER_C}", "timeout_ms": 5000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > text:Send request", "index": 0 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Requests", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager > semantics:Cancel friend request", "timeout_ms": 15000 },

    { "peer": "c", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:_FriendsManager", "timeout_ms": 15000 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Requests", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:_FriendsManager > semantics:Accept friend request", "timeout_ms": 60000 },
    { "peer": "c", "op": "log", "message": "c's incoming row: a's name and a's thumbnail, from a's sealed card" },
    { "peer": "c", "op": "wait_for", "target": "type:_FriendsManager > text:probe-a", "timeout_ms": 60000 },
    { "peer": "a", "op": "log", "message": "a's outgoing row: c's name and c's thumbnail, from the card c sealed back" },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager > text:probe-c", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 4000 },
    { "peer": "all", "op": "shot", "name": "rt-03-pending-thumbs", "soft": true },
    { "peer": "all", "op": "dump", "name": "rt-03-pending-thumbs" },

    { "peer": "c", "op": "log", "message": "c accepts; the full profile retires the thumbnail" },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > semantics:Accept friend request", "index": 0 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Friends", "index": 0 },
    { "peer": "c", "op": "wait_for", "target": "type:_FriendsManager > text:probe-a", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "type:_FriendsManager > type:_TabBar > semantics:Friends", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:_FriendsManager > text:probe-c", "timeout_ms": 60000 },
    { "peer": "all", "op": "wait", "ms": 6000 },
    { "peer": "all", "op": "shot", "name": "rt-04-friends-full-avatars", "soft": true }
  ],
  "cleanup": [
    { "peer": "all", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0, "soft": true }
  ]
}
