{
  "_": [
    "Chat redesign on the phone, two iOS Simulators on the Mac mini.",
    "a and b befriend, b writes twice, a replies to b's second message from the",
    "long-press sheet and b reacts to a's reply. Shots on a: the DM, the",
    "long-press sheet on a's own message, the composer with text, the one",
    "expression panel on each tab (it takes the keyboard's place under the",
    "composer), the attach sheet, the profile sheet and its More menu, light,",
    "then compact display.",
    "",
    "The composer is the 'field' target (its hint names the person now) and",
    "sends with 'Send message', never Return. Sheets close with a tap on the",
    "scrim above them: Escape does not reach them in the simulator. The",
    "expression panel has no scrim; a tap on a message closes it.",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario chat_mobile -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },

    { "peer": "b", "op": "tap", "target": "semantics:Friends", "index": 0 },
    { "peer": "b", "op": "tap", "target": "text:Add Friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Peer ID or nickname...", "value": "${PEER_A}" },
    { "peer": "b", "op": "wait_for", "target": "text:${PEER_A}", "timeout_ms": 10000 },
    { "peer": "b", "op": "tap", "target": "text:Send Friend Request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:Needs Attention", "timeout_ms": 60000 },

    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "text:probe-a" },
    { "peer": "b", "op": "wait_for", "target": "field", "timeout_ms": 15000 },
    { "peer": "b", "op": "tap", "target": "field", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "ok the stems are up ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "the low end on track 3 still feels muddy to me" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },

    { "peer": "a", "op": "wait_for", "target": "text:the low end on track 3 still feels muddy to me", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:probe-b", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "field", "timeout_ms": 15000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "long_press", "target": "text:the low end on track 3 still feels muddy to me", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:Reply", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "cut everything under 40 Hz, it breathes now" },
    { "peer": "a", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:cut everything under 40 Hz, it breathes now", "timeout_ms": 60000 },
    { "peer": "b", "op": "long_press", "target": "text:cut everything under 40 Hz, it breathes now", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "tap", "target": "semantics:React 👍", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 800 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "perfect, call later?" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },

    { "peer": "a", "op": "wait_for", "target": "text:perfect, call later?", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "m-01-dm" },
    { "peer": "a", "op": "long_press", "target": "text:cut everything under 40 Hz, it breathes now", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 900 },
    { "peer": "a", "op": "shot", "name": "m-02-actions" },
    { "peer": "a", "op": "tap_at", "x": 195, "y": 90 },
    { "peer": "a", "op": "wait", "ms": 700 },
    { "peer": "a", "op": "tap", "target": "field", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "yes, 8 works" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "m-03-typing" },
    { "peer": "a", "op": "tap", "target": "semantics:Emoji, GIFs and stickers", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "m-04-expressions-emoji" },
    { "peer": "a", "op": "tap", "target": "text:GIFs", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "shot", "name": "m-05-expressions-gifs" },
    { "peer": "a", "op": "tap", "target": "text:Stickers", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "m-06-expressions-stickers" },
    { "peer": "a", "op": "tap", "target": "text:cut everything under 40 Hz, it breathes now", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 700 },
    { "peer": "a", "op": "tap", "target": "semantics:Attach a file", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "m-07-attach" },
    { "peer": "a", "op": "tap_at", "x": 195, "y": 90 },
    { "peer": "a", "op": "wait", "ms": 700 },
    { "peer": "a", "op": "tap", "target": "semantics:Profile of probe-b", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "shot", "name": "m-08-profile" },
    { "peer": "a", "op": "tap", "target": "semantics:More", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 700 },
    { "peer": "a", "op": "shot", "name": "m-09-profile-more" },
    { "peer": "a", "op": "tap_at", "x": 20, "y": 90 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap_at", "x": 195, "y": 60 },
    { "peer": "a", "op": "wait", "ms": 700 },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "m-10-dm-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Settings", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:Appearance", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "scroll", "target": "text:Background", "dy": -400 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "tap", "target": "text:Compact", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 500 },
    { "peer": "a", "op": "shot", "name": "m-11-appearance" },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "text:probe-b", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "m-12-dm-compact" }
  ],
  "cleanup": [
    { "peer": "all", "op": "log", "message": "nothing to undo: every run restores the fixture data directories, and this run creates no server." }
  ]
}
