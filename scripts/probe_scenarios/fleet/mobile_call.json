  {
   "peer": "b",
   "op": "wait_for",
   "target": "text:dm from b ${RUN}",
   "timeout_ms": 15000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "semantics:Chats",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "text:dm from b ${RUN}",
   "timeout_ms": 60000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "text:probe-b"
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "field",
   "timeout_ms": 15000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "field",
   "index": 0
