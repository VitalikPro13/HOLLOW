{
 "_": [
  "Setup for places_before / places_after: a and b befriend and trade DMs.",
  "Run once on fresh peers (fleet.ps1 -Onboard -Fresh -Peers a,b), then the shot scenarios with -Attach.",
  "run: powershell -File scripts\fleet.ps1 -Scenario places_setup -Peers a,b"
 ],
 "peers": [
  "a",
  "b"
 ],
 "steps": [
  {
   "peer": "all",
   "op": "wait_for",
   "provider": "connection",
   "equals": "connected",
   "timeout_ms": 120000
  },
  {
   "peer": "all",
   "op": "wait",
   "ms": 2000
  },
  {
   "peer": "a",
   "op": "capture",
   "from": "provider",
   "key": "peerId",
   "as": "PEER_A"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:Add friend",
   "index": 0
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "type:_FriendsManager > text:Add friend",
   "index": 0
  },
  {
   "peer": "b",
   "op": "enter_text",
   "target": "hint:Paste an ID, or type a nickname",
   "value": "${PEER_A}"
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "text:Send request",
   "index": 0
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "text:Accept",
   "timeout_ms": 60000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "text:Accept",
   "index": 0
  },
  {
   "peer": "b",
   "op": "wait_for",
   "target": "text:probe-a",
   "timeout_ms": 60000
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "type:_FriendsManager > semantics:Close",
   "index": 0
  },
  {
   "peer": "b",
   "op": "wait_for",
   "gone": "type:_FriendsManager",
   "timeout_ms": 10000
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "semantics:probe-a"
  },
  {
   "peer": "b",
   "op": "wait",
   "ms": 1500
  },
  {
   "peer": "b",
   "op": "tap",
   "target": "field"
  },
  {
   "peer": "b",
   "op": "enter_text",
   "target": "field",
   "value": "did the stems export finish ${RUN}"
  },
  {
   "peer": "b",
   "op": "key",
   "value": "enter"
  },
  {
   "peer": "b",
   "op": "enter_text",
   "target": "field",
   "value": "I want to try the new filter envelope tonight"
  },
  {
   "peer": "b",
   "op": "key",
   "value": "enter"
  },
  {
   "peer": "a",
   "op": "wait_for",
   "target": "semantics:probe-b",
   "timeout_ms": 60000
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "semantics:probe-b"
  },
  {
   "peer": "a",
   "op": "wait",
   "ms": 1500
  },
  {
   "peer": "a",
   "op": "tap",
   "target": "field"
  },
  {
   "peer": "a",
   "op": "enter_text",
   "target": "field",
   "value": "almost, uploading them to the server now ${RUN}"
  },
  {
   "peer": "a",
   "op": "key",
   "value": "enter"
  }
 ]
}