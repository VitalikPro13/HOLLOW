{
  "_": [
    "Stream overlay end to end (#97), part 1 of 2. a and b befriend; b sets a look; a runs the",
    "overlay for OBS; a creates a server with a voice channel, b joins, both sit in the room; a",
    "opens b's voice row menu (the tick shows) and ticks b. Ends in the room: start curl on the",
    "room link from the overlay_server answer, then run so_ui_e2e_states with -Attach.",
    "Needs FRESH peers (not yet friends).",
    "run: powershell -File scripts\\fleet.ps1 -Scenario so_ui_e2e_setup -Peers a,b -Live"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "a", "op": "key", "value": "escape" },

    { "peer": "b", "op": "overlay_look", "value": "set",
      "images": { "idle": "D:/dev/wt/so-ui/.team/art/b_idle.png", "talking": "D:/dev/wt/so-ui/.team/art/b_talking.png" },
      "effects": { "talking": "shake" } },
    { "peer": "a", "op": "overlay_server", "value": "on" },
    { "peer": "a", "op": "dump", "name": "e2e-server" },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "fleet-overlay" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:fleet-overlay", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_server", "name": "fleet-overlay" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "lounge" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:lounge", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:fleet-overlay" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:fleet-overlay", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "fleet-overlay" },
    { "peer": "b", "op": "wait_for", "target": "channel:lounge", "timeout_ms": 30000 },
    { "peer": "a", "op": "open_channel", "name": "lounge" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "b", "op": "open_channel", "name": "lounge" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000 },
    { "peer": "all", "op": "wait", "ms": 6000 },

    { "peer": "a", "op": "right_click", "target": "text:probe-b", "index": 1, "why": "0 = the title bar, 1 = the voice row in the sidebar, 2 = the call stage tile" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "e2e-01-voice-row-menu" },
    { "peer": "a", "op": "tap", "target": "menu > text:Show on my stream overlay", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 8000, "why": "the ask and b's answer over Olm" },
    { "peer": "a", "op": "right_click", "target": "text:probe-b", "index": 1, "why": "0 = the title bar, 1 = the voice row in the sidebar, 2 = the call stage tile" },
    { "peer": "a", "op": "wait", "ms": 600 },
    { "peer": "a", "op": "shot", "name": "e2e-02-voice-row-menu-ticked" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "dump", "name": "e2e-people" },
    { "peer": "a", "op": "overlay_server", "value": "on" }
  ]
}
