{
  "_": [
    "The dock and header pass on three throwaway peers: the empty first run, a",
    "pending friend request, then the populated state (two friends, an unread",
    "DM, three servers, one with a mention and a voice room), each place",
    "selected, 150% zoom (the window controls stay unscaled), hovers on the",
    "header, dock and close button, light theme, and in a voice room so the",
    "dock's call controls show. Needs FRESH peers (not yet friends).",
    "",
    "The servers are created by this run and deleted by its cleanup.",
    "run: powershell -File scripts\\fleet.ps1 -Scenario dock_header -Peers a,b,c"
  ],
  "peers": ["a", "b", "c"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "all", "op": "wait", "ms": 3000 },
    { "peer": "a", "op": "shot", "name": "k-01-first-run" },

    { "peer": "a", "op": "capture", "from": "provider", "key": "peerId", "as": "PEER_A" },
    { "peer": "b", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "b", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "c", "op": "tap", "target": "semantics:Add friend", "index": 0 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > text:Add friend", "index": 0 },
    { "peer": "c", "op": "enter_text", "target": "hint:Paste an ID, or type a nickname", "value": "${PEER_A}" },
    { "peer": "c", "op": "tap", "target": "text:Send request", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "shot", "name": "k-02-requests" },

    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "tap", "target": "text:Accept", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "text:Needs Attention", "timeout_ms": 60000 },
    { "peer": "b", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "c", "op": "wait_for", "target": "text:probe-a", "timeout_ms": 60000 },
    { "peer": "b", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "b", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },
    { "peer": "c", "op": "tap", "target": "type:_FriendsManager > semantics:Close", "index": 0 },
    { "peer": "c", "op": "wait_for", "gone": "type:_FriendsManager", "timeout_ms": 10000 },

    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "dock-probe" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:dock-probe", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "Synth Lab" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:Synth Lab", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "Weekend Raid" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "server:Weekend Raid", "timeout_ms": 30000 },

    { "peer": "a", "op": "open_server", "name": "dock-probe" },
    { "peer": "a", "op": "wait_for", "target": "channel:general", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "semantics:Create channel", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Voice", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "dialog > type:TextField", "value": "lounge" },
    { "peer": "a", "op": "tap", "target": "dialog > text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "channel:lounge", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:dock-probe" },
    { "peer": "a", "op": "tap", "target": "menu > text:Invite people" },
    { "peer": "a", "op": "wait_for", "target": "type:SelectableText", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:SelectableText", "as": "INVITE" },
    { "peer": "a", "op": "key", "value": "escape" },
    { "peer": "a", "op": "tap", "target": "semantics:Home", "index": 0 },

    { "peer": "b", "op": "tap", "target": "semantics:Create a server" },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link or server ID", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "server:dock-probe", "timeout_ms": 90000 },
    { "peer": "b", "op": "open_server", "name": "dock-probe" },
    { "peer": "b", "op": "open_channel", "name": "general" },
    { "peer": "b", "op": "wait", "ms": 4000 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "@probe-a can you check the relay logs ${RUN}" },
    { "peer": "b", "op": "key", "value": "enter" },
    { "peer": "b", "op": "open_channel", "name": "lounge" },
    { "peer": "b", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000, "soft": true },

    { "peer": "c", "op": "tap", "target": "semantics:probe-a" },
    { "peer": "c", "op": "wait", "ms": 1500 },
    { "peer": "c", "op": "enter_text", "target": "field", "value": "see you on the stream tonight ${RUN}" },
    { "peer": "c", "op": "key", "value": "enter" },

    { "peer": "a", "op": "wait_for", "target": "text:see you on the stream tonight ${RUN}", "timeout_ms": 60000 },
    { "peer": "a", "op": "wait_for", "target": "text:#general", "timeout_ms": 60000, "soft": true },
    { "peer": "a", "op": "wait", "ms": 4000 },
    { "peer": "a", "op": "shot", "name": "k-03-populated-home" },

    { "peer": "a", "op": "tap", "target": "semantics:Conferences", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-13-place-conferences" },
    { "peer": "a", "op": "tap", "target": "semantics:Public channels", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-14-place-public" },
    { "peer": "a", "op": "tap", "target": "semantics:Share", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-15-place-share" },
    { "peer": "a", "op": "tap", "target": "semantics:Archive", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-16-place-archive" },
    { "peer": "a", "op": "tap", "target": "semantics:Archive", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "k-17-place-toggled-back" },

    { "peer": "a", "op": "zoom", "value": 1.5 },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-18-zoom-150" },
    { "peer": "a", "op": "zoom", "value": 1.0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "hover", "target": "semantics:Close", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "k-19-close-hover" },
    { "peer": "a", "op": "hover_at", "of": "type:WindowControls", "align": "topRight", "dx": -4, "dy": 4 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "k-20-close-corner" },
    { "peer": "a", "op": "hover_at", "x": 640, "y": 300 },

    { "peer": "a", "op": "hover", "target": "server:Synth Lab" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-04-hover-server" },
    { "peer": "a", "op": "hover", "target": "semantics:probe-c" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-05-hover-friend" },
    { "peer": "a", "op": "hover", "target": "semantics:Settings", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "shot", "name": "k-06-hover-dock-action" },
    { "peer": "a", "op": "hover_at", "x": 640, "y": 300 },

    { "peer": "a", "op": "open_server", "name": "dock-probe" },
    { "peer": "a", "op": "open_channel", "name": "general" },
    { "peer": "a", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "shot", "name": "k-07-server-open" },
    { "peer": "a", "op": "tap", "target": "semantics:probe-c" },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "k-08-dm-open" },
    { "peer": "a", "op": "theme", "value": "light" },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "k-09-dm-open-light" },
    { "peer": "a", "op": "tap", "target": "semantics:Home", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "shot", "name": "k-10-home-light" },
    { "peer": "a", "op": "theme", "value": "dark" },
    { "peer": "a", "op": "wait", "ms": 600 },

    { "peer": "a", "op": "open_server", "name": "dock-probe" },
    { "peer": "a", "op": "open_channel", "name": "lounge" },
    { "peer": "a", "op": "wait_for", "target": "semantics:Leave the room", "timeout_ms": 30000, "soft": true },
    { "peer": "a", "op": "wait", "ms": 2500 },
    { "peer": "a", "op": "shot", "name": "k-11-in-voice" },
    { "peer": "a", "op": "tap", "target": "semantics:Home", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "shot", "name": "k-12-in-voice-home" },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the room", "index": 0, "soft": true }
  ],
  "cleanup": [
    { "peer": "all", "op": "key", "value": "escape" },
    { "peer": "a", "op": "tap", "target": "semantics:Leave the room", "index": 0, "allowMiss": true },
    { "peer": "b", "op": "tap", "target": "semantics:Leave the room", "index": 0, "allowMiss": true },
    { "peer": "a", "op": "right_click", "target": "server:dock-probe" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:dock-probe", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:Synth Lab" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:Synth Lab", "timeout_ms": 30000 },
    { "peer": "a", "op": "right_click", "target": "server:Weekend Raid" },
    { "peer": "a", "op": "tap", "target": "menu > text:Server settings" },
    { "peer": "a", "op": "wait", "ms": 400 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0 },
    { "peer": "a", "op": "wait_for", "gone": "server:Weekend Raid", "timeout_ms": 30000 },
    { "peer": "b", "op": "wait_for", "gone": "server:dock-probe", "timeout_ms": 90000 }
  ]
}
