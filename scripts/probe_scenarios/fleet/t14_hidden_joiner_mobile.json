{
  "_": [
    "t14-hidden on two phones: a makes a server, b joins by its invite; a posts, b must see it, b answers, a posts again.",
    "Run it three times with -Onboard -Fresh between runs: a joiner the relay hides in the room never sees a's post.",
    "",
    "run (on the Mac mini): pwsh scripts/fleet.ps1 -Scenario t14_hidden_joiner_mobile -Peers a,b",
    "  Android: FLEET_BACKEND=android pwsh scripts/fleet.ps1 -Scenario t14_hidden_joiner_mobile -Peers a,b"
  ],
  "peers": ["a", "b"],
  "steps": [
    { "peer": "all", "op": "wait_for", "provider": "connection", "equals": "connected", "timeout_ms": 120000 },
    { "peer": "all", "op": "wait", "ms": 2000 },
    { "peer": "a", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "enter_text", "target": "hint:My Awesome Server", "value": "t14m-${RUN}" },
    { "peer": "a", "op": "tap", "target": "text:Create", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:t14m-${RUN}", "timeout_ms": 30000 },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "long_press", "target": "text:t14m-${RUN}", "index": 0 },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Invite people", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "type:HollowCopyField", "timeout_ms": 20000 },
    { "peer": "a", "op": "capture", "target": "type:HollowCopyField", "as": "INVITE" },
    { "peer": "a", "op": "tap", "target": "dialog > semantics:Close", "index": 0 },

    { "peer": "b", "op": "tap", "target": "semantics:Add a server", "index": 0 },
    { "peer": "b", "op": "wait", "ms": 1000 },
    { "peer": "b", "op": "enter_text", "target": "hint:Invite link", "value": "${INVITE}" },
    { "peer": "b", "op": "tap", "target": "text:Join", "index": 0 },
    { "peer": "b", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "b", "op": "wait_for", "target": "text:t14m-${RUN}", "timeout_ms": 90000 },
    { "peer": "b", "op": "wait", "ms": 2000 },
    { "peer": "b", "op": "tap", "target": "text:t14m-${RUN}" },
    { "peer": "b", "op": "wait", "ms": 1200 },
    { "peer": "b", "op": "tap", "target": "text:general" },
    { "peer": "b", "op": "wait_for", "target": "field", "timeout_ms": 30000 },

    { "peer": "a", "op": "tap", "target": "text:t14m-${RUN}" },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "tap", "target": "text:general" },
    { "peer": "a", "op": "wait_for", "target": "field", "timeout_ms": 30000 },
    { "peer": "a", "op": "tap", "target": "field", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "owner posts ${RUN}" },
    { "peer": "a", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:owner posts ${RUN}", "timeout_ms": 60000 },

    { "peer": "b", "op": "tap", "target": "field", "index": 0 },
    { "peer": "b", "op": "enter_text", "target": "field", "value": "joiner answers ${RUN}" },
    { "peer": "b", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "a", "op": "wait_for", "target": "text:joiner answers ${RUN}", "timeout_ms": 60000 },

    { "peer": "a", "op": "tap", "target": "field", "index": 0 },
    { "peer": "a", "op": "enter_text", "target": "field", "value": "owner again ${RUN}" },
    { "peer": "a", "op": "tap", "target": "semantics:Send message", "index": 0 },
    { "peer": "b", "op": "wait_for", "target": "text:owner again ${RUN}", "timeout_ms": 60000 },

    { "peer": "all", "op": "wait", "ms": 1000 },
    { "peer": "all", "op": "shot", "name": "t14hm-joined" },
    { "peer": "all", "op": "dump", "name": "t14hm-converged" }
  ],
  "cleanup": [
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Back", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "semantics:Chats", "index": 0, "soft": true },
    { "peer": "a", "op": "long_press", "target": "text:t14m-${RUN}", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1000 },
    { "peer": "a", "op": "tap", "target": "text:Server settings", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1500 },
    { "peer": "a", "op": "tap", "target": "text:Overview", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 1200 },
    { "peer": "a", "op": "reveal", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "tap", "target": "text:Delete server", "index": 0, "soft": true },
    { "peer": "a", "op": "wait", "ms": 800 },
    { "peer": "a", "op": "tap", "target": "dialog > text:Delete server", "index": 0, "soft": true }
  ]
}
