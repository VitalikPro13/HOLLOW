[
  {"op": "log", "message": "Phase 4: server icon, folder and Home menus. Creates a folder and dissolves it again."},
  {"op": "dump", "name": "01-home"},

  {"op": "log", "message": "the Home button: the mark-all-DMs escape hatch"},
  {"op": "right_click", "target": "server:Home"},
  {"op": "shot", "name": "02-home-menu"},
  {"op": "dump", "name": "02-home-menu"},
  {"op": "expect_text", "value": "Mark all DMs as read"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},

  {"op": "log", "message": "the server icon menu"},
  {"op": "right_click", "target": "server:${SERVER}"},
  {"op": "shot", "name": "03-server-menu"},
  {"op": "dump", "name": "03-server-menu"},
  {"op": "expect_text", "value": "Mark as read"},
  {"op": "expect_text", "value": "Invite people"},
  {"op": "expect_text", "value": "Server settings"},
  {"op": "expect_text", "value": "Move to folder"},
  {"op": "expect_text", "value": "Leave server"},

  {"op": "log", "message": "drill into Move to folder and make a new one"},
  {"op": "tap", "target": "menu > text:Move to folder"},
  {"op": "shot", "name": "04-folder-submenu"},
  {"op": "dump", "name": "04-folder-submenu"},
  {"op": "expect_text", "value": "New folder"},
  {"op": "tap", "target": "menu > text:New folder"},
  {"op": "wait", "ms": 600},
  {"op": "enter_text", "target": "dialog > type:TextField", "value": "probe-folder"},
  {"op": "tap", "target": "dialog > text:Create"},
  {"op": "wait", "ms": 1200},
  {"op": "shot", "name": "05-folder-created"},
  {"op": "dump", "name": "05-folder-created"},

  {"op": "log", "message": "THE TEST: the folder must still hold the server, not have dissolved itself"},
  {"op": "right_click", "target": "server:${SERVER}", "soft": true},
  {"op": "dump", "name": "06-after-create"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 400},

  {"op": "log", "message": "clean up: dissolve it from the folder icon menu"},
  {"op": "right_click", "target": "type:ServerFolderIcon"},
  {"op": "shot", "name": "07-folder-menu"},
  {"op": "dump", "name": "07-folder-menu"},
  {"op": "expect_text", "value": "Rename folder"},
  {"op": "expect_text", "value": "Dissolve folder"},
  {"op": "tap", "target": "menu > text:Dissolve folder"},
  {"op": "wait", "ms": 1200},
  {"op": "shot", "name": "08-dissolved"},
  {"op": "dump", "name": "08-dissolved"}
]
