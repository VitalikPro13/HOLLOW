[
  {"op": "log", "message": "issue #54: avatar frames. Pick a built-in, save, and look at it on every surface."},

  {"op": "tap", "target": "semantics:Settings"},
  {"op": "wait", "ms": 1800},
  {"op": "tap", "target": "text:Profile"},
  {"op": "wait", "ms": 1200},
  {"op": "shot", "name": "frame-01-profile-settings"},
  {"op": "expect_text", "value": "Frame"},

  {"op": "log", "message": "the Frame row opens the picker"},
  {"op": "tap", "target": "text:Frame"},
  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "frame-02-picker"},
  {"op": "dump", "name": "frame-picker"},
  {"op": "expect_text", "value": "Avatar frame"},
  {"op": "expect_text", "value": "Upload an image or GIF"},

  {"op": "log", "message": "every choice draws the frame around a real avatar, so it can be judged"},
  {"op": "tap", "target": "dialog > semantics:Violet"},
  {"op": "wait", "ms": 600},
  {"op": "shot", "name": "frame-03-picked-violet"},

  {"op": "tap", "target": "dialog > text:Use frame"},
  {"op": "wait", "ms": 800},
  {"op": "shot", "name": "frame-04-settings-preview"},
  {"op": "dump", "name": "frame-settings-preview"},

  {"op": "log", "message": "commit it"},
  {"op": "tap", "target": "text:Save profile"},
  {"op": "wait", "ms": 2500},
  {"op": "shot", "name": "frame-05-saved"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 1200},

  {"op": "log", "message": "the frame follows the avatar everywhere: user bar, member panel, chat rows"},
  {"op": "shot", "name": "frame-06-home"},
  {"op": "open_server", "name": "${SERVER}"},
  {"op": "wait", "ms": 1500},
  {"op": "shot", "name": "frame-07-server"},
  {"op": "dump", "name": "frame-server"},

  {"op": "log", "message": "and on the profile card, where it animates"},
  {"op": "tap", "target": "type:_ServerMemberTile", "soft": true},
  {"op": "wait", "ms": 1000},
  {"op": "shot", "name": "frame-08-profile-card"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 600},

  {"op": "log", "message": "put it back"},
  {"op": "tap", "target": "semantics:Settings"},
  {"op": "wait", "ms": 1800},
  {"op": "tap", "target": "text:Profile"},
  {"op": "wait", "ms": 1200},
  {"op": "tap", "target": "text:Frame"},
  {"op": "wait", "ms": 1000},
  {"op": "tap", "target": "dialog > semantics:No frame"},
  {"op": "wait", "ms": 500},
  {"op": "tap", "target": "dialog > text:Use frame"},
  {"op": "wait", "ms": 800},
  {"op": "tap", "target": "text:Save profile"},
  {"op": "wait", "ms": 2500},
  {"op": "shot", "name": "frame-09-cleared"},
  {"op": "key", "value": "escape"},
  {"op": "wait", "ms": 800}
]
