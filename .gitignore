rust/hollow_dfn/target/
rust/target/
relay/target/
loadtest/target/

# Coverage + lint reports. CI regenerates these every run (`cargo llvm-cov`,
# `cargo clippy --message-format=json`); they are inputs to Codecov and Sonar,
# never source.
lcov.info
clippy-report.json

# Bundled native binaries (fetched via scripts/fetch_ffmpeg.{ps1,sh})
vendor/ffmpeg/

# Bundled shoes REALITY tunnel binary (built via scripts/build_shoes.ps1).
# Keep the script + license + version note in git, not the 14 MB binary.
vendor/shoes/*.exe

# flutter_rust_bridge
.flutter-plugins

# Secrets
.env
*.key
*.pem
alpha_keys.txt
keys.json
turnserver.conf
android/app/google-services.json
# Firebase config — match GoogleService-Info.plist anywhere under ios/ (repo is
# public; contributors bring their own Firebase project)
**/GoogleService-Info.plist

# Local code-signing (keeps Apple Developer Team ID out of the public repo)
ios/Flutter/LocalSigning.xcconfig
macos/Flutter/LocalSigning.xcconfig

# Deprecated (replaced by relay/)
signaling/

# Temporary files
tmp_next_session.md
# Inbound security reports + researcher PoCs — never commit these
tmp_security/
temporary_ssh_log.txt
my_debug_logs.txt
third_debug.txt
main_debug.txt
snow_leopard_chat_mockup.html
macOS_SnowLeopard.txt
discord_migration_plan.md
important/
drafts/

# YouTube video assets
yt_videos/

# Claude Code
.claude/

# Forked flutter_webrtc third_party: ignore downloads/staging, but TRACK the
# vendored Hollow-custom libwebrtc build (patched binaries + headers must ship
# in git — stock webrtc-sdk prebuilts no longer match the plugin sources).
packages/flutter_webrtc/third_party/**
!packages/flutter_webrtc/third_party/CMakeLists.txt
!packages/flutter_webrtc/third_party/libwebrtc_version.ini
!packages/flutter_webrtc/third_party/svpng/
!packages/flutter_webrtc/third_party/svpng/**
!packages/flutter_webrtc/third_party/libwebrtc/
!packages/flutter_webrtc/third_party/libwebrtc/BUILDING.md
!packages/flutter_webrtc/third_party/libwebrtc/hollow-screencast.patch
!packages/flutter_webrtc/third_party/libwebrtc/hollow-core-audio.patch
!packages/flutter_webrtc/third_party/libwebrtc/hollow-wayland-desktop-capture.patch
!packages/flutter_webrtc/third_party/libwebrtc/include/
!packages/flutter_webrtc/third_party/libwebrtc/include/**
!packages/flutter_webrtc/third_party/libwebrtc/lib/
!packages/flutter_webrtc/third_party/libwebrtc/lib/libwebrtc.dll
!packages/flutter_webrtc/third_party/libwebrtc/lib/libwebrtc.dll.lib
!packages/flutter_webrtc/third_party/libwebrtc/lib/libwebrtc.so

# Hollow Memory (semantic search tool)
tools/hollow-memory/models/
tools/hollow-memory/*.db

tools/hollow-memory/wiki/web_public_viewer.md

# IGDB endpoint: source is tracked, secrets/runtime state never
igdb/config.php
igdb/token.json
igdb/games.db*
igdb/covers/

# GIF proxy endpoint: source is tracked, secrets/runtime state never
gifs/config.php
gifs/gifs.db*
gifs/m/
