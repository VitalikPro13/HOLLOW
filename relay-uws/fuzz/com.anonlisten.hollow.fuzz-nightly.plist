<?xml version="1.0" encoding="UTF-8"?>
<!-- The nightly relay fuzz run on the Mac mini (relay-uws/fuzz/nightly.sh). A template:
     `nightly.sh install` writes it to ~/Library/LaunchAgents with __HOME__ filled in. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anonlisten.hollow.fuzz-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/dev/fuzz-nightly/nightly.sh</string>
        <string>run</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>Nice</key>
    <integer>19</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/dev/fuzz-nightly/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/dev/fuzz-nightly/launchd.log</string>
</dict>
</plist>
