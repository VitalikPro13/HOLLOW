# Starts the self-hosted relay stack on boot. Assumes the repository at
# /opt/HOLLOW and a user named hollow in the docker group. See
# relay-uws/SELF_HOSTING.md.
[Unit]
Description=Hollow Relay
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=hollow
WorkingDirectory=/opt/HOLLOW/relay-uws
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
