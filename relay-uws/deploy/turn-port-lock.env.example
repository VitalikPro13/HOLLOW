# hollow-turn-port-lock.service settings (turn-port-lock.sh). Not secret.
# The account coturn runs as: turnserver (distribution package), hollow-turn (the
# setup's hollow-coturn.service), 65999 (Docker).
TURN_USER=turnserver
# coturn's allowed-peer-ip addresses: this machine's public IPv4 and IPv6, space separated.
TURN_PEERS="192.0.2.10 2001:db8::10"
# coturn's --min-port to --max-port.
TURN_PORTS=49152-65535
# The forwarder's udp_port_min to udp_port_max; empty without a forwarder.
FORWARDER_PORTS=40000-40199
