# Hollow media forwarder configuration (hollow-forwarder --config <this file>).
# See rust/hollow_core/src/forwarder/mod.rs (ForwarderConfig) for all fields.
# install.sh writes this file for you; the values below are placeholders.

# The relay this forwarder serves: the address people type into the app.
relay_domain = "myrelay.duckdns.org"
# The unit's StateDirectory: its sandbox cannot reach /home.
data_dir = "/var/lib/hollow-forwarder"
# This machine's public IPv4, advertised in ICE host candidates (sockets bind
# 0.0.0.0). Viewers connect to it, so it must be the address they reach.
public_ip = "203.0.113.7"

# UDP media port range, one port per leg. Must be open in the firewall.
udp_port_min = 40000
udp_port_max = 40199

# Budget (refuse-new-only; existing legs are never degraded or evicted).
max_streams_global = 16
max_streams_per_sender = 4
max_legs_per_stream = 32
# Global egress budget in bits/sec (0 = unlimited). 400 Mbps default leaves
# headroom under the 1 Gbps port for the relay's own traffic.
max_egress_bps = 400000000

# license_key = "..."   # only for members-only relays (or HOLLOW_FWD_LICENSE_KEY)
