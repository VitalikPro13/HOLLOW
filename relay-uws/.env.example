# Hollow relay configuration. Copy this file to .env and fill it in.
# See SELF_HOSTING.md for the full walkthrough.

# The address people type into the app. A DuckDNS name is the easy choice: it
# is free, it keeps working if this machine's IP changes, and it gets a
# certificate without opening port 80. A bare public IPv4 or a domain you own
# both work too. No port here, the relay listens on 443.
RELAY_HOST=myrelay.duckdns.org

# Only for a DuckDNS name. Copy it from the DuckDNS dashboard after you log in.
# With this set, the certificate is obtained by DNS validation, and the name is
# kept pointing at this machine automatically.
DUCKDNS_TOKEN=

# Optional, and usually empty: DuckDNS then records the address this machine
# reaches the internet from. Set it to pin the name to another address, for
# example a test machine people reach on your own network only.
DUCKDNS_IP=

# Shared secret between the relay and coturn, so the relay can hand out TURN
# credentials. Generate one with: openssl rand -hex 32
# Leave it empty if you run without TURN, so the app knows not to expect it.
TURN_SECRET=

# Runs coturn alongside the relay, which is what lets calls connect when both
# people are behind a strict NAT. Set it empty to run without coturn on a small
# machine. Empty the TURN_SECRET above as well when you do.
# Add forwarder (COMPOSE_PROFILES=turn,forwarder) to run the media forwarder,
# which carries screen shares to many viewers at once. It is built from source,
# which takes up to an hour or two on a small machine, and it needs UDP ports
# 40000 to 40199 open. install.sh fills in FORWARDER_PEER_ID for you.
COMPOSE_PROFILES=turn

# The forwarder's id, which the relay tells apps about. Leave empty without the
# forwarder profile. To find it, run:
#   docker compose run --rm --no-deps forwarder --print-peer-id
FORWARDER_PEER_ID=
# Only for a members-only relay with the forwarder: a key from keys/keys.json
# that the forwarder uses to connect.
FWD_LICENSE_KEY=

# This machine's public addresses, which coturn relays to and the forwarder
# gives to viewers. Leave empty to detect the IPv4 at start. Behind a router or
# a cloud provider's NAT, where the machine's own address is private, set the
# public one here. Set PUBLIC_IPV6 only if this machine has one and you want
# calls to use it.
PUBLIC_IP=
PUBLIC_IPV6=
# Behind NAT: this machine's own (private) address, which coturn maps to
# PUBLIC_IP. Leave empty to detect it at start.
LOCAL_IP=

# Optional. This machine's memory, like 2048m. Each container may use up to
# this much and never swap; empty means 64g, which is only a ceiling.
HOLLOW_MEM_LIMIT=

# Advanced. A directory on this host holding fullchain.pem and privkey.pem that
# you obtain and renew yourself. With this set, certbot is not used at all; the
# files are copied in at start and re-copied every 12 hours, and the relay picks
# up a changed certificate within a minute without restarting.
OWN_CERT_DIR=

# Optional. How many seconds the relay holds on to someone's connection after it
# drops, so a phone that loses signal or a laptop that sleeps picks up where it left
# off and misses nothing. Anywhere from 30 to 600. Empty means 120.
SESSION_GRACE_SECS=

# Optional, and best left empty. Your own public addresses, separated by commas,
# that may open more than 10 new connections a minute, for example while you test
# with many copies of the app. An IPv6 address covers its whole /64. Every other
# limit still applies to them.
HOLLOW_CONN_RATE_EXEMPT=

# Optional. on or off. Off leaves the online count and the traffic figures out of
# the relay's public /server-stats page. Empty means on.
PUBLIC_STATS=

# Optional, best left empty. How many bytes the relay may hold for connections
# that read slowly. Empty means a quarter of the machine's memory, and the relay
# never goes below 512 MB, or a third of the memory on a smaller machine.
HOLLOW_SEND_BUDGET_BYTES=

# Troubleshooting. Set to 1 to use the Let's Encrypt staging service while you
# get the setup right. Staging certificates are not trusted, so the app will
# refuse to connect, but there are no rate limits to run into. Set it back to
# empty and run "docker compose up -d --force-recreate certbot-init" when the
# rest works.
CERTBOT_STAGING=
