# Hollow relay configuration. Copy this file to .env and fill it in.
# See SELF_HOSTING.md for the full walkthrough.

# The address people type into the app. A DuckDNS name is the easy choice: it
# is free, it keeps working if this machine's IP changes, and it gets a
# certificate without opening port 80. A bare public IPv4 or a domain you own
# both work too. No port here, the relay listens on 443.
RELAY_HOST=myrelay.duckdns.org

# Only for a DuckDNS name. Copy it from the DuckDNS dashboard after you log in.
# With this set, the certificate is obtained by DNS validation, and the name is
# kept pointing at this machine automatically.
DUCKDNS_TOKEN=

# Shared secret between the relay and coturn, so the relay can hand out TURN
# credentials. Generate one with: openssl rand -hex 32
# Leave it empty if you run without TURN, so the app knows not to expect it.
TURN_SECRET=

# Where Let's Encrypt sends expiry notices. Required unless you set
# OWN_CERT_DIR below.
CERTBOT_EMAIL=you@example.com

# Runs coturn alongside the relay, which is what lets calls connect when both
# people are behind a strict NAT. Set it empty to run without coturn on a small
# machine. Empty the TURN_SECRET above as well when you do.
COMPOSE_PROFILES=turn

# The public addresses coturn may relay to, which are this machine's own.
# Leave empty to detect the IPv4 at start. Set PUBLIC_IPV6 only if this machine
# has one and you want calls to use it.
PUBLIC_IP=
PUBLIC_IPV6=

# Advanced. A directory on this host holding fullchain.pem and privkey.pem that
# you obtain and renew yourself. With this set, certbot is not used at all; the
# files are copied in at start and re-copied every 12 hours, and the relay picks
# up a changed certificate within a minute without restarting.
OWN_CERT_DIR=

# Troubleshooting. Set to 1 to use the Let's Encrypt staging service while you
# get the setup right. Staging certificates are not trusted, so the app will
# refuse to connect, but there are no rate limits to run into. Set it back to
# empty and run "docker compose up -d --force-recreate certbot-init" when the
# rest works.
CERTBOT_STAGING=
