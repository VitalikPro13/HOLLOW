# Never serve the credential, database, or cron files.
<FilesMatch "^(config\.php|config\.php\.example|sweep\.php|gifs\.db|gifs\.db-wal|gifs\.db-shm)$">
    Require all denied
</FilesMatch>

# In-progress atomic writes from fetch.php ("<id>.<variant>.<ext>.tmp.<pid>").
<FilesMatch "\.tmp\.">
    Require all denied
</FilesMatch>

# Cached media is immutable — cache hard.
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Cold media falls through to the read-through cache; warm files are served
# directly by Apache with no PHP in the path. The full (send-time) variant
# is always PHP — it is deliberately never on disk.
#
# The optional leading `~` is the sticker id namespace (see search.php) —
# GIF ids stay bare so already-saved favourites keep resolving.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^m/(~?[A-Za-z0-9_-]+\.(?:still|sm)\.(?:webp|gif))$ fetch.php?f=$1 [L,QSA]
RewriteRule ^f/(~?[A-Za-z0-9_-]+)$ full.php?id=$1 [L,QSA]
