+scoped_refptr<RTCDesktopCapturer> RTCDesktopDeviceImpl::CreateDesktopCapturer(
+    DesktopType type, int64_t source_id, bool show_cursor) {
+  // HOLLOW: no media list involved — synthesize a standalone MediaSource so
+  // capturer->source() stays non-null for observers. The Wayland portal-first
+  // share path lands here (type == kAnyScreenContent): the xdg-desktop-portal
+  // dialog does the actual picking, and source_id is the caller's stable
+  // restore-token bucket (see rtc_desktop_device.h).
+  webrtc::DesktopCapturer::Source src;
+  src.id = source_id;
+  src.title = "Desktop";
+  return new RefCountedObject<RTCDesktopCapturerImpl>(
+      type, source_id, signaling_thread_,
+      new RefCountedObject<MediaSourceImpl>(nullptr, src, type), show_cursor);
